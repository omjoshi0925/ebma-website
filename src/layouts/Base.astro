---
// Fonts. Upright Newsreader keeps its optical-size axis (the display headings need it). The italic
// is used at text sizes, where opsz adds nothing, so it loads the much smaller weight-only file
// (same family name). IBM Plex Mono is used at 500 and 600 only (700 renders with 600).
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title in Title Case ("Events & Competitions"); the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of a 1200×630 social image under public/. */
  image?: string;
  /** A page that should never be indexed or shared (404, thanks): noindex, and no canonical URL. */
  noindex?: boolean;
}
const { title, description = site.description, image = '/og/default.png', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Math for East Bay students`;
const shareTitle = title ? `${title} · ${site.name}` : site.name;
// Until launch (site.indexable in src/data/site.ts) every page asks search engines to stay away.
const robotsNoindex = noindex || !site.indexable;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const home = new URL('/', Astro.site).href;
const isHome = Astro.url.pathname === '/';
// Structured data once, on the home page: the organization, and the website (which is what search
// engines use for the site name shown in results).
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${home}#org`,
          name: site.name,
          alternateName: site.shortName,
          url: home,
          logo: new URL('/icon-512.png', Astro.site).href,
          description: site.description,
          areaServed: site.region,
        },
        {
          '@type': 'WebSite',
          '@id': `${home}#website`,
          name: site.name,
          alternateName: site.shortName,
          url: home,
          publisher: { '@id': `${home}#org` },
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" data-scheme="dark" />

    <script is:inline>
      // Apply a saved theme before first paint (and tint the browser bar to match), and flag that
      // JavaScript is available. scripts/site.ts keeps both in step when the reader changes theme.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('ebma-theme');
          if (t === 'light' || t === 'dark') {
            d.setAttribute('data-theme', t);
            var metas = document.querySelectorAll('meta[name="theme-color"][data-scheme]');
            for (var i = 0; i < metas.length; i++) metas[i].setAttribute('media', metas[i].getAttribute('data-scheme') === t ? 'all' : 'not all');
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: “Every student in the East Bay can do real mathematics,” beside a circle of points joined by straight lines that trace a cardioid.`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!-- "Back to top" (footer) lands here: the very top of the document, not the sticky header. -->
    <div id="top"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
