---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Band from '../components/Band.astro';
import Ph from '../components/Ph.astro';
import TeX from '../components/Math.astro';
import AboutPentagon from '../components/AboutPentagon.astro';
import AboutPerson from '../components/AboutPerson.astro';
import { team, SAMPLE_COUNT } from '../data/team';
import { joinHref, contactHref } from '../data/site';
import { valueOf } from '../data/placeholders';

/** Volunteer calls to action open the join form with Volunteer preselected. */
const volunteerHref = '/get-involved/?role=volunteer#join';
/**
 * Keeps a chip on the same line as the punctuation after it (every engine may break between them).
 * Only while it is a chip: a filled value is plain text, and a long one must be free to wrap.
 */
const glue = (id: string) => (valueOf(id) === null ? 'nowrap' : undefined);

// Geography, not a claim of presence: the incorporated cities of the two East Bay counties.
const alameda = ['Alameda', 'Albany', 'Berkeley', 'Dublin', 'Emeryville', 'Fremont', 'Hayward', 'Livermore', 'Newark', 'Oakland', 'Piedmont', 'Pleasanton', 'San Leandro', 'Union City'];
const contraCosta = ['Antioch', 'Brentwood', 'Clayton', 'Concord', 'Danville', 'El Cerrito', 'Hercules', 'Lafayette', 'Martinez', 'Moraga', 'Oakley', 'Orinda', 'Pinole', 'Pittsburg', 'Pleasant Hill', 'Richmond', 'San Pablo', 'San Ramon', 'Walnut Creek'];
const sets = [
  { id: 'set-a', sym: 'A', county: 'Alameda County', cities: alameda },
  { id: 'set-c', sym: 'C', county: 'Contra Costa County', cities: contraCosta },
];

const contents = [
  { href: '#mission', num: '1', title: 'Our mission' },
  { href: '#values', num: '2', title: 'What we value' },
  { href: '#construction', num: '3', title: 'Step by step' },
  { href: '#who', num: '4', title: 'Who we serve' },
  { href: '#people', num: '5', title: 'The people' },
];
---

<Base
  title="About"
  description="What the East Bay Math Association is for, what it values, how it thinks about learning, who can take part, and who runs it."
>
  <PageHeader
    chapter={1}
    label="Preliminaries"
    note="(in which we introduce ourselves)"
    title="About the *association*"
    lede="<em>Who we are.</em> The East Bay Math Association is for anyone in the East Bay who enjoys a good problem. This chapter sets out what we are for, what we value, and who takes part."
    contents={contents}
  />

  <Section
    id="mission"
    num="1"
    title="Our *mission*"
    dek="Why the association exists: first in one sentence, then in plain terms."
    note="A definition in mathematics says exactly what something is. This one says what we are for."
  >
    <div class="mission">
      <p class="thm-label"><span class="label">Definition 1.1</span><span class="note">(the mission)</span></p>
      <p class="statement">
        To give anyone in the East Bay who is curious a way into <em>real</em> mathematics, wherever they are starting from.
      </p>
      <div class="plain">
        <div class="prose">
          <p>
            <strong>In plain terms:</strong> the East Bay Math Association (EBMA) is a math organization in the East Bay area of California, open
            to anyone interested in math. It was founded in <span class={glue('org.founded')}><Ph id="org.founded" />,</span> and joining is&nbsp;free.
          </p>
          <p>
            EBMA runs talks on mathematics and the fields next to it, and trips to hackathons and events in those fields. We also gather good
            problems and free resources, so the mathematics doesn’t stop when an event does.
          </p>
        </div>
        <ul class="see" aria-label="Read next">
          <li><a class="xref" href="/events/">Events &amp; Competitions <span class="arr" aria-hidden="true">→</span></a></li>
          <li><a class="xref" href="/resources/">Student Resources <span class="arr" aria-hidden="true">→</span></a></li>
          <li><a class="xref" href="#people">Who runs EBMA <span class="arr" aria-hidden="true">↓</span></a></li>
        </ul>
      </div>
    </div>
  </Section>

  <Section
    id="values"
    num="2"
    title="What we *value*"
    dek="Four axioms: the things we take as given."
    note="An axiom is a starting point: a statement you accept without proof, then build on."
  >
    <div class="cells cells-4 axioms">
      <article class="cell">
        <p class="formal" aria-hidden="true">curiosity <span class="op"><TeX tex={String.raw`\geq`} /></span> head start</p>
        <p class="label">Axiom 2.1</p>
        <h3>Curiosity <em>counts</em> most.</h3>
        <p class="body">Anyone who enjoys a good puzzle belongs here, whatever their background.</p>
      </article>
      <article class="cell">
        <p class="formal" aria-hidden="true">stuck <span class="op"><TeX tex={String.raw`\neq`} /></span> lost</p>
        <p class="label">Axiom 2.2</p>
        <h3>Being stuck is <em>part</em> of it.</h3>
        <p class="body">Good problems take a while. Getting stuck is where the thinking happens, not a sign you’re in the wrong place.</p>
      </article>
      <article class="cell">
        <p class="formal upright" aria-hidden="true">1 <span class="bin"><TeX tex="+" /></span> 1 <span class="op"><TeX tex=">" /></span> 2</p>
        <p class="label">Axiom 2.3</p>
        <h3>Better <em>together</em>.</h3>
        <p class="body">Mathematics is more fun with company. People learn as much from each other’s ideas as from any lesson.</p>
      </article>
      <article class="cell">
        <p class="formal" aria-hidden="true">unknown <span class="op"><TeX tex={String.raw`\Rightarrow`} /></span> say so</p>
        <p class="label">Axiom 2.4</p>
        <h3>Straight <em>answers</em>.</h3>
        <p class="body">You should know the date, the place, and the cost before you sign up. If we don’t know something yet, like a date, we say so.</p>
      </article>
    </div>
    <p class="conclude"><span>Everything else we do is built on these&nbsp;four.</span><span class="qed" aria-hidden="true"></span></p>
  </Section>

  <Section
    id="construction"
    num="3"
    title="Step by *step*"
    dek="How we think about learning, shown rather than told: a construction you can step through."
    note="In geometry, a construction is a recipe that uses only a compass and a straightedge. Nothing is measured; every length is found."
  >
    <AboutPentagon />
  </Section>

  <Section
    id="who"
    num="4"
    title="Who we *serve*"
    dek="Anyone in the East Bay who is interested in math, whichever city they call home."
    note="The domain of a function is the set of inputs it is defined for. Ours is the East Bay."
  >
    <div class="domain">
      <div class="domain-top">
        <p class="thm-label"><span class="label">Definition 4.1</span><span class="note">(the domain)</span></p>
        <p class="union"><TeX tex={String.raw`D \supseteq A \cup C`} /></p>
      </div>
      {
        sets.map((set) => (
          <div class="set">
            <h3 class="set-h" id={`${set.id}-h`}>
              {set.county}
              <span class="count">{set.cities.length} cities</span>
            </h3>
            <div class="set-body">
              <span class="lhs" aria-hidden="true">
                <span class="m">{set.sym}</span> = <span class="br">{'{'}</span>
              </span>
              {/* The closing brace lives inside the last city's box, so a line can never break between them.
                  Keep each <li> on one line: whitespace inside it would show before the comma. */}
              <ul class="cities" aria-labelledby={`${set.id}-h`}>
                {set.cities.map((city, i) => (
                  <li>{city}{i === set.cities.length - 1 && <span class="br br-close" aria-hidden="true">{'}'}</span>}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <div class="domain-foot">
        <p class="tcap">
          <b>Table 1.</b> The incorporated cities of Alameda County (<span class="m">A</span>) and Contra Costa County (<span class="m">C</span>),
          the two counties usually meant by “the East Bay.” The domain <span class="m">D</span> also includes the unincorporated communities in both,
          such as Castro Valley and El Sobrante. This is geography, not a list of places where EBMA will hold events: for those, see
          <a href="/events/">Events &amp; Competitions</a>.
        </p>
        <aside class="elig aside-box cropped">
          <p class="label">Remark 4.1</p>
          <h3>Who can take part</h3>
          <p class="elig-v"><Ph id="org.eligibility" /></p>
          <p>Joining is free.</p>
          <div class="cta-row">
            <a class="xref" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>
    </div>
  </Section>

  <Section id="people" num="5" title="The *people*" dek="Who runs the association, and how to help.">
    <p slot="note">Want to help run things? Volunteers are welcome: see <a href={volunteerHref}>Get Involved</a>.</p>
    <ul class:list={['team', { solo: team.length === 1 }]}>
      {
        team.length
          ? team.map((member) => (
              <li>
                <AboutPerson member={member} wide={team.length === 1} />
              </li>
            ))
          : Array.from({ length: SAMPLE_COUNT }, (_, i) => (
              // Only the first sample carries chips; the empty ones after it are left out of the list's count.
              <li class:list={{ 'sample-extra': i > 1 }} aria-hidden={i > 0 ? 'true' : undefined}>
                <AboutPerson sample={i + 1} />
              </li>
            ))
      }
    </ul>
    <div class="people-foot cta-row">
      <a class="xref" href={contactHref}>Contact us <span class="arr" aria-hidden="true">→</span></a>
      <a class="xref" href={volunteerHref}>Volunteer with us <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </Section>

  <Band label="Corollary 5.1" title="Now you know *us.*" text="Join the association, or ask us a question first. Either way, we’d be glad to hear from you." m={6}>
    <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
    <a class="btn btn-quiet" href={contactHref}>Contact us</a>
  </Band>
</Base>

<style>
  /* §1 mission */
  .mission .thm-label {
    margin-bottom: 18px;
  }
  .statement {
    max-width: 17em;
    font: 350 clamp(30px, 3.4vw, 50px) / 1.14 var(--serif);
    letter-spacing: -0.018em;
    font-variation-settings: 'opsz' 60;
    text-wrap: balance;
  }
  .statement em {
    font-style: italic;
    color: var(--accent);
    padding-right: 0.03em;
  }
  @media (min-width: 1180px) {
    .statement {
      font-weight: 300;
    }
  }
  .plain {
    margin-top: clamp(32px, 4vw, 52px);
    padding-top: 24px;
    border-top: 1px solid var(--rule-2);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .see {
    list-style: none;
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  /* §2 axioms */
  .formal {
    font: italic 400 clamp(21px, 1.8vw, 24px) / 1.1 var(--serif);
    color: var(--ink-3);
    margin-bottom: 8px;
    white-space: nowrap;
  }
  .formal.upright {
    font-style: normal;
  }
  /* The operators are typeset in the TeX font (the text faces have no ≥ ≠ ⇒, so each browser
     would borrow a different system glyph), in the accent color that holds 4.5:1 at this size. */
  .formal .op {
    font-style: normal;
    color: var(--accent-text);
    margin: 0 0.12em;
  }
  .formal .bin {
    margin: 0 0.06em;
  }
  .axioms .body {
    text-wrap: pretty;
  }
  .axioms h3 em {
    font-style: italic;
  }
  .conclude {
    border-top: 0;
  }

  /* §4 the domain */
  .domain-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule-2);
  }
  .domain-top .thm-label {
    margin: 0;
  }
  .union {
    font-size: 21px;
    color: var(--ink);
  }
  .set {
    padding: clamp(22px, 2.6vw, 32px) 0;
    border-bottom: 1px solid var(--rule);
  }
  .set-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-bottom: 12px;
    font: 600 12.5px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .count {
    font: 500 12.5px/1.3 var(--mono);
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-3);
  }
  .set-body {
    font: 350 clamp(23px, 2.35vw, 34px) / 1.4 var(--serif);
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 36;
    text-wrap: pretty;
  }
  .lhs .m {
    color: var(--accent);
    font-size: 1.08em;
  }
  .br {
    font-weight: 300;
    color: var(--accent);
    font-size: 1.15em;
    line-height: 1;
    margin: 0 0.06em;
  }
  /* Each city is one unbreakable box; lines break only between cities. */
  .cities {
    display: inline;
  }
  .cities li {
    display: inline-block;
    margin-right: 0.3em;
  }
  .cities li:last-child {
    margin-right: 0;
  }
  /* The same gap as between the opening brace and the first city. */
  .br-close {
    margin-left: 0.25em;
  }
  .cities li:not(:last-child)::after {
    content: ',';
    color: var(--ink-3);
  }
  .domain-foot {
    margin-top: clamp(24px, 3vw, 36px);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 28px clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .tcap {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .tcap b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .tcap a {
    color: var(--ink);
  }
  /* The box itself is the shared .aside-box; the answer to its question reads in full ink. */
  .elig .elig-v {
    color: var(--ink);
  }

  /* §5 people */
  .team {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }
  .team > li {
    display: grid;
    min-width: 0;
  }
  /* One person has the section to themselves: their card runs across it (AboutPerson `wide`). */
  .team.solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .people-foot {
    margin-top: clamp(28px, 3vw, 40px);
    padding-top: 18px;
    border-top: 1px solid var(--rule-2);
  }

  @media (max-width: 760px) {
    .plain,
    .domain-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Four across while a card is still at least ~140px wide, then two. */
  @media (max-width: 680px) {
    .team:not(.solo) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 16px;
    }
    /* Identical sample cards add length without information on a narrow screen. */
    .team > li.sample-extra {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .formal {
      white-space: normal;
    }
  }
</style>
