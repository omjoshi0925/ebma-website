---
/**
 * Chapter 5: Sponsors & Partners. For businesses, foundations, universities, and individual
 * donors deciding whether EBMA is worth supporting. The page header answers "is this real?"
 * first ("For your records": legal status, tax-deductibility, contact, people); then why, where
 * the money goes, the ways to help, what sponsors receive, who is named, and the ask itself
 * (Table 2) beside the call to action. Every EBMA-specific fact here is a placeholder
 * (src/data/placeholders/sponsors.ts and global.ts).
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import LogoSlots from '../components/LogoSlots.astro';
import Band from '../components/Band.astro';
import Ph from '../components/Ph.astro';
import PhLink from '../components/PhLink.astro';
import ResourceLink from '../components/ResourceLink.astro';
import SponsorSupportFigure from '../components/SponsorSupportFigure.astro';
import { valueOf } from '../data/placeholders';
import { contactHref } from '../data/site';
import { sponsors, fundingUses, SAMPLE_FUNDING_ROWS } from '../data/sponsors';

// The page's own calls to action open the join form with the role preselected from ?role=
// (src/scripts/join-form.ts); "Sponsor or partner" covers organizations of every kind.
const sponsorFormHref = '/get-involved/?role=sponsor#join';
const volunteerFormHref = '/get-involved/?role=volunteer#join';

// Links that exist only once their placeholder is filled. Until then the chip stands in, and
// never inside a row of buttons.
const packetUrl = valueOf('sponsors.packet');
const donateUrl = valueOf('sponsors.donate');
const donateExternal = donateUrl !== null && /^https?:\/\//.test(donateUrl);
const hasSponsorContact = valueOf('sponsors.contact') !== null;

// §5 names organizations only once there are some; until then the wall is a set of open slots
// and nothing on the page implies current sponsors.
const hasSponsors = sponsors.length > 0;
const namedTitle = hasSponsors ? 'Current sponsors & partners' : 'Named with *thanks*';

const contents = [
  { href: '#why', num: '1', title: 'Why support EBMA' },
  { href: '#uses', num: '2', title: 'Where support goes' },
  { href: '#ways', num: '3', title: 'Ways to support' },
  { href: '#recognition', num: '4', title: 'What sponsors receive' },
  { href: '#current', num: '5', title: namedTitle.replace(/\*/g, '') },
  { href: '#become', num: '6', title: 'Become a sponsor' },
];
---

<Base
  title="Sponsors & Partners"
  description="Support math enrichment for East Bay students: legal and tax details, where support goes, ways to help, what sponsors receive, and how to become a sponsor of EBMA."
>
  <PageHeader
    chapter={5}
    label="Acknowledgments"
    note="(to everyone who will make this possible)"
    title="Sponsors & *partners*"
    lede="Support from local businesses, foundations, universities, and individual donors can help East Bay students do real mathematics together. Here is why it matters, where support goes, and how to give. Teach at a school or run a club? Start at <a href='/get-involved/#schools'>Schools&nbsp;&amp;&nbsp;teachers</a>."
    contents={contents}
  >
    <div slot="lede" class="head-more">
      <div class="cta-row rise" style="--d:380">
        <a class="btn" href={sponsorFormHref}>Become a sponsor <span class="arr" aria-hidden="true">→</span></a>
        {
          packetUrl ? (
            <a class="xref" href={packetUrl}>
              Sponsor packet (PDF) <span class="arr" aria-hidden="true">↓</span>
            </a>
          ) : (
            <a class="xref" href="#give-details">
              What we’re asking for <span class="arr" aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
      <div class="front rise" style="--d:460" id="records">
        <p class="front-h">For your records</p>
        <dl>
          <div>
            <dt>Legal status</dt>
            <dd>The East Bay Math Association is <span class="nowrap"><Ph id="org.legal-status" label="Legal status" />.</span></dd>
          </div>
          <div>
            <dt>Tax-deductibility</dt>
            <dd><Ph id="sponsors.tax-deductible" label="Tax-deductibility and EIN" /></dd>
          </div>
          <div>
            <dt>Sponsorship contact</dt>
            <dd><PhLink id="sponsors.contact" /></dd>
          </div>
          <div>
            <dt>People</dt>
            <dd><a href="/about/#people">Who runs the association</a>, on the About&nbsp;page</dd>
          </div>
        </dl>
      </div>
    </div>
  </PageHeader>

  <!-- §1 -->
  <Section
    id="why"
    num="1"
    title="Why support EBMA"
    dek="The case for supporting EBMA, in plain terms."
    note="A proposition is a claim worth proving. We think this one holds on sight, but the proof follows anyway."
  >
    <div class="why">
      <div class="why-claim">
        <p class="label">Proposition 1.1</p>
        <p class="claim">
          Curiosity about mathematics turns up in every school in the East Bay. The chance to follow it further should not depend on which school
          that&nbsp;is.
        </p>
        <div class="why-links">
          <a class="xref" href="/about/">About the association <span class="arr" aria-hidden="true">→</span></a>
          <a class="xref" href="/resources/">What students work on <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="why-proof">
        <p class="proof-lead"><em>Proof.</em> Three reasons, each enough on its own.</p>
        <ol class="reasons">
          <li>
            <span class="rn" aria-hidden="true">(i)</span>
            <div>
              <h3>Open to every school</h3>
              <p>
                Not every school has a math club, a coach, or a team. EBMA aims to welcome students from any school in the East Bay, so a student whose
                school has none still has somewhere to&nbsp;go.
              </p>
            </div>
          </li>
          <li>
            <span class="rn" aria-hidden="true">(ii)</span>
            <div>
              <h3>Close to home</h3>
              <p>
                Enrichment nearby is enrichment students can actually reach: after school or on a weekend, with friends, without a long trip or a
                special program to get&nbsp;into.
              </p>
            </div>
          </li>
          <li>
            <span class="rn" aria-hidden="true">(iii)</span>
            <div>
              <h3>In good company</h3>
              <p>
                Meeting students from other schools who also love a hard problem means no one has to find that company inside their own school. It
                makes it easier to keep going, and to aim&nbsp;higher.
              </p>
            </div>
          </li>
        </ol>
        <p class="conclude">
          <span>So a student’s school need not decide how far they go in mathematics. That is the work EBMA exists to do.</span><span
            class="qed"
            aria-hidden="true"></span>
        </p>
      </div>
    </div>
  </Section>

  <!-- §2 -->
  <Section
    id="uses"
    num="2"
    title="Where support *goes*"
    dek="What support pays for, and how you’ll hear back about it."
    note="Fig. 1 is a pun, but an honest one: a function’s support is where it does its work."
  >
    <div class="uses">
      <div class="uses-text">
        <p class="uses-lede">
          Support will pay for the practical things that turn a good problem into an afternoon students can come to. We’d rather show you than
          tell&nbsp;you.
        </p>
        <table class:list={['table funds', { 'funds-sample': !fundingUses.length }]}>
          <caption class="caption">
            <b>Table 1.</b> How funds are used, published here so you can see where a gift goes before you give it.
          </caption>
          <thead>
            <tr>
              <th scope="col">What support pays for</th>
              <th scope="col">Share</th>
            </tr>
          </thead>
          <tbody>
            {
              fundingUses.length
                ? fundingUses.map((u) => (
                    <tr>
                      <th scope="row">{u.use}</th>
                      <td>{u.share}</td>
                    </tr>
                  ))
                : Array.from({ length: SAMPLE_FUNDING_ROWS }, (_, i) =>
                    // The site's sample style: one tagged row with the chip, then blank ruled
                    // rows (hidden from screen readers) so the table keeps its shape.
                    i === 0 ? (
                      <tr>
                        <th scope="row">
                          <span class="sample-tag">Sample</span>
                          <Ph id="sponsors.funding-uses" label="Use of funds" />
                        </th>
                        <td>
                          <span class="skel" aria-hidden="true">
                            —
                          </span>
                        </td>
                      </tr>
                    ) : (
                      <tr class="blank" aria-hidden="true">
                        <td />
                        <td />
                      </tr>
                    ),
                  )
            }
          </tbody>
        </table>
        <div class="promise" id="reporting">
          <p class="label">Lemma 2.1 <span class="note">(reporting back)</span></p>
          <h3>We’ll tell you what your support made possible.</h3>
          <p>
            After each school year, every sponsor will receive a short report: what took place, how many students took part, and where the money
            went. Questions in between will get a straight answer.
          </p>
          <a class="xref" href="#recognition">What sponsors receive <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="uses-fig">
        <SponsorSupportFigure />
      </div>
    </div>
  </Section>

  <!-- §3 -->
  <Section
    id="ways"
    num="3"
    title="Ways to support"
    dek="Money is one way to help. Rooms, prizes, printing, and time are others."
    note="Mix and match: an organization can do more than one of these, and every one of them helps."
  >
    <div class="cells cells-4 ways">
      <article class="cell">
        <p class="label">Lemma 3.1</p>
        <h3>Become a <em>sponsor.</em></h3>
        <p class="body">A gift from a business, foundation, or university department, recognized on this site and at events.</p>
        <ul class="gets">
          <li>Levels: see <a href="#give-details">Table 2</a></li>
          <li>Recognition to match: <a href="#recognition">what sponsors receive</a></li>
          <li>Tax status and contact: <a href="#records">top of this page</a></li>
        </ul>
        <a class="xref" href={sponsorFormHref}>Talk to us about sponsoring <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <p class="label">Lemma 3.2</p>
        <h3>Give <em>in kind.</em></h3>
        <p class="body">Not every gift is money. An organization can help with what it already has, for&nbsp;example:</p>
        <ul class="gets">
          <li>A room for an event</li>
          <li>Prizes or books for students</li>
          <li>Printing for problem sets</li>
          <li>Food for a long competition day</li>
        </ul>
        <a class="xref" href={sponsorFormHref}>Offer an in-kind gift <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <p class="label">Lemma 3.3</p>
        <h3>Give your <em>time.</em></h3>
        <p class="body">Mathematicians, engineers, teachers, and college students: an afternoon of your time goes a long&nbsp;way.</p>
        <ul class="gets">
          <li>Help run an event</li>
          <li>Write or check problems</li>
          <li>Mentor students who want to go further</li>
        </ul>
        <a class="xref" href={volunteerFormHref}>Volunteer with EBMA <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell" id="donors">
        <p class="label">Lemma 3.4</p>
        <h3>Give as an <em>individual.</em></h3>
        <p class="body">Parents, neighbors, and anyone who remembers the teacher who made math click: gifts of any size&nbsp;help.</p>
        <ul class="gets">
          <li>
            Online:{' '}
            {
              donateUrl === null ? (
                <Ph id="sponsors.donate" label="Donation link" />
              ) : donateExternal ? (
                <ResourceLink href={donateUrl}>Give online</ResourceLink>
              ) : (
                <a href={donateUrl}>Give online</a>
              )
            }
          </li>
          {/* Points at the org.mailing-address row in Table 2: delete both if you take email only. */}
          <li>By check: see <a href="#give-details">Table 2</a> for the address</li>
        </ul>
        <a class="xref" href="#records">Tax and legal details <span class="arr" aria-hidden="true">↑</span></a>
      </article>
    </div>
    <p class="aside-line">
      Teach at a school or run a club? That’s a partnership rather than a sponsorship: see <a href="/get-involved/#schools">schools and teachers</a> on
      the Get Involved page.
    </p>
  </Section>

  <!-- §4 -->
  <Section
    id="recognition"
    num="4"
    title="What sponsors *receive*"
    dek={'Thanks in public, and an honest account in\u00a0private.'}
    note={'A theorem is only as strong as its hypotheses. This one depends on the sponsorship\u00a0level.'}
  >
    <div class="recv-grid">
      <div class="thm">
        <p class="thm-head">
          <span class="label">Theorem 4.1</span>
          <span class="note">(recognition)</span>
        </p>
        <p class="thm-stmt">A sponsor will receive:</p>
        <ol class="recv">
          <li>
            <span class="rl">(a)</span>
            <div>
              <h3>Your name or logo on this site</h3>
              <p>On this page and in the acknowledgments on the <a href="/">Home</a> page, linked to your website.</p>
            </div>
          </li>
          <li>
            <span class="rl">(b)</span>
            <div>
              <h3>Thanks at events</h3>
              <p>Named and thanked in person, in front of the students and families your support&nbsp;reaches.</p>
            </div>
          </li>
          <li>
            <span class="rl">(c)</span>
            <div>
              <h3>A short impact report</h3>
              <p>
                At every level: what took place, how many students took part, and what your support made possible (see <a href="#reporting"
                  >reporting back</a
                >).
              </p>
            </div>
          </li>
        </ol>
        <p class="hyp">
          <span class="hyp-k">Hypothesis.</span> The level you choose decides how you’re recognized in (a) and (b). The levels are in
          <a href="#give-details">Table 2</a>.
        </p>
      </div>
      <aside class="aside-box cropped remark">
        <p class="label">Remark 4.1</p>
        <h3>Recognition, not access.</h3>
        <p>
          Sponsorship thanks you in public. It does not come with students’ names or contact details. Our Privacy Notice explains how we handle
          information about students and&nbsp;families.
        </p>
        <a class="btn btn-quiet" href="/privacy/">Privacy Notice <span class="arr" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </Section>

  <!-- §5 -->
  <Section
    id="current"
    num="5"
    title={namedTitle}
    dek={hasSponsors
      ? 'Organizations that support EBMA’s work with East Bay students.'
      : 'Open slots for now: sponsors and partners will be listed here as they sign\u00a0on.'}
    note={'Only organizations that have agreed to be named appear\u00a0here.'}
  >
    <div class="current">
      <div class="defs-col">
        <dl class="defs">
          <div>
            <dt><span class="label">Definition 5.1</span> <dfn>Sponsor</dfn></dt>
            <dd>An organization that supports EBMA with money or in-kind gifts. A person who gives is a <a href="#donors">donor</a>.</dd>
          </div>
          <div>
            <dt><span class="label">Definition 5.2</span> <dfn>Partner</dfn></dt>
            <dd>An organization that works with EBMA on programs for students, such as a school, a library, or a university&nbsp;department.</dd>
          </div>
        </dl>
        <div class="defs-links">
          <a class="xref" href={sponsorFormHref}>Propose a partnership <span class="arr" aria-hidden="true">→</span></a>
          <a class="xref" href="/events/">Events & Competitions <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="wall">
        <LogoSlots ctaHref={sponsorFormHref} />
        <figcaption class="caption">
          <b>Fig. 2.</b>
          {
            hasSponsors
              ? 'Sponsors and partners of the East Bay Math Association, with thanks.'
              : 'Open slots. Logos will appear here as sponsorships and partnerships are\u00a0confirmed.'
          }
        </figcaption>
      </figure>
    </div>
  </Section>

  <!-- §6 -->
  <Section
    id="become"
    num="6"
    title="Become a *sponsor*"
    dek="What we’re asking for, and three short steps to get there."
    note={'Unlike most problems on this site, this one has a short\u00a0solution.'}
  >
    <div class="become">
      <div class="how">
        <ol class="steps">
          <li>
            <span class="step-n" aria-hidden="true">1</span>
            <div>
              <h3>Tell us you’re interested</h3>
              <p>
                Use the short form, or write to the <a href="#records">sponsorship contact</a>. A sentence or two about what you’d like to support is&nbsp;plenty.
              </p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">2</span>
            <div>
              <h3>Talk it through</h3>
              <p>We’ll suggest a level from Table 2 or an in-kind gift that fits, and answer any questions from your&nbsp;team.</p>
            </div>
          </li>
          <li>
            <span class="step-n" aria-hidden="true">3</span>
            <div>
              <h3>Confirm and be thanked</h3>
              <p>We’ll confirm the details in writing and put your name or logo up once you approve it.</p>
            </div>
          </li>
        </ol>
        <div class="cta-row">
          <a class="btn" href={sponsorFormHref}>Start the conversation <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="records" id="give-details">
        <dl>
          <div>
            <dt>Raising support for</dt>
            <dd><Ph id="sponsors.current-need" label="Current need" /></dd>
          </div>
          <div>
            <dt>Sponsorship levels</dt>
            <dd><Ph id="sponsors.tiers" /></dd>
          </div>
          <div>
            <dt>Sponsor packet</dt>
            <dd>
              <PhLink id="sponsors.packet" label="Sponsor packet (PDF)">Download the sponsor packet (PDF)</PhLink>
            </dd>
          </div>
          {/* org.mailing-address; Lemma 3.4 ("By check") points here, so delete both or neither. */}
          <div>
            <dt>Checks by mail</dt>
            <dd><Ph id="org.mailing-address" /></dd>
          </div>
        </dl>
        <figcaption class="caption">
          <b>Table 2.</b> The ask in one place, for sponsors and individual donors alike. Legal status, tax-deductibility, and the sponsorship contact
          are <a href="#records">at the top of this page</a>.
        </figcaption>
      </figure>
    </div>
  </Section>

  <Band
    label="Corollary 6.1"
    m={8}
    title="Help write the next *chapter.*"
    text="Sponsor an event, lend a room, or give an afternoon. Start from the levels in Table 2, or tell us what you have in mind."
  >
    <a class="btn" href={sponsorFormHref}>Become a sponsor <span class="arr" aria-hidden="true">→</span></a>
    {
      hasSponsorContact ? (
        <PhLink id="sponsors.contact" class="btn btn-quiet">
          Email us about sponsoring
        </PhLink>
      ) : (
        <a class="btn btn-quiet" href={contactHref}>
          Contact us
        </a>
      )
    }
  </Band>
</Base>

<style>
  /* Placeholder chips are 0.78em of their context; never let them drop under 12px here. */
  .front :global(.ph),
  .why :global(.ph),
  .uses :global(.ph),
  .ways :global(.ph),
  .recv-grid :global(.ph),
  .become :global(.ph) {
    font-size: max(12px, 0.78em);
  }

  /* Reading text sets its rag with the browser's widow control; the last two words of each
     paragraph are also joined with a no-break space in the markup for engines without it. */
  .front dd,
  .why p,
  .uses p,
  .ways .body,
  .recv p,
  .remark p,
  .defs dd,
  .steps p,
  .records dd,
  .caption {
    text-wrap: pretty;
  }

  /* ---------- page header: actions, then "For your records" ---------- */
  /* The first thing a sponsor checks is whether EBMA is real, so the legal and tax facts sit in
     the header, set like the table of contents beside them (a ruled list under a small caps
     heading), not in a box that competes with the call to action. */
  .head-more .cta-row {
    margin-top: clamp(26px, 3vw, 40px);
  }
  .front {
    margin-top: clamp(30px, 3.4vw, 44px);
    max-width: 40em;
    border-top: 2px solid var(--ink);
    padding-top: 14px;
  }
  .front-h {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  /* The rows share one label column (subgrid), as wide as the longest label. */
  .front dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 28px;
  }
  .front dl > div {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 4px;
    align-items: baseline;
    padding: 11px 0 12px;
    border-bottom: 1px solid var(--rule);
  }
  .front dt {
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .front dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .front dl,
    .front dl > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- §1 why ---------- */
  .why {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .why-claim {
    border-top: 2px solid var(--ink);
    padding-top: 18px;
  }
  .why-claim .label {
    margin-bottom: 16px;
  }
  .claim {
    font: 350 clamp(25px, 2.3vw, 33px) / 1.3 var(--serif);
    letter-spacing: -0.012em;
    font-variation-settings: 'opsz' 36;
    text-wrap: pretty;
  }
  .why-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 28px;
  }
  .proof-lead {
    font-size: clamp(18px, 1.5vw, 20px);
    color: var(--ink-2);
    padding-top: 12px;
  }
  .proof-lead em {
    color: var(--ink);
    margin-right: 0.25em;
  }
  .reasons {
    list-style: none;
    margin-top: 18px;
    border-top: 1px solid var(--rule-2);
  }
  .reasons li {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    gap: 12px;
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--rule);
  }
  .rn {
    font: italic 400 22px/1.2 var(--serif);
    color: var(--accent-text);
  }
  .reasons h3 {
    font: 400 clamp(22px, 1.8vw, 26px) / 1.2 var(--serif);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .reasons p {
    color: var(--ink-2);
    font-size: 17.5px;
  }
  .why .conclude {
    font-size: clamp(18px, 1.5vw, 20px);
  }

  /* ---------- §2 where support goes ---------- */
  .uses {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .uses-lede {
    font: 350 clamp(21px, 1.9vw, 26px) / 1.4 var(--serif);
    font-variation-settings: 'opsz' 30;
    text-wrap: pretty;
  }
  /* Table 1 is the global data table (.table), with the 2px ink rules on the table itself (two
     columns never need .table-wrap's scroller) so the caption sits underneath like a figure's,
     matching Table 2 in §6. */
  .funds {
    margin-top: 28px;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
