---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Band from '../components/Band.astro';
import Ph from '../components/Ph.astro';
import PhLink from '../components/PhLink.astro';
import EventsAgenda from '../components/EventsAgenda.astro';
import CompetitionTimeline from '../components/CompetitionTimeline.astro';
import CompetitionTable from '../components/CompetitionTable.astro';
import CompetitionPathway from '../components/CompetitionPathway.astro';
import CompetitionEntry from '../components/CompetitionEntry.astro';
import { events, upcomingEvents, SAMPLE_COUNT } from '../data/events';
import { competitions, groups, upcomingDates, gradeFit, gradeFitNote, calendarFile, FINDER_GRADES, SEASON } from '../data/competitions';
import { joinHref, contactHref } from '../data/site';

// Number the directory entries [1], [2], … in the order they appear.
let n = 0;
const directory = groups.map((g) => ({ ...g, items: competitions.filter((c) => c.group === g.id).map((c) => ({ c, n: ++n })) }));

const educatorHref = '/get-involved/?role=educator#join';

// §3 grade finder (scripts/events-grades.ts): for each contest and each grade offered, whether the
// organizer's stated grades include it (1), exclude it (0), or give no numbers (2), and the note
// to show; plus the calendar download (and its number of dates) for each grade. '' = all grades.
const posted = upcomingDates();
const icsHref = (g?: number) => `/events/${calendarFile(g)}.ics`;
const icsCount = (g?: number) => posted.filter((d) => g === undefined || gradeFit(d.competition, g).fit !== 'no').length;
const finder = {
  grades: FINDER_GRADES,
  fit: Object.fromEntries(
    competitions.map((c) => [c.id, FINDER_GRADES.map((g) => [{ no: 0, yes: 1, check: 2 }[gradeFit(c, g).fit], gradeFitNote(c, g)])]),
  ),
  ics: Object.fromEntries([['', [icsHref(), icsCount()]], ...FINDER_GRADES.map((g) => [String(g), [icsHref(g), icsCount(g)]])]),
};
// Safe inside <script>: no "</script>" can survive the \u003c escape.
const finderJson = JSON.stringify(finder).replace(/</g, '\\u003c');
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// §3 "Notation": the short names in Fig. 1 and Table 2, spelled out where they first appear.
// Each gloss restates facts from src/data/competitions.ts; keep the two in step.
const notation: [string, string][] = [
  ['AMC 8, 10, 12', 'American Mathematics Competitions, multiple choice. The number is the highest grade that can enter.'],
  ['AIME', 'American Invitational Mathematics Examination, by invitation; top AMC 10 and 12 scorers qualify.'],
  ['USAJMO, USAMO', 'USA Junior Mathematical Olympiad and USA Mathematical Olympiad, proof-based, by invitation.'],
  ['MAA', 'Mathematical Association of America, which runs the AMC, AIME, USAJMO, and USAMO.'],
  ['USAMTS', 'USA Mathematical Talent Search, a free proof-based contest done on your own time.'],
  ['MATHCOUNTS', 'A national contest program for grades 6–8, from school up to national level.'],
  ['BAMO', 'Bay Area Mathematical Olympiad, a proof-based contest taken at a school or a math circle (a math club built around solving problems together).'],
  ['BMT, HMMT', 'Berkeley Math Tournament and Harvard–MIT Mathematics Tournament, both student-run.'],
];
---

<Base
  title="Events & Competitions"
  description={`EBMA events for East Bay students, what to expect at one, and a verified ${SEASON.label} calendar of math competitions with official links.`}
>
  <PageHeader
    chapter={2}
    runRight={`${SEASON.label} season · All times Pacific`}
    label="Chronology"
    note="(in which we mark the calendar)"
    title={'Events &\u00a0*competitions*'}
    lede={`EBMA’s own events, what to expect when you come to one, and a calendar of the math competitions East Bay students can enter in ${SEASON.label}, checked against each organizer’s official site.`}
    contents={[
      { href: '#upcoming', num: '1', title: 'Upcoming EBMA events' },
      { href: '#expect', num: '2', title: 'What to expect' },
      { href: '#calendar', num: '3', title: `The ${SEASON.label} calendar` },
      { href: '#competitions', num: '4', title: 'Competitions to know' },
    ]}
  >
    <Fragment slot="actions">
      {
        /* While no EBMA events are scheduled, the verified competition calendar is this page's real
           content, so it gets the primary button. */
        upcomingEvents(events).length ? (
          <>
            <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
            <a class="xref" href="#calendar">See the competition calendar <span class="arr" aria-hidden="true">↓</span></a>
          </>
        ) : (
          <>
            <a class="btn" href="#calendar">See the competition calendar <span class="arr" aria-hidden="true">↓</span></a>
            <a class="xref" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
          </>
        )
      }
    </Fragment>
  </PageHeader>

  <Section
    id="upcoming"
    num="1"
    title="Upcoming EBMA events"
    dek="Events run by the East Bay Math Association, soonest first. New ones will appear here as they are scheduled."
    note="All times Pacific. Each listing will say when and where, who it is for, what it costs, and how to register."
  >
    <a slot="actions" class="xref" href="#calendar">Other competitions this year <span class="arr" aria-hidden="true">↓</span></a>
    <EventsAgenda events={events} sampleCount={SAMPLE_COUNT} num="1" />
    <p class="tcap">
      <b>Table 1.</b> Upcoming EBMA events, in date order. Contests run by other organizations are in the <a href="#calendar">{SEASON.label} competition calendar</a> (§3).
    </p>

    <aside class="first aside-box cropped" aria-labelledby="first-h">
      <div class="first-text">
        <p class="label">Remark 1.1</p>
        <h3 id="first-h">Hear about new events first</h3>
        <p>
          Get new events by email as soon as they are announced:
          <span class="nowrap"><PhLink id="org.mailing-list" label="Mailing-list link">join the mailing list</PhLink>.</span> Or join EBMA and tell us which
          events you’d like to see.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn btn-quiet" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
        <a class="xref" href={educatorHref}>Teachers: partner with us <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </aside>
  </Section>

  <Section
    id="expect"
    num="2"
    title="What to expect at an EBMA *event*"
    dek="For parents and guardians: the practical details, before anyone signs up."
    note="A lemma is a small result that helps prove a bigger one. These six help the day go smoothly."
  >
    <a slot="actions" class="xref" href="/about/#faq">Questions parents ask <span class="arr" aria-hidden="true">→</span></a>
    <div class="lemmas">
      <article class="lemma">
        <p class="label">Lemma 2.1</p>
        <h3>Registration</h3>
        <p class="body">Each event listing will say how to sign up and by when. Registering ahead lets us plan the room, the problems, and the adults on hand.</p>
        <p class="fact"><Ph id="events.registration" /></p>
        <a class="xref" href="#upcoming">Upcoming events <span class="arr" aria-hidden="true">↑</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.2</p>
        <h3>What it costs</h3>
        <p class="body">Each event listing will say what it costs before you sign up. If cost is what stands in the way, tell us before you decide not to come.</p>
        <p class="fact"><Ph id="org.membership-cost" /></p>
        <a class="xref" href={contactHref}>Ask us about cost <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.3</p>
        <h3>What to bring</h3>
        <p class="body">Each listing will say what students need on the day. When in doubt, ask us before the day rather than at the door.</p>
        <p class="fact"><Ph id="events.bring" /></p>
        <a class="xref" href="/resources/#problems">Warm up with a practice problem <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.4</p>
        <h3>Supervision and safety</h3>
        <p class="body">You should always know who is looking after your child during an event, and how to reach them on the day.</p>
        <p class="fact"><Ph id="org.safety-policy" /></p>
        <a class="xref" href={contactHref}>Ask us about supervision <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.5</p>
        <h3>Photos and media</h3>
        <p class="body">Families should know whether photos are taken at an event, where they might appear, and how to say no.</p>
        <p class="fact"><Ph id="events.photo-policy" /></p>
        <a class="xref" href={contactHref}>Ask us about photos <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.6</p>
        <h3>Questions</h3>
        <p class="body">Not sure an event is right for your child? Ask. We would rather answer a question than miss a student.</p>
        <p class="fact"><PhLink id="org.email" label="Contact email" /></p>
        <a class="xref" href={contactHref}>Contact us <span class="arr" aria-hidden="true">→</span></a>
      </article>
    </div>
  </Section>

  <Section
    id="calendar"
    num="3"
    title={`The ${SEASON.label} competition *calendar*`}
    dek="Math contests run by other organizations that East Bay students can enter this school year, plotted from September to June."
    wide
  >
    <a slot="actions" class="xref" href="#competitions">About each competition <span class="arr" aria-hidden="true">↓</span></a>
    <div class="gf" id="grade-finder" data-gf>
      <div class="gf-text">
        <p class="label">Restriction</p>
        <h3>Which contests can I enter?</h3>
        <p class="gf-lead">
          Choose your grade for {SEASON.label}. Table 2 and §4 then list only the contests open to it, going by each organizer’s own rules, and Fig. 1
          fades the rest.
        </p>
      </div>
      <div class="gf-pick">
        <p class="gf-k" id="gf-k">Your grade</p>
        <div class="gf-btns" role="group" aria-labelledby="gf-k">
          <button type="button" class="gf-btn gf-all" aria-pressed="true" data-gf-grade="">All grades</button>
          <span class="gf-nums">
            {
              FINDER_GRADES.map((g) => (
                <button type="button" class="gf-btn" aria-pressed="false" data-gf-grade={g}>
                  <span class="sr-only">Grade </span>
                  {g}
                </button>
              ))
            }
          </span>
        </div>
      </div>
      <p class="gf-status" role="status" data-gf-status>Showing all {competitions.length} contests.</p>
      <script type="application/json" data-gf-data set:html={finderJson} />
    </div>
    <div class="notation" role="group" aria-labelledby="notation-h">
      <p class="label" id="notation-h">Notation</p>
      <p class="nt-lead">The short names used in the calendar, spelled out. §4 describes each contest.</p>
      <dl class="nt">
        {
          notation.map(([term, def]) => (
            <div>
              <dt>{term}</dt>
              <dd>{def}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <CompetitionTimeline />
    <CompetitionTable />
    <p class="ics">
      <a class="xref" href={icsHref()} data-gf-ics>
        <span data-gf-ics-label>Add these dates to your calendar</span>
        <span class="ics-tag">.ics</span>
      </a>
      <span class="ics-note">
        A file of the <span data-gf-ics-count>{plural(icsCount(), 'date', 'dates')} posted so far</span>, for most calendar apps. Each event
        links to its official site and says when we checked it.
      </span>
    </p>
  </Section>

  <Section
    id="competitions"
    num="4"
    title="Competitions to *know*"
    dek="Every contest in the calendar, grouped by who it is for, with its format, its cost, and a link to the official site."
    note="EBMA is not affiliated with any of these organizations. Each fact comes from the organizer’s own site, checked on September 23, 2026."
  >
    <a slot="actions" class="xref" href="/resources/">Practice problems &amp; resources <span class="arr" aria-hidden="true">→</span></a>

    <div class="pathway">
      <div class="pathway-text">
        <p class="label">Proposition 4.1</p>
        <h3>How the MAA contests connect</h3>
        <p>
          The Mathematical Association of America (MAA) runs a ladder of contests. The first rung is the American Mathematics Competitions (AMC):
          the multiple-choice AMC 8, AMC 10, and AMC 12, taken through a host school or site. A qualifying AMC 10 or 12 score earns an invitation to
          the AIME (American Invitational Mathematics Examination), and invitations to the USAJMO and USAMO (USA Junior Mathematical Olympiad and
          USA Mathematical Olympiad) are based mainly on AIME scores. The USA Mathematical Talent Search (USAMTS), a free proof-based contest run by the Art of Problem Solving
          Initiative, is another way to qualify for the AIME.
        </p>
      </div>
      <CompetitionPathway />
    </div>

    <p class="gf-echo" data-gf-echo hidden>
      <span data-gf-echo-text></span>
      <span class="gf-echo-acts">
        <button type="button" class="gf-reset" data-gf-reset>Show all grades</button>
        <a class="xref" href="#grade-finder">Change grade <span class="arr" aria-hidden="true">↑</span></a>
      </span>
    </p>

    {
      directory.map((g, gi) => (
        <div class="cgroup" id={`competitions-${g.id}`}>
          <div class="cg-head">
            <p class="cg-num" aria-hidden="true">
              4.{gi + 1}
            </p>
            <div>
              <h3>{g.title}</h3>
              <p class="cg-dek">
                {g.dek}
                {g.id === 'middle' && (
                  <span class="gf-only">
                    {' '}
                    Or <a href="#grade-finder">choose your grade</a> in §3 to list them.
                  </span>
                )}
              </p>
            </div>
          </div>
          <details class="cg-fold" open data-fold>
            <summary class="cg-sum">
              <span class="cg-sum-t">
                <span data-gf-count>{plural(g.items.length, 'contest', 'contests')}</span>
                <span class="sr-only">: </span>
              </span>
              <span class="cg-sum-names">
                {g.items.map(({ c }, i) => (
                  <span class="cg-nm" data-cid={c.id}>
                    {i > 0 && (
                      <span class="cg-sep" data-gf-sep>
                        <span class="sr-only">, </span>
                        <span class="sep" aria-hidden="true">
                          ·
                        </span>
                      </span>
                    )}
                    <span class="nm">{c.listName ?? c.short}</span>
                  </span>
                ))}
              </span>
              <span class="cg-sum-ic" aria-hidden="true" />
            </summary>
            <div class="cg-list">
              {g.items.map(({ c, n }) => (
                <CompetitionEntry competition={c} n={n} />
              ))}
            </div>
          </details>
        </div>
      ))
    }
    <p class="conclude">
      <span>Always confirm dates, fees, and rules with the organizer.</span><span
        class="qed"
        aria-hidden="true"></span>
    </p>
  </Section>

  <Band
    label="Corollary 4.1"
    title="Bring a friend and a *pencil.*"
    text="Join EBMA to hear about new events first, or tell us what you’d like to see on the calendar."
    m={4}
  >
    <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
    <a class="btn btn-quiet" href={contactHref}>Contact us</a>
  </Band>
</Base>

<script>
  import '../scripts/events-folds';
  import '../scripts/events-grades';
</script>

<style>
  .tcap {
    margin-top: 18px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .tcap b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .tcap a {
    color: var(--ink);
  }

  /* §1: hear about new events first. The box is the shared .aside-box; on wide screens the
     buttons sit to the right of the text. */
  .first {
    margin-top: clamp(36px, 4vw, 52px);
  }
  .first-text > * + * {
    margin-top: 10px;
  }
  .first-text p:not(.label) {
    max-width: 38em;
  }
  .first p a {
    color: var(--ink);
  }
  @media (min-width: 1181px) {
    .first {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px 40px;
      align-items: center;
    }
    .first > .cta-row {
      margin-top: 0;
    }
  }

  /* §3: the grade finder (scripts/events-grades.ts). It needs JavaScript, so without it the
     finder is not shown and the page lists every contest. Text on the left, the buttons on the
     right on wide screens; on phones the grades sit in two rows, 5–8 over 9–12. */
  :global(html:not(.js)) .gf,
  :global(html:not(.js)) .gf-only {
    display: none;
  }
  .gf {
    margin-bottom: clamp(40px, 5vw, 64px);
    padding-top: 16px;
    border-top: 2px solid var(--ink);
    display: grid;
    gap: 22px 56px;
  }
  .gf-text h3 {
    margin-top: 10px;
    font: 400 clamp(27px, 2.4vw, 36px) / 1.08 var(--serif);
    letter-spacing: -0.015em;
  }
  .gf-lead {
    margin-top: 10px;
    max-width: 34em;
    font-size: 17px;
    color: var(--ink-2);
  }
  .gf-k {
    margin-bottom: 10px;
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .gf-btns {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px;
  }
  .gf-nums {
    display: grid;
    grid-template-columns: repeat(8, 44px);
    gap: 6px;
  }
  .gf-btn,
  .gf-reset {
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    background: transparent;
    border: 1px solid var(--rule-2);
    border-radius: 0;
    color: var(--ink);
    font: 600 15px/1 var(--sans);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .gf-nums .gf-btn {
    padding: 0;
  }
  .gf-btn:hover,
  .gf-reset:hover {
    border-color: var(--ink);
  }
  .gf-btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .gf-status {
    font: 500 15px/1.45 var(--sans);
    color: var(--ink-2);
    max-width: 46em;
  }
  @media (min-width: 1100px) {
    .gf {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .gf-status {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 620px) {
    .gf-nums {
      grid-template-columns: repeat(4, 44px);
    }
    .gf-status {
      font-size: 16px;
    }
  }
  /* Forced colors drop backgrounds, which is how a pressed button shows: use the system highlight. */
  @media (forced-colors: active) {
    .gf-btn[aria-pressed='true'] {
      forced-color-adjust: none;
      background: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }
  }

  /* §3: the calendar download, under Table 2. */
  .ics {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
  }
  .ics .xref {
    flex: 0 1 auto;
    min-width: 0;
  }
  .ics-tag {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.04em;
    padding: 3px 5px;
    border: 1px solid var(--rule-2);
    color: var(--ink-2);
  }
  .ics-note {
    flex: 1 1 24em;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* §4: what the grade finder is showing, with a way back to every contest. */
  .gf-echo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
    padding: 10px 0 10px 16px;
    border-left: 2px solid var(--accent);
    font: 600 15.5px/1.4 var(--sans);
  }
  .gf-echo-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
  }
  .gf-only a {
    color: var(--ink);
  }

  /* §3: notation, the short names spelled out before the calendar uses them */
  .notation {
    margin-bottom: clamp(36px, 4.5vw, 56px);
    padding-top: 14px;
    border-top: 1px solid var(--rule-2);
  }
  .nt-lead {
    margin-top: 8px;
    font-size: 17px;
    color: var(--ink-2);
  }
  .nt {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px clamp(24px, 3vw, 48px);
  }
  .nt div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .nt dt {
    font: 600 14px/1.4 var(--mono);
    color: var(--ink);
  }
  .nt dd {
    font-size: 16.5px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .nowrap,
  .nowrap :global(.ph) {
    white-space: nowrap;
  }

  /* §2: six lemmas in ruled cells */
  .lemmas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule-2);
  }
  .lemma {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 26px 30px;
    border-left: 1px solid var(--rule);
    min-width: 0;
  }
  .lemma:nth-child(3n + 1) {
    border-left: 0;
    padding-left: 0;
  }
  .lemma:nth-child(3n) {
    padding-right: 0;
  }
  .lemma:nth-child(n + 4) {
    border-top: 1px solid var(--rule);
  }
  .lemma h3 {
    font: 400 clamp(25px, 2.1vw, 31px) / 1.1 var(--serif);
    letter-spacing: -0.015em;
  }
  .lemma .body {
    font-size: 17.5px;
    color: var(--ink-2);
    flex: 1;
    text-wrap: pretty;
  }
  .lemma .fact {
    font-size: 17px;
  }
  .lemma .xref {
    align-self: flex-start;
  }

  /* §4: the pathway figure and the directory */
  .pathway {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .pathway-text {
    max-width: 40em;
  }
  .pathway-text h3 {
    margin-top: 10px;
    font: 400 clamp(27px, 2.4vw, 36px) / 1.08 var(--serif);
    letter-spacing: -0.015em;
  }
  .pathway-text p:last-child {
    margin-top: 12px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .cgroup + .cgroup {
    margin-top: clamp(40px, 5vw, 64px);
