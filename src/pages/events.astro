---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Band from '../components/Band.astro';
import Ph from '../components/Ph.astro';
import PhLink from '../components/PhLink.astro';
import EventsAgenda from '../components/EventsAgenda.astro';
import CompetitionTimeline from '../components/CompetitionTimeline.astro';
import CompetitionTable from '../components/CompetitionTable.astro';
import CompetitionPathway from '../components/CompetitionPathway.astro';
import CompetitionEntry from '../components/CompetitionEntry.astro';
import { events, SAMPLE_COUNT } from '../data/events';
import { competitions, groups, SEASON } from '../data/competitions';
import { joinHref, contactHref } from '../data/site';

// Number the directory entries [1], [2], … in the order they appear.
let n = 0;
const directory = groups.map((g) => ({ ...g, items: competitions.filter((c) => c.group === g.id).map((c) => ({ c, n: ++n })) }));
---

<Base
  title="Events & Competitions"
  description={`EBMA events for East Bay students, what to expect when you come to one, and a verified ${SEASON.label} calendar of math competitions students can enter, with official links.`}
>
  <PageHeader
    chapter={2}
    runRight={`${SEASON.label} season · All times Pacific`}
    label="Chapter 2"
    note="(in which we mark the calendar)"
    title="Events & *competitions*"
    lede={`EBMA’s own events, what to expect when you come to one, and a calendar of the math competitions East Bay students can enter in ${SEASON.label}, checked against each organizer’s official site.`}
    contents={[
      { href: '#upcoming', num: '1', title: 'Upcoming EBMA events' },
      { href: '#expect', num: '2', title: 'What to expect' },
      { href: '#calendar', num: '3', title: `The ${SEASON.label} calendar` },
      { href: '#competitions', num: '4', title: 'Competitions to know' },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
      <a class="xref" href="#calendar">See the competition calendar <span class="arr" aria-hidden="true">↓</span></a>
    </Fragment>
  </PageHeader>

  <Section
    id="upcoming"
    num="1"
    title="Upcoming EBMA events"
    dek="Events run by the East Bay Math Association, soonest first. New ones appear here as they are scheduled."
    note="All times Pacific. Each listing will say when and where, who it is for, what it costs, and how to register."
  >
    <a slot="actions" class="xref" href="#calendar">Other competitions this year <span class="arr" aria-hidden="true">↓</span></a>
    <EventsAgenda events={events} sampleCount={SAMPLE_COUNT} num="1" />
    <p class="tcap">
      <b>Table 1.</b> Upcoming EBMA events, in date order. Contests run by other organizations are in the <a href="#calendar">{SEASON.label} competition calendar</a> (§3).
    </p>

    <div class="first">
      <div class="first-text">
        <h3>Hear about new events first</h3>
        <p>
          Get new events by email as soon as they are announced:
          <span class="nowrap"><PhLink id="org.mailing-list" label="Mailing-list link">join the mailing list</PhLink>.</span> Or join EBMA and tell us which
          events you’d like to see.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
        <a class="xref" href="/get-involved/#schools">Teachers: partner with us <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </Section>

  <Section
    id="expect"
    num="2"
    title="What to expect at an EBMA *event*"
    dek="For parents and guardians: the practical details, before anyone signs up."
    note="A lemma is a small result that helps prove a bigger one. These six help the day go smoothly."
  >
    <a slot="actions" class="xref" href="/about/#faq">Questions parents ask <span class="arr" aria-hidden="true">→</span></a>
    <div class="lemmas">
      <article class="lemma">
        <p class="label">Lemma 2.1</p>
        <h3>Registration</h3>
        <p class="body">Each event listing says how to sign up and by when. Registering ahead lets us plan the room, the problems and the adults on hand.</p>
        <p class="fact"><Ph id="events.registration" /></p>
        <a class="xref" href="#upcoming">Upcoming events <span class="arr" aria-hidden="true">↑</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.2</p>
        <h3>Cost and fee waivers</h3>
        <p class="body">The cost of every event is posted before you sign up. If cost is what stands in the way, tell us before you decide not to come.</p>
        <p class="fact"><Ph id="org.membership-cost" /></p>
        <a class="xref" href="/sponsors/#become">Help cover a student’s costs <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.3</p>
        <h3>What to bring</h3>
        <p class="body">Each listing says what students need on the day. When in doubt, ask us before the day rather than at the door.</p>
        <p class="fact"><Ph id="events.bring" /></p>
        <a class="xref" href="/resources/#problems">Warm up with a practice problem <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.4</p>
        <h3>Supervision and safety</h3>
        <p class="body">You should always know who is looking after your child during an event, and how to reach them on the day.</p>
        <p class="fact"><Ph id="org.safety-policy" /></p>
        <a class="xref" href="/about/">About EBMA <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.5</p>
        <h3>Photos and media</h3>
        <p class="body">Families should know whether photos are taken at an event, where they might appear, and how to say no.</p>
        <p class="fact"><Ph id="events.photo-policy" /></p>
        <a class="xref" href="/privacy/">Privacy notice <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="lemma">
        <p class="label">Lemma 2.6</p>
        <h3>Questions</h3>
        <p class="body">Not sure an event is right for your child? Ask. We would rather answer a question than miss a student.</p>
        <p class="fact"><PhLink id="org.email" label="Contact email" /></p>
        <a class="xref" href={contactHref}>Contact us <span class="arr" aria-hidden="true">→</span></a>
      </article>
    </div>
  </Section>

  <Section
    id="calendar"
    num="3"
    title={`The ${SEASON.label} competition *calendar*`}
    dek="Math contests run by other organizations that East Bay students can enter this school year, plotted from September to June."
    wide
  >
    <a slot="actions" class="xref" href="#competitions">About each competition <span class="arr" aria-hidden="true">↓</span></a>
    <CompetitionTimeline />
    <CompetitionTable />
  </Section>

  <Section
    id="competitions"
    num="4"
    title="Competitions to *know*"
    dek="Every contest in the calendar, grouped by who it is for, with its format, its cost and a link to the official site."
    note="EBMA is not affiliated with any of these organizations. Each fact comes from the organizer’s own site, checked on September 23, 2026."
  >
    <a slot="actions" class="xref" href="/resources/">Practice problems &amp; resources <span class="arr" aria-hidden="true">→</span></a>

    <div class="pathway">
      <div class="pathway-text">
        <p class="label">Proposition 4.1</p>
        <h3>How the MAA contests connect</h3>
        <p>
          The Mathematical Association of America’s contests form a ladder. The AMC 8 and the AMC 10 and 12 are taken through a host school or site. A
          qualifying AMC 10 or 12 score earns an invitation to the AIME, and USAJMO and USAMO invitations are based mainly on AIME scores. USAMTS, a
          free proof-based contest, is another way to qualify for the AIME.
        </p>
      </div>
      <CompetitionPathway />
    </div>

    {
      directory.map((g, gi) => (
        <div class="cgroup" id={`competitions-${g.id}`}>
          <div class="cg-head">
            <p class="cg-num" aria-hidden="true">
              4.{gi + 2}
            </p>
            <div>
              <h3>{g.title}</h3>
              <p class="cg-dek">{g.dek}</p>
            </div>
          </div>
          <div class="cg-list">
            {g.items.map(({ c, n }) => (
              <CompetitionEntry competition={c} n={n} />
            ))}
          </div>
        </div>
      ))
    }
    <p class="conclude">
      <span>EBMA is not affiliated with these organizations. Always confirm dates, fees and rules with the organizer.</span><span
        class="qed"
        aria-hidden="true"></span>
    </p>
  </Section>

  <Band
    label="Corollary 2.1"
    title="Bring a friend and a *pencil.*"
    text="Join EBMA to hear about new events first, or tell us what you’d like to see on the calendar."
  >
    <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
    <a class="btn btn-quiet" href={contactHref}>Contact us</a>
  </Band>
</Base>

<style>
  .tcap {
    margin-top: 18px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .tcap b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .tcap a {
    color: var(--ink);
  }

  /* §1: hear about new events first */
  .first {
    margin-top: clamp(36px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    padding: 26px 28px;
    border: 1px solid var(--rule-2);
    border-left: 4px solid var(--accent);
  }
  .first h3 {
    font: 400 clamp(24px, 2.2vw, 30px) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .first p {
    margin-top: 8px;
    font-size: 17.5px;
    color: var(--ink-2);
    max-width: 36em;
  }
  .first p a {
    color: var(--ink);
  }
  .nowrap,
  .nowrap :global(.ph) {
    white-space: nowrap;
  }

  /* §2: six lemmas in ruled cells */
  .lemmas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule-2);
  }
  .lemma {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 26px 30px;
    border-left: 1px solid var(--rule);
    min-width: 0;
  }
  .lemma:nth-child(3n + 1) {
    border-left: 0;
    padding-left: 0;
  }
  .lemma:nth-child(3n) {
    padding-right: 0;
  }
  .lemma:nth-child(n + 4) {
    border-top: 1px solid var(--rule);
  }
  .lemma h3 {
    font: 400 clamp(25px, 2.1vw, 31px) / 1.1 var(--serif);
    letter-spacing: -0.015em;
  }
  .lemma .body {
    font-size: 17.5px;
    color: var(--ink-2);
    flex: 1;
  }
  .lemma .fact {
    font-size: 17px;
  }
  .lemma .xref {
    align-self: flex-start;
  }

  /* §4: the pathway figure and the directory */
  .pathway {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  .pathway-text {
    max-width: 40em;
  }
  .pathway-text h3 {
    margin-top: 10px;
    font: 400 clamp(27px, 2.4vw, 36px) / 1.08 var(--serif);
    letter-spacing: -0.015em;
  }
  .pathway-text p:last-child {
    margin-top: 12px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .cgroup + .cgroup {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .cg-head {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    column-gap: 8px;
    align-items: baseline;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    margin-bottom: 4px;
  }
  .cg-num {
    font: 500 14px/1 var(--mono);
    color: var(--accent-text);
  }
  .cg-head h3 {
    font: 400 clamp(27px, 2.4vw, 36px) / 1.08 var(--serif);
    letter-spacing: -0.015em;
  }
  .cg-dek {
    margin-top: 6px;
    font-size: 17px;
    color: var(--ink-2);
  }
  .cg-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 3vw, 48px);
    margin-top: 18px;
  }
  .conclude {
    margin-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--rule-2);
    font-size: clamp(18px, 1.5vw, 21px);
  }

  @media (max-width: 1100px) {
    .lemmas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lemma:nth-child(n) {
      border-left: 1px solid var(--rule);
      padding: 26px 24px 30px;
      border-top: 0;
    }
    .lemma:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .lemma:nth-child(even) {
      padding-right: 0;
    }
    .lemma:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 1180px) {
    .cg-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 1180px) {
    .first {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .first {
      padding: 22px 20px;
    }
    .lemmas {
      grid-template-columns: minmax(0, 1fr);
    }
    .lemma:nth-child(n) {
      border-left: 0;
      padding: 24px 0;
      border-top: 1px solid var(--rule);
    }
    .lemma:first-child {
      border-top: 0;
    }
  }
  @media (max-width: 620px) {
    .cg-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .cg-num {
      margin-bottom: 8px;
    }
  }
</style>
