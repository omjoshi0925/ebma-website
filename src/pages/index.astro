---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import TimesTableFigure from '../components/TimesTableFigure.astro';
import EventCard from '../components/EventCard.astro';
import Problem from '../components/Problem.astro';
import Band from '../components/Band.astro';
import Ph from '../components/Ph.astro';
import DefFigure from '../components/DefFigure.astro';
import { events, upcomingEvents, SAMPLE_COUNT, dateLabel } from '../data/events';
import { problems } from '../data/problems';
import { SEASON } from '../data/competitions';
import { joinHref, contactHref } from '../data/site';

/* Events that have not passed yet: dated ones soonest first, then those with no date yet. The page
   lists all of them but shows the first three cards and one "Next up" line; the script below drops
   any that pass before the next build. */
const upcoming = upcomingEvents(events);
const featured = problems.find((p) => p.id === 'frog')!;
---

<Base>
  <!-- Hero: Theorem 1 -->
  <section class="wrap" aria-labelledby="hero-title">
    <div class="runhead">
      <span>§0 &nbsp;Introduction</span>
      <span class="rh-r">East Bay, California &nbsp;·&nbsp; 37.8° N, 122.3° W</span>
    </div>
    <div class="hero">
      <div class="hero-text">
        <p class="thm-label rise" style="--d:0">
          <span class="label">Theorem 1</span><span class="note">(the East Bay theorem)</span>
        </p>
        <h1 id="hero-title" class="rise" style="--d:120">Anyone in the East&nbsp;Bay can do <em>real</em> mathematics.</h1>
        <p class="proof rise" style="--d:300">
          <em>Proof.</em> By construction. The East Bay Math Association brings people from across the East Bay
          together for talks, trips to hackathons and events, and serious fun with hard problems. The remaining steps are left as an exercise
          for&nbsp;you.<span
            class="qed qed-float"
            aria-hidden="true"></span>
        </p>
        <div class="cta-row rise" style="--d:420">
          <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
          {
            upcoming.length ? (
              <a class="xref" href="#events">See upcoming events <span class="arr" aria-hidden="true">↓</span></a>
            ) : (
              <a class="xref" href="/events/#calendar">See the competition calendar <span class="arr" aria-hidden="true">→</span></a>
            )
          }
        </div>
        <div class="hero-foot rise" style="--d:540">
          <p class="next-up">
            <span class="next-tag">Next up</span>
            {
              events.length === 0 ? (
                <Ph id="events.upcoming" label="First event and date" />
              ) : (
                <>
                  <span class="next-list" data-upcoming data-empty="next-none" hidden={upcoming.length === 0}>
                    {upcoming.map((e) => (
                      <a href="/events/#upcoming" data-end={e.date}>
                        {e.title} · {dateLabel(e)}
                      </a>
                    ))}
                  </span>
                  <span id="next-none" class="next-none" hidden={upcoming.length > 0}>
                    No events scheduled right now. <a href="/events/#calendar">See the competition calendar</a>.
                  </span>
                </>
              )
            }
          </p>
          <div class="routes">
            <p class="routes-h" id="routes-h">Start here</p>
            <ul aria-labelledby="routes-h">
              <li>
                <a href="#exercise">Try a <span class="nowrap">problem<span class="arr" aria-hidden="true">↓</span></span></a>
              </li>
              <li>
                <a href="/events/#past">See past <span class="nowrap">talks<span class="arr" aria-hidden="true">→</span></span></a>
              </li>
              <li>
                <a href="/about/#people">Who runs <span class="nowrap">EBMA<span class="arr" aria-hidden="true">→</span></span></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="hero-fig rise" style="--d:200">
        <TimesTableFigure />
      </div>
    </div>
  </section>

  <!-- Abstract: the mission -->
  <section class="abstract wrap" aria-labelledby="abstract-h">
    <div class="abstract-inner">
      <h2 id="abstract-h">Abstract</h2>
      <p class="lede">
        The East Bay Math Association exists so that anyone in the East Bay who is curious about mathematics has somewhere to take that
        curiosity: talks worth hearing, problems worth their time, and people who take both seriously. We bring people together to listen, to
        explore, and to find out how far a good idea can go, in mathematics and in the fields next to it.
      </p>
      <p class="keywords"><b>Keywords:</b> talks · hackathons · problem solving · East Bay</p>
    </div>
  </section>

  <Section id="what" num="1" title="What we do" dek="Three definitions, one idea: mathematics is better done together.">
    <div class="cells">
      <article class="cell">
        <DefFigure kind="graph" />
        <p class="label">Definition 1.1</p>
        <h3>Listen<i>.</i></h3>
        <p class="body">Talks on mathematics at work, from pacing a swim race and pricing stock options to aerospace engineering and data science, given by the people who do the work.</p>
        <a class="xref" href="/events/">Events &amp; Competitions <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <DefFigure kind="floor" />
        <p class="label">Definition 1.2</p>
        <h3>Go<i>.</i></h3>
        <p class="body">Trips, together, to hackathons and events in fields next to mathematics: the places where the ideas get put to work.</p>
        <a class="xref" href="/get-involved/">Get Involved <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <DefFigure kind="spiral" />
        <p class="label">Definition 1.3</p>
        <h3>Explore<i>.</i></h3>
        <p class="body">Problems and study resources that reach past the standard curriculum, toward the kind of mathematics that keeps you thinking on the walk home.</p>
        <a class="xref" href="/resources/">Student Resources <span class="arr" aria-hidden="true">→</span></a>
      </article>
    </div>
  </Section>

  <Section
    id="events"
    num="2"
    title="Upcoming events"
    dek="Events open to anyone interested in math."
    note="All times Pacific. Dates, times, and places are posted here as soon as they are set."
  >
    <a slot="actions" class="xref" href="/events/#upcoming">All upcoming events <span class="arr" aria-hidden="true">→</span></a>
    {
      events.length === 0 ? (
        <div class="events">
          {Array.from({ length: SAMPLE_COUNT }, (_, i) => (
            <div class:list={['ev-item', { 'sample-extra': i > 0 }]}>
              <EventCard sample={i + 1} num={`2.${i + 1}`} />
            </div>
          ))}
        </div>
      ) : (
        <>
          <div class="events" data-upcoming="2" data-empty="events-none" hidden={upcoming.length === 0}>
            {upcoming.map((event, i) => (
              <div class="ev-item">
                <EventCard event={event} num={`2.${i + 1}`} />
              </div>
            ))}
          </div>
          <p class="ev-none" id="events-none" hidden={upcoming.length > 0}>
            No EBMA events are scheduled right now. <a href={joinHref}>Join EBMA</a> to hear about the next one first.
          </p>
        </>
      )
    }
    <p class="tcap">
      <b>Table 1.</b> Upcoming EBMA events; those still to be scheduled come last. See also <a href="/events/#past">past events</a> and the
      <a href="/events/#calendar">{SEASON.label} competition calendar</a>.
    </p>
  </Section>

  <Section
    id="exercise"
    num="3"
    title="A problem to *try*"
    dek="No sign-up required. Work it out, check your answer, then compare methods."
    note="A classic problem, written up for this site with a hint and a full solution. Five more are on Student Resources."
  >
    <a slot="actions" class="xref" href="/resources/#problems">More problems <span class="arr" aria-hidden="true">→</span></a>
    <div class="exercise">
      <Problem problem={featured} num="3.1" />
    </div>
  </Section>

  <Band m={3} label="Corollary 1.1" title="The next problem is *yours.*" text="Join the association, come to an event, or just say hello. We’ll take it from there.">
    <a class="btn" href={joinHref}>Join EBMA <span class="arr" aria-hidden="true">→</span></a>
    <a class="btn btn-quiet" href={contactHref}>Contact us</a>
  </Band>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
    padding: clamp(32px, 4.4vw, 64px) 0 clamp(56px, 6vw, 88px);
  }
  h1 {
    font-family: var(--serif-display);
    font-weight: 300;
    /* Capped by the viewport height too, so on laptop screens (1366×768, 1440×790) the Join button and
       the "Start here" links stay above the fold. The 46px floor keeps it scaling with browser zoom. */
    font-size: clamp(46px, min(6.9vw, 10.5vh), 106px);
    line-height: 0.96;
    letter-spacing: -0.028em;
    font-variation-settings: 'opsz' 72;
    margin-left: -0.04em;
  }
  h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
    letter-spacing: -0.02em;
    padding-right: 0.04em;
  }
  .proof {
    margin-top: clamp(26px, 3vw, 40px);
    max-width: 34em;
    font-size: clamp(18px, 1.55vw, 21px);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .proof em:first-child {
    color: var(--ink);
    font-style: italic;
    margin-right: 0.25em;
  }
  .cta-row {
    margin-top: clamp(28px, 3.2vw, 44px);
  }
  .hero-foot {
    margin-top: 36px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px 32px;
    align-items: start;
  }
  .next-up {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
    font-size: 17px;
  }
  .next-tag {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-accent);
    background: var(--ink);
    padding: 5px 8px 4px;
  }
  :global(:root[data-theme='dark']) .next-tag {
    color: var(--paper);
  }
  .next-up a {
    color: var(--ink);
  }
  /* Every upcoming event is in the markup, soonest first; only the first one shows. */
  .next-list > * + * {
    display: none;
  }
  .next-none {
    color: var(--ink-2);
  }

  /* Plain-English routes for the readers who arrive with one question. */
  .routes-h {
    font: 600 12px/1.2 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .routes ul {
    list-style: none;
  }
  /* A long route wraps like a sentence, and the arrow stays with its last word. */
  .routes a {
    display: inline-block;
    max-width: 100%;
    padding: 4px 0;
    font: 600 14.5px/1.5 var(--sans);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-2);
    text-underline-offset: 0.22em;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  .routes a:hover {
    color: var(--accent-text);
    text-decoration-color: var(--accent);
  }
  .routes .arr {
    display: inline-block;
    margin-left: 0.4em;
    text-decoration: none;
  }
  @media (pointer: coarse) {
    .routes a {
      padding: 11px 0;
    }
  }

  .abstract {
    padding-block: clamp(56px, 7vw, 100px) clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--rule-2);
  }
  .abstract-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .abstract h2 {
    text-align: center;
    font: 600 13px/1 var(--sans);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .abstract .lede {
    max-width: 38em;
    margin-inline: auto;
    font-size: clamp(21px, 2.1vw, 29px);
    line-height: 1.5;
    font-weight: 350;
    text-wrap: pretty;
    font-variation-settings: 'opsz' 36;
  }
  .abstract .lede::first-line {
    font-variant-caps: small-caps;
    letter-spacing: 0.03em;
  }
  .keywords {
    margin-top: 28px;
    text-align: center;
    font: 500 13px/1.6 var(--mono);
    color: var(--ink-3);
  }
  .keywords b {
    font-weight: 600;
    color: var(--ink);
  }

  .cells h3 i {
    font-weight: 400;
  }
  .cell .body {
    text-wrap: pretty;
  }
  .events {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  /* Every event on the list has passed (see prunePastEvents in src/data/events.ts). */
  .ev-none {
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 22px 0 24px;
    font-size: 19px;
    text-wrap: pretty;
  }
  .ev-none a {
    color: var(--ink);
  }
  .tcap {
    margin-top: 20px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .tcap b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .tcap a {
    color: var(--ink);
  }
  .exercise {
    max-width: 52rem;
  }
  /* Beside the figure the text column is narrow: stack "Next up" over the routes. */
  @media (min-width: 981px) and (max-width: 1180px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-fig {
      max-width: 560px;
    }
    .events {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 621px) and (max-width: 980px) {
    .hero-fig {
      max-width: none;
    }
    .events {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Two columns hold two cards. A third would sit alone in its row, and the section's
       "All upcoming events" link already leads to the full list. */
    .ev-item:nth-child(n + 3) {
      display: none;
    }
  }
  .ev-item {
    display: grid;
    min-width: 0;
  }
  /* Three cards at most; the section's "All upcoming events" link leads to the rest. */
  .ev-item:nth-child(n + 4) {
    display: none;
  }
  @media (max-width: 620px) {
    .hero-foot {
      grid-template-columns: 1fr;
    }
    /* Identical sample cards add length without information on a phone. */
    .sample-extra {
      display: none;
    }
  }
</style>

<script>
  // The page is built ahead of time: drop any listed event whose day has passed since.
  import { prunePastEvents } from '../data/events';
  prunePastEvents();
</script>
