---
/**
 * /get-involved/thanks/ — where the join form lands after a plain (no-JavaScript) submission.
 * functions/api/join.ts redirects here with 303 on success, and also (quietly) when a post trips a
 * spam trap, so the copy says the form was sent, never that it was stored or read.
 * Not indexed, not in the sitemap.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Band from '../../components/Band.astro';
import Ph from '../../components/Ph.astro';
import PhLink from '../../components/PhLink.astro';
import GetInvolvedHat from '../../components/GetInvolvedHat.astro';
---

<Base title="Thanks" description="Your form was sent to the East Bay Math Association. Here is what happens next." noindex>
  <PageHeader
    chapter={4}
    label="Q.E.D."
    note="(your form has arrived)"
    title="Thanks, we got *it.*"
    lede="<em>Proof.</em> You’re reading this page, so your form was sent. Nothing more to do for now: we’ll write back by email."
  >
    <Fragment slot="actions">
      <a class="btn" href="/resources/#problems">Try a problem while you wait <span class="arr" aria-hidden="true">→</span></a>
      <a class="xref" href="/get-involved/">Back to Get Involved <span class="arr" aria-hidden="true">→</span></a>
    </Fragment>
    {/* Closes the story Get Involved's Plate I starts: there the piece drops into its slot; here it is in place. */}
    <GetInvolvedHat slot="aside" placed />
  </PageHeader>

  <Section id="next" num="1" title="What happens *next*" dek="Three steps, and only the last one is yours." note="Didn’t mean to send it, or spotted a mistake? Email us and we’ll fix it.">
    <ol class="ty-steps">
      <li>
        <span class="ty-n" aria-hidden="true">1</span>
        <div>
          <h3>We read it</h3>
          <p>Someone on the EBMA team will read your form.</p>
        </div>
      </li>
      <li>
        <span class="ty-n" aria-hidden="true">2</span>
        <div>
          <h3>We reply by email</h3>
          <p>
            Usually within <span class="nowrap"><Ph id="get-involved.response-time" />.</span> Nothing yet? Check your spam folder, then write to <span class="nowrap"><PhLink id="org.email" />.</span>
          </p>
        </div>
      </li>
      <li>
        <span class="ty-n" aria-hidden="true">3</span>
        <div>
          <h3>You take it from there</h3>
          <p>Come to an event, try a problem, or just keep an eye on your inbox. Your form doesn’t register anyone for an event: each event listing will say how to sign up.</p>
        </div>
      </li>
    </ol>
    <p class="conclude"><span>That’s all. We’ll be in touch.</span><span class="qed" aria-hidden="true"></span></p>
  </Section>

  <Section id="meanwhile" num="2" title="In the *meantime*" dek="A few places to go from here.">
    <div class="cells">
      <article class="cell">
        <p class="label">Remark 2.1</p>
        <h3>Upcoming events</h3>
        <p class="body">Competitions and events open to East Bay students.</p>
        <a class="xref" href="/events/">Events &amp; Competitions <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <p class="label">Remark 2.2</p>
        <h3>Problems to try</h3>
        <p class="body">Classic problems with hints and full solutions, and study resources worth your time.</p>
        <a class="xref" href="/resources/">Student Resources <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="cell">
        <p class="label">Remark 2.3</p>
        <h3>Who we are</h3>
        <p class="body">What the East Bay Math Association is for, and the questions parents ask most.</p>
        <a class="xref" href="/about/">About EBMA <span class="arr" aria-hidden="true">→</span></a>
      </article>
    </div>
  </Section>

  <Band m={2} label="Corollary 2.1" title="Bring a *friend.*" text="Know a student who likes a hard problem? Send them our way. Events & Competitions is a good place to start.">
    <a class="btn" href="/events/">See upcoming events <span class="arr" aria-hidden="true">→</span></a>
    <a class="btn btn-quiet" href="/">Home</a>
  </Band>
</Base>

<style>
  .ty-steps {
    list-style: none;
    border-top: 2px solid var(--ink);
    max-width: 48rem;
  }
  .ty-steps li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--rule);
  }
  .ty-n {
    font: 200 54px/0.85 var(--serif);
    font-variation-settings: 'opsz' 72;
    color: var(--accent);
  }
  .ty-steps h3 {
    font: 400 clamp(24px, 2vw, 28px) / 1.15 var(--serif);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .ty-steps p {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 36em;
  }
  .ty-steps + .conclude {
    max-width: 48rem;
  }
  .cells h3 {
    font-size: clamp(25px, 2.1vw, 31px);
  }
</style>
