---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Band from '../../components/Band.astro';
import Ph from '../../components/Ph.astro';
import PhLink from '../../components/PhLink.astro';
import TeX from '../../components/Math.astro';
import JoinForm from '../../components/JoinForm.astro';
import GetInvolvedHat from '../../components/GetInvolvedHat.astro';

const contents = [
  { href: '#ways', num: '1', title: 'Ways in' },
  { href: '#join', num: '2', title: 'Join EBMA' },
  { href: '#contact', num: '3', title: 'Get in touch' },
];

const joinAs = (role: string) => `/get-involved/?role=${role}#join`;

interface Way {
  title: string;
  body: string;
  next: { href: string; text: string };
  alt: { href: string; text: string };
}
const ways: Way[] = [
  {
    title: 'Come to a\u00a0talk',
    body: 'Talks on mathematics at work, from swim races and stock options to aerospace engineering and data science. Anyone interested in math is welcome, and you don’t need to be a competition star to follow along.',
    next: { href: '/events/#upcoming', text: 'See upcoming talks' },
    alt: { href: '/events/#past', text: 'Past talks' },
  },
  {
    title: 'Come on a\u00a0trip',
    body: 'Trips to hackathons and events in fields next to mathematics, where the ideas get put to work. Join EBMA, and tell us in the form what you’d like to try.',
    next: { href: '#join', text: 'Join EBMA' },
    alt: { href: '/about/#mission', text: 'What EBMA does' },
  },
  {
    title: 'Help run\u00a0things',
    body: 'Coach, write problems, check answers, or help run an event on the day. If you can explain an idea patiently, we’d like to hear from you.',
    next: { href: joinAs('volunteer'), text: 'Offer to help' },
    alt: { href: '/about/#people', text: 'Meet the people' },
  },
];

const setBuilder =
  String.raw`\mathrm{EBMA} = \left\{\, x \;:\; \begin{aligned} &x \text{ is in the East Bay,} \\ &x \text{ likes a hard problem} \end{aligned} \,\right\}`;
---

<Base
  title="Get Involved"
  description="Join the East Bay Math Association: free, open to anyone interested in math, with one short form and every way to reach us."
>
  <PageHeader
    chapter={4}
    label="Correspondence"
    note="(in which you find your place in the pattern)"
    title="Get *involved*"
    lede="Anyone interested in math can join EBMA, and joining is free. Find your way in below, then fill in one short form, or write to us if you’d rather."
  >
    <div slot="lede" class="gi-head-more">
      <div class="cta-row rise" style="--d:380">
        <a class="btn" href="#join">Join EBMA <span class="arr" aria-hidden="true">↓</span></a>
        <a class="xref" href="#contact">Or just say hello <span class="arr" aria-hidden="true">↓</span></a>
      </div>
      <nav class="gi-toc rise" style="--d:480" aria-labelledby="gi-toc-h">
        <p class="gi-toc-h" id="gi-toc-h">In this chapter</p>
        <ol>
          {
            contents.map((c) => (
              <li>
                <a href={c.href}>
                  <span class="gi-toc-n">§{c.num}</span>
                  <span class="gi-toc-t">{c.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
    <GetInvolvedHat slot="aside" />
  </PageHeader>

  <Section
    id="ways"
    num="1"
    title="Ways *in*"
    dek="Three ways in, one association. Each case ends in one concrete next step."
    note="Not sure where to start? Join, and tell us what you’re after in the form."
  >
    <ol class="gi-ways">
      {
        ways.map((w, i) => (
          <li class="gi-way">
            <div class="gi-way-head">
              <p class="label">Case 1.{i + 1}</p>
              <h3>{w.title}</h3>
            </div>
            <p class="gi-way-body">{w.body}</p>
            <div class="gi-way-next">
              <p class="gi-next-label">Next step</p>
              <a class="xref" href={w.next.href}>
                {w.next.text} <span class="arr" aria-hidden="true">→</span>
              </a>
              <a class="gi-alt" href={w.alt.href}>{w.alt.text}</a>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="conclude gi-conclude">
      <span>None of the above? <a href="#contact">Say hello</a> and we’ll work it out together.</span><span class="qed" aria-hidden="true"></span>
    </p>
  </Section>

  {/*
    Every "Join EBMA" link on the site points at #join. On wide screens it lands on the §2 heading;
    in one column (phones, small tablets) it lands on the form itself, so the first field is on the
    first screen: see .gi-anchor below. The section keeps its own id for its heading.
  */}
  <Section
    id="sign-up"
    class="gi-join-sec"
    num="2"
    title="Join *EBMA*"
    dek="One short form for everyone. Tell us who you are and what you’re after, and a person will write back."
    note="Would you rather write an email? That works too: see §3, Get in touch."
  >
    <div class="gi-def">
      <div class="gi-def-math">
        <p class="thm-label"><span class="label">Definition 2.1</span><span class="note">(informal)</span></p>
        <TeX display tex={setBuilder} />
      </div>
      <p class="gi-def-plain">In plain English: if you’re in the East Bay and you like a hard problem, we’d like to meet you.</p>
    </div>
    <div class="gi-join">
      <div class="gi-form">
        <span id="join" class="gi-anchor"></span>
        <JoinForm />
      </div>
      <aside class="gi-before" aria-labelledby="gi-before-h">
        <h3 class="gi-before-h" id="gi-before-h">Good to know</h3>
        <dl class="gi-facts">
          <div>
            <dt>Cost</dt>
            <dd><Ph id="org.membership-cost" /></dd>
          </div>
          <div>
            <dt>Who can join</dt>
            <dd><Ph id="org.eligibility" /></dd>
          </div>
          {/* The data-use sentence itself sits once, under the consent box, where consent is given. */}
          <div class="gi-fact-privacy">
            <dt>Your privacy</dt>
            <dd>How we use what you send is right above the Send button, and in full in the <a href="/privacy/">Privacy Notice</a>.</dd>
          </div>
          <div>
            <dt>What happens next</dt>
            <dd>We reply by email, usually within <span class="nowrap"><Ph id="get-involved.response-time" />.</span></dd>
          </div>
        </dl>
      </aside>
    </div>
  </Section>

  <Section
    id="contact"
    num="3"
    title="Get in *touch*"
    dek="Write to us by email or with the form. A person reads every message."
    note="Asking about a particular event? Include its name so we can answer faster."
  >
    <dl class="gi-corr">
      <div class="gi-corr-row">
        <dt>Form</dt>
        <dd class="gi-corr-v"><a href="/get-involved/?role=other#join">Write to us with the form</a></dd>
        <dd class="gi-corr-n">Any question at all, from anyone. A person will write back.</dd>
      </div>
      <div class="gi-corr-row">
        <dt>Email</dt>
        <dd class="gi-corr-v"><PhLink id="org.email" /></dd>
        <dd class="gi-corr-n">Any question about EBMA, its talks, or its trips.</dd>
      </div>
      <div class="gi-corr-row">
        <dt>Replies</dt>
        <dd class="gi-corr-v">Usually within <Ph id="get-involved.response-time" /></dd>
        <dd class="gi-corr-n">For email and for the form alike.</dd>
      </div>
    </dl>
    <p class="tcap">
      <b>Table 1.</b> Where to reach the East Bay Math Association. What we do with your messages is in the <a href="/privacy/">Privacy Notice</a>.
    </p>
  </Section>

  <Band m={7} label="Corollary 3.1" title="The pattern needs *your* piece." text="Pick a way in above, or write to us. A person will reply.">
    <a class="btn" href="#join">Join EBMA <span class="arr" aria-hidden="true">↑</span></a>
    <a class="btn btn-quiet" href="/events/">See upcoming events</a>
  </Band>
</Base>

<style>
  /* ---------- page header extras: actions + "In this chapter" ---------- */
  .gi-head-more .cta-row {
    margin-top: clamp(26px, 3vw, 40px);
  }
  .gi-toc {
    margin-top: clamp(28px, 3vw, 40px);
    border-top: 2px solid var(--ink);
    padding-top: 12px;
    max-width: 40em;
  }
  .gi-toc-h {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .gi-toc ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
  }
  .gi-toc a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding: 11px 0 9px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-size: 18px;
    line-height: 1.3;
  }
  .gi-toc-n {
    flex: none;
    width: 2.4em;
    font: 500 12.5px/1 var(--mono);
    color: var(--accent-text);
  }
  .gi-toc a:hover .gi-toc-t {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ---------- §1 ways in ---------- */
  .gi-ways {
    list-style: none;
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule-2);
  }
  .gi-way {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) minmax(0, 14rem);
    gap: 14px clamp(24px, 3.4vw, 48px);
    align-items: start;
    padding: 28px 0 30px;
  }
  .gi-way + .gi-way {
    border-top: 1px solid var(--rule);
  }
  .gi-way h3 {
    margin-top: 10px;
    font: 400 clamp(26px, 2.3vw, 33px) / 1.08 var(--serif);
    letter-spacing: -0.015em;
  }
  .gi-way-body {
    font-size: 17.5px;
    color: var(--ink-2);
    max-width: 34em;
    padding-top: 22px;
  }
  .gi-way-next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .gi-next-label {
    font: 600 12px/1.2 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 2px;
  }
  .gi-alt {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font: 500 14.5px/1.3 var(--sans);
    color: var(--ink-2);
  }
  .gi-alt:hover {
    color: var(--accent-text);
  }
  @media (pointer: coarse) {
    .gi-alt {
      min-height: 44px;
    }
  }
  .gi-conclude a {
    color: var(--ink);
  }

  /* ---------- §2 join ---------- */
  .gi-join {
    display: grid;
    grid-template-columns: minmax(0, 20.5rem) minmax(0, 1fr);
    gap: clamp(36px, 4.5vw, 72px);
    align-items: start;
  }
  /* Source order is form, then facts, so keyboard focus meets the form first in every layout;
     on wide screens the grid draws the facts in the left column. */
  .gi-form {
    min-width: 0;
    grid-column: 2;
    grid-row: 1;
  }
  .gi-before {
    grid-column: 1;
    grid-row: 1;
  }
  /* The #join target. On wide screens it sits at the top of §2, so a Join link lands on the
     section heading; in one column it sits right above the form (see the 980px query below). */
  :global(.gi-join-sec) {
    position: relative;
  }
  .gi-anchor {
    position: absolute;
    top: 0;
    left: 0;
  }
  /* The epigraph: a set-builder "definition" of the association, then the plain version. */
  .gi-def {
    display: grid;
    grid-template-columns: auto minmax(0, 24em);
    gap: 12px clamp(32px, 5vw, 72px);
    align-items: center;
    padding-bottom: clamp(28px, 3vw, 40px);
    margin-bottom: clamp(36px, 4vw, 56px);
    border-bottom: 1px solid var(--rule-2);
  }
  .gi-def .thm-label {
    margin-bottom: 4px;
  }
  .gi-def :global(.math-display) {
    margin-left: -2px;
  }
  .gi-def :global(.katex-display) {
    text-align: left;
    margin: 0.3em 0 0;
  }
  .gi-def :global(.katex-display > .katex) {
    text-align: left;
    font-size: clamp(1.1em, 1.9vw, 1.45em);
  }
  .gi-def-plain {
    font-size: clamp(17px, 1.45vw, 19.5px);
    line-height: 1.5;
    color: var(--ink-2);
    font-style: italic;
    padding-left: clamp(20px, 2.4vw, 32px);
    border-left: 2px solid var(--accent);
  }
  .gi-before-h {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 14px 0 12px;
    border-top: 2px solid var(--ink);
  }
  .gi-facts > div {
    padding: 14px 0 16px;
    border-top: 1px solid var(--rule);
  }
  .gi-facts > div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .gi-facts dt,
  .gi-corr dt {
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .gi-facts dd {
    margin: 6px 0 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .gi-facts a {
    color: var(--ink);
  }
  @media (min-width: 1201px) and (min-height: 860px) {
    .gi-before {
      position: sticky;
      top: calc(var(--head-h) + 28px);
    }
  }

  /* ---------- §3 contact ---------- */
  .gi-corr {
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .gi-corr-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 6px clamp(20px, 3vw, 40px);
    align-items: baseline;
    padding: 18px 0;
  }
  .gi-corr-row + .gi-corr-row {
    border-top: 1px solid var(--rule);
  }
  .gi-corr dd {
    margin: 0;
    min-width: 0;
  }
  .gi-corr-v {
    font-size: 21px;
    line-height: 1.35;
  }
  .gi-corr-v a {
    color: var(--ink);
  }
  .gi-corr-v a:hover {
    color: var(--accent-text);
  }
  .gi-corr-n {
    font-size: 16px;
    line-height: 1.45;
    font-style: italic;
    color: var(--ink-2);
  }
  .gi-corr-n a {
    color: var(--ink);
  }
  .tcap {
    margin-top: 18px;
    font-size: 15.5px;
    color: var(--ink-2);
  }
  .tcap b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .tcap a {
    color: var(--ink);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .gi-way {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    }
    .gi-way-next {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px 20px;
    }
    .gi-next-label {
      width: 100%;
    }
  }
  /* Below 1200px the form needs the full width, and comes first: the facts follow it. */
  @media (max-width: 1200px) {
    .gi-join {
      grid-template-columns: minmax(0, 1fr);
    }
    .gi-form {
      max-width: 48rem;
    }
    .gi-form,
    .gi-before {
      grid-column: auto;
      grid-row: auto;
    }
    /* Here the facts follow the form, whose consent box ends with this same sentence. */
    .gi-fact-privacy {
      display: none;
    }
  }
  /* In one column the section heading, dek, note and Definition 2.1 stack up to a screen or more,
     so a Join link lands on the form itself, with the first field on the first screen. */
  @media (max-width: 980px) {
    .gi-anchor {
      position: static;
      display: block;
    }
  }
  @media (min-width: 621px) and (max-width: 1200px) {
    .gi-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
    }
    .gi-facts > div:last-child {
      border-bottom: 0;
    }
  }
  @media (max-width: 860px) {
    .gi-corr-row {
      grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    }
    .gi-corr-n {
      grid-column: 2;
    }
  }
  @media (max-width: 620px) {
    .gi-toc ol {
      grid-template-columns: minmax(0, 1fr);
    }
    .gi-way {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 0 26px;
    }
    .gi-way-body {
      padding-top: 0;
    }
    .gi-way-next {
      grid-column: 1;
    }
    .gi-corr-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .gi-corr-n {
      grid-column: 1;
    }
  }
  @media (max-width: 760px) {
    .gi-def {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 400px) {
    .gi-def :global(.katex-display > .katex) {
      font-size: 0.96em;
    }
  }
  @media (max-width: 359px) {
    .gi-def :global(.katex-display > .katex) {
      font-size: 0.84em;
    }
  }
</style>
