---
/**
 * The closing call to action ("Corollary n.1", n = the page's last section), an inverse band with
 * a times-table figure behind it. Each page passes its own multiplier `m`, so every page ends on a
 * different curve: home 3, about 6, events 4, resources 5, get-involved 7, thanks 2, privacy 9.
 *
 *   <Band m={4} label="Corollary 3.1" title="The next problem is *yours.*" text="…">
 *     <a class="btn" href="…">Join EBMA</a> …
 *   </Band>
 */
import { emph, noWidow } from '../lib/text';

interface Props {
  label: string;
  title: string;
  text?: string;
  id?: string;
  m?: number;
}
const { label, title, text, id = 'closing', m = 3 } = Astro.props;
---

<section class="band" aria-labelledby={`${id}-h`}>
  <canvas class="band-fig" data-band-figure data-reveal data-m={m} aria-hidden="true"></canvas>
  <div class="wrap band-grid">
    <div>
      <p class="label">{label}</p>
      <h2 id={`${id}-h`} set:html={noWidow(emph(title), 13)} />
      {text && <p>{noWidow(text)}</p>}
      <div class="cta-row"><slot /></div>
    </div>
  </div>
</section>

<style>
  .band-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .band-fig {
    position: absolute;
    right: -6vw;
    top: 50%;
    width: min(62vw, 760px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.9;
    pointer-events: none;
  }
  /* One column: the whole curve, small, as an emblem under the buttons (a corner of a large one
     read as stray texture and ran through the buttons). It lines up with the text's left edge. */
  @media (max-width: 980px) {
    .band {
      display: flex;
      flex-direction: column;
    }
    .band-grid {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }
    .band-fig {
      order: 1;
      position: static;
      align-self: flex-start;
      width: 156px;
      margin: 40px 0 -8px var(--gut);
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { mountBandFigure } from '../scripts/figures/times-table';
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-band-figure]').forEach(mountBandFigure);
</script>
