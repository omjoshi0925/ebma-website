---
/**
 * One person on the About page (§5). Pass a real `member` from src/data/team.ts, or `sample`
 * (1-based) for a sample card while that list is empty. `wide` sets a real member's card on its
 * side, portrait beside the text, for when one person has the section to themselves.
 *
 * Sample cards take the site's one quiet treatment for empty states (as EventCard's do): a dashed
 * outline instead of the portrait's crop marks, a small mono "Sample" tag and muted strokes. Only
 * the first sample carries placeholder chips (Role, Name); the others show blank ruled lines where
 * those will go, and are hidden from assistive technology.
 */
import Ph from './Ph.astro';
import type { TeamMember } from '../data/team';

interface Props {
  member?: TeamMember;
  sample?: number;
  wide?: boolean;
}
const { member, sample = 1, wide = false } = Astro.props;
const ghost = !member && sample > 1;
const initials = member
  ? member.name
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => w[0])
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
---

{
  member ? (
    <article class:list={['person', { wide }]}>
      <div class="portrait cropped">
        {member.photo ? (
          <img src={member.photo} alt="" loading="lazy" decoding="async" width="240" height="300" />
        ) : (
          <span class="initials" aria-hidden="true">
            {initials}
          </span>
        )}
      </div>
      <p class="role">{member.role}</p>
      <h3 class="name">{member.name}</h3>
      {member.bio && <p class="bio">{member.bio}</p>}
    </article>
  ) : (
    <article class="person sample" aria-hidden={ghost ? 'true' : undefined}>
      <p class="sample-tag">Sample</p>
      <div class="portrait">
        <svg class="sil" viewBox="0 0 120 110" aria-hidden="true" focusable="false">
          <circle cx="60" cy="38" r="22" />
          <path d="M10 110 V 100 C 10 78, 30 68, 60 68 C 90 68, 110 78, 110 100 V 110" />
        </svg>
      </div>
      {ghost ? (
        <div class="blank">
          <span />
          <span />
        </div>
      ) : (
        <>
          <p class="role">
            <Ph id="about.team" label="Role" />
          </p>
          <p class="name">
            <Ph id="about.team" label="Name" />
          </p>
        </>
      )}
    </article>
  )
}

<style>
  .person {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: var(--paper-2);
    --l: 12px;
    --w: 1px;
    margin-bottom: 8px;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    font: 300 clamp(44px, 5vw, 64px) / 1 var(--serif);
    letter-spacing: -0.02em;
    color: var(--ink-3);
  }
  .role {
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .name {
    font: 400 clamp(22px, 1.9vw, 26px) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .bio {
    font-size: 16.5px;
    color: var(--ink-2);
  }

  /* ---- one person on their own: the portrait beside the text ---- */
  .wide {
    display: grid;
    grid-template-columns: clamp(112px, 15vw, 176px) minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    column-gap: clamp(20px, 3vw, 40px);
    row-gap: 10px;
    align-items: start;
    max-width: 46rem;
  }
  .wide .portrait {
    grid-row: 1 / span 3;
    margin-bottom: 0;
  }
  .wide .role {
    padding-top: 4px;
  }
  .wide .name {
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .wide .bio {
    font-size: clamp(17px, 1.4vw, 19px);
    max-width: 30em;
    text-wrap: pretty;
  }

  /* ---- sample (empty-state) cards ---- */
  .sample {
    gap: 8px;
    padding: 12px 12px 14px;
    border: 1px dashed var(--rule-2);
  }
  .sample-tag {
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  /* A stand-in, not a photo frame: unframed and shorter than a portrait, so four don't fill a screen. */
  .sample .portrait {
    aspect-ratio: 4 / 3;
    margin-bottom: 4px;
    background: none;
  }
  .sil {
    align-self: end;
    width: 70%;
    height: auto;
    overflow: visible;
  }
  .sil circle,
  .sil path {
    fill: none;
    stroke: var(--rule-2);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 3 4;
  }
  .sample .role,
  .sample .name {
    line-height: 1;
  }
  .sample :global(.ph) {
    font-size: 13px;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  /* Later samples: blank ruled lines where the role and name will go. */
  .blank {
    display: grid;
    gap: 22px;
    padding: 12px 0 8px;
  }
  .blank span {
    border-bottom: 1px solid var(--rule-2);
    width: 45%;
  }
  .blank span + span {
    width: 70%;
  }

  @media (forced-colors: active) {
    .sil circle,
    .sil path {
      stroke: CanvasText;
    }
  }
</style>
