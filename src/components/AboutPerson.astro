---
/**
 * One person on the About page (§5). Pass a real `member` from src/data/team.ts, or `sample`
 * (1-based) for a sample card made of placeholder chips while that list is empty.
 */
import Ph from './Ph.astro';
import type { TeamMember } from '../data/team';

interface Props {
  member?: TeamMember;
  sample?: number;
}
const { member } = Astro.props;
const initials = member
  ? member.name
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => w[0])
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
---

<article class="person">
  <div class:list={['portrait cropped', { sample: !member }]}>
    {
      member?.photo ? (
        <img src={member.photo} alt="" loading="lazy" decoding="async" width="240" height="300" />
      ) : member ? (
        <span class="initials" aria-hidden="true">
          {initials}
        </span>
      ) : (
        <svg class="sil" viewBox="0 0 120 110" aria-hidden="true" focusable="false">
          <circle cx="60" cy="38" r="22" />
          <path d="M10 110 V 100 C 10 78, 30 68, 60 68 C 90 68, 110 78, 110 100 V 110" />
        </svg>
      )
    }
  </div>
  <p class="role">{member ? member.role : <Ph id="about.team" label="Role" />}</p>
  {member ? <h3 class="name">{member.name}</h3> : <p class="name"><Ph id="about.team" label="Name" /></p>}
  {
    member?.bio ? (
      <p class="bio">{member.bio}</p>
    ) : (
      !member && (
        <span class="skel" aria-hidden="true">
          <span />
          <span />
        </span>
      )
    )
  }
</article>

<style>
  .person {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: var(--paper-2);
    --l: 12px;
    --w: 1px;
    margin-bottom: 8px;
  }
  /* A sample card is a stand-in, not a photo frame: keep it square so four of them don't fill a screen. */
  .portrait.sample {
    aspect-ratio: 1;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    font: 300 clamp(44px, 5vw, 64px) / 1 var(--serif);
    letter-spacing: -0.02em;
    color: var(--ink-3);
  }
  .sil {
    align-self: end;
    width: 74%;
    height: auto;
    overflow: visible;
  }
  .sil circle,
  .sil path {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 3 4;
  }
  .role {
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .role :global(.ph) {
    font-size: 12px;
    letter-spacing: 0.01em;
  }
  .name {
    font: 400 clamp(22px, 1.9vw, 26px) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .name :global(.ph) {
    font-size: 15px;
  }
  .bio {
    font-size: 16.5px;
    color: var(--ink-2);
  }
  .skel {
    display: grid;
    gap: 9px;
    padding-top: 6px;
  }
  .skel span {
    height: 1px;
    background: var(--rule-2);
  }
  .skel span + span {
    width: 62%;
  }
</style>
