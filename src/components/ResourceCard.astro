---
/**
 * One entry in the Student Resources library, set like a numbered reference: "[12]" and the cost
 * tag, the name (a link to the official site), who runs it, what it is, level and timing, and
 * the domain the link goes to. Data: src/data/resources.ts (verified third-party facts only).
 *
 * It is the same entry as a competition on /events/ (CompetitionEntry.astro): an underlined name
 * with the shared ↗ (ResourceLink), the organizer in small sans, the facts under a dotted rule,
 * the domain last in mono. The cost tag matches too: FREE is a solid ink tag; PAID, FREE TIER
 * and VARIES are outlined.
 */
import ResourceLink from './ResourceLink.astro';
import { costLabel, domainOf, type Resource } from '../data/resources';

interface Props {
  resource: Resource;
  /** Reference number, e.g. 12 → "[12]". */
  num: number;
  headingLevel?: 'h3' | 'h4';
}
const { resource: r, num, headingLevel = 'h4' } = Astro.props;
const H = headingLevel;
const showOrg = r.org.trim().toLowerCase() !== r.name.trim().toLowerCase();
const domain = domainOf(r.url);
---

<article class="res" id={`lib-${r.id}`}>
  <p class="res-top">
    <span class="res-num" aria-hidden="true">[{num}]</span>
    <span class:list={['res-cost', `is-${r.cost}`]}><span class="sr-only">Cost: </span>{costLabel[r.cost]}</span>
  </p>
  <H class="res-name"><ResourceLink href={r.url}>{r.name}</ResourceLink></H>
  {showOrg && <p class="res-org">{r.org}</p>}
  <p class="res-desc">{r.description}</p>
  <dl class="res-facts">
    <div>
      <dt>Level</dt>
      <dd>{r.level}</dd>
    </div>
    {
      r.timing && (
        <div>
          <dt>When</dt>
          <dd>{r.timing}</dd>
        </div>
      )
    }
  </dl>
  <p class="res-dom">{domain}</p>
</article>

<style>
  .res {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 0 0;
    border-top: 1px solid var(--ink);
    min-width: 0;
  }
  .res-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 2px;
  }
  .res-num {
    font: 500 13px/1 var(--mono);
    color: var(--accent-text);
    letter-spacing: 0.02em;
  }
  /* Cost tag: the same tag as CompetitionEntry on /events/. */
  .res-cost {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 7px;
    border: 1px solid var(--rule-2);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .res-cost.is-free {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .res-name {
    font: 400 clamp(22px, 1.7vw, 24px) / 1.18 var(--serif);
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  /* An underlined name, as on /events/ (the ↗ is an inline-block, so the line stops at the word). */
  .res-name :global(a) {
    color: var(--ink);
    text-decoration-color: var(--rule-2);
    text-underline-offset: 0.16em;
  }
  .res-name :global(a:hover) {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  /* Who runs it, as on /events/. */
  .res-org {
    margin-top: -2px;
    font: 500 14.5px/1.4 var(--sans);
    color: var(--ink-3);
  }
  /* The domain the link goes to, last, on a line of its own (as on /events/). */
  .res-dom {
    margin-top: 2px;
    font: 500 12.5px/1.3 var(--mono);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .res-desc {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .res-facts {
    margin: 2px 0 0;
    padding-top: 10px;
    border-top: 1px dotted var(--rule-2);
    display: grid;
    gap: 6px;
  }
  .res-facts div {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
  }
  .res-facts dt {
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .res-facts dd {
    margin: 0;
    font: 500 14.5px/1.45 var(--sans);
    color: var(--ink-2);
  }

  /* Phones: one column of forty cards, so each one is set tighter. */
  @media (max-width: 620px) {
    .res {
      gap: 7px;
      padding-top: 12px;
    }
    .res-top {
      margin-bottom: 0;
    }
    .res-name {
      font-size: 21px;
    }
    .res-org {
      margin-top: -1px;
    }
    .res-desc {
      font-size: 16px;
    }
    .res-facts {
      margin-top: 3px;
      padding-top: 8px;
      gap: 4px;
    }
  }
</style>
