---
/**
 * Plate I on /sponsors/ (Fig. 1): a bump function and its support. In analysis the *support* of a
 * function is the closure of the set where it is not zero; this one, f(x) = exp(1 − 1/(1 − x²)) on
 * (−1, 1) and 0 elsewhere, is nonzero on (−1, 1), so its support is [−1, 1], drawn in vermilion.
 * Computed at build time; the curve draws itself in once when scrolled into view (the data-reveal
 * hook in scripts/site.ts), and is complete without JavaScript or with reduced motion.
 */
import Plate from './Plate.astro';

const W = 320;
const H = 194;
const X0 = 160; // x = 0
const SX = 62; // px per unit
const Y0 = 130; // y = 0
const SY = 92; // px per unit (f peaks at 1)
const f = (n: number) => n.toFixed(1);
const px = (x: number) => X0 + x * SX;
const py = (y: number) => Y0 - y * SY;
const bump = (x: number) => (Math.abs(x) < 1 ? Math.exp(1 - 1 / (1 - x * x)) : 0);

// The graph of f over [−2.4, 2.4]: flat, the bump, flat again.
const N = 120;
const bumpPts = Array.from({ length: N + 1 }, (_, i) => {
  const x = -1 + (2 * i) / N;
  return `${f(px(x))} ${f(py(bump(x)))}`;
});
const graph = `M${f(px(-2.4))} ${Y0} H${f(px(-1))} L${bumpPts.join(' L')} H${f(px(2.4))}`;
const area = `M${f(px(-1))} ${Y0} L${bumpPts.join(' L')} Z`;
const ticks = [-2, -1, 0, 1, 2];
const minus = (n: number) => (n < 0 ? `−${-n}` : String(n));
---

<Plate
  id="fig-support"
  class="support-plate"
  plate="Plate I"
  corner={`supp <span class="m" style="text-transform:none">f</span> = [−1, 1]`}
  fig="Fig. 1."
  caption={`In mathematics, the <em>support</em> of a function is where it is not zero, together with the edges of that region. This bump function <span class="m">f</span> is zero everywhere outside the interval from −1 to 1, its support, marked in&nbsp;red.`}
>
  <svg
    class="support-fig"
    data-reveal
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby="fig-support-t"
    aria-describedby="fig-support-d"
    focusable="false"
  >
    <title id="fig-support-t">Figure 1: a bump function and its support</title>
    <desc id="fig-support-d"
      >A smooth hump rises from the horizontal axis at −1, peaks above 0, and returns to the axis at 1. Everywhere else the graph lies flat on the axis. The interval from −1 to 1 is highlighted in red and labeled “supp f.”</desc
    >
    <path class="area" d={area} />
    <line class="axis" x1="6" y1={Y0} x2={W - 6} y2={Y0} />
    <path class="axis-head" d={`M${W - 13} ${Y0 - 4} L${W - 5} ${Y0} L${W - 13} ${Y0 + 4}`} />
    <text class="ax-lab" x={W - 6} y={Y0 - 10} text-anchor="end">x</text>
    {
      ticks.map((t) => (
        <g>
          <line class="tick" x1={px(t)} y1={Y0 - 3} x2={px(t)} y2={Y0 + 4} />
          <text class="tick-lab" x={px(t)} y={Y0 + 22} text-anchor="middle">
            {minus(t)}
          </text>
        </g>
      ))
    }
    <path class="graph" d={graph} pathLength="1" />
    <line class="supp" x1={px(-1)} y1={Y0} x2={px(1)} y2={Y0} />
    <circle class="hot" cx={px(-1)} cy={Y0} r="3.8" />
    <circle class="hot" cx={px(1)} cy={Y0} r="3.8" />
    <path class="bracket" d={`M${px(-1)} ${Y0 + 32} v6 H${px(1)} v-6`} />
    <text class="supp-lab" x={X0} y={Y0 + 58} text-anchor="middle">supp <tspan class="it">f</tspan></text>
    <text class="f-lab" x={px(0.62)} y={py(0.8)}><tspan class="it">y</tspan> = <tspan class="it">f</tspan>(<tspan class="it">x</tspan>)</text>
  </svg>
</Plate>

<style>
  .support-fig {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .area {
    fill: var(--accent-wash);
  }
  .axis,
  .tick {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .axis-head {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .graph {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .supp {
    stroke: var(--accent);
    stroke-width: 4;
    transform-box: fill-box;
    transform-origin: center;
  }
  .hot {
    fill: var(--accent);
  }
  .bracket {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  /* SVG text scales with the figure: sizes are in viewBox units (320 wide). The plate is never
     narrower than about 300px except on the smallest phones, where the labels grow to stay >= 12px. */
  .tick-lab {
    font: 500 13px var(--mono);
    fill: var(--ink-3);
  }
  .ax-lab,
  .f-lab {
    font: italic 16px var(--math);
    fill: var(--ink-2);
  }
  .supp-lab {
    font: 500 15px var(--serif);
    fill: var(--accent-text);
  }
  .it {
    font-family: var(--math);
    font-style: italic;
  }
  @media (max-width: 374px) {
    .tick-lab {
      font-size: 15.5px;
    }
    .supp-lab {
      font-size: 16px;
    }
  }
  .support-fig:global(.armed) .graph {
    stroke-dashoffset: 1;
  }
  .support-fig:global(.armed) .area,
  .support-fig:global(.armed) .hot,
  .support-fig:global(.armed) .bracket,
  .support-fig:global(.armed) .supp-lab {
    opacity: 0;
  }
  .support-fig:global(.armed) .supp {
    transform: scaleX(0);
  }
  .support-fig:global(.armed.in) .graph {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .support-fig:global(.armed.in) .area {
    opacity: 1;
    transition: opacity 0.8s 0.9s;
  }
  .support-fig:global(.armed.in) .supp {
    transform: none;
    transition: transform 0.7s var(--ease-out) 1.3s;
  }
  .support-fig:global(.armed.in) .hot,
  .support-fig:global(.armed.in) .bracket,
  .support-fig:global(.armed.in) .supp-lab {
    opacity: 1;
    transition: opacity 0.4s 1.8s;
  }
</style>
