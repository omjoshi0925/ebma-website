---
/**
 * Small line figures for the three definitions on the home page, drawn in ink with one
 * vermilion point: a staircase y = ⌊x⌋ (compete: you level up), the spiral r = θ (explore:
 * it keeps going), and the complete graph K₆ (belong: everyone connected to everyone).
 * They draw themselves in once when scrolled into view (scripts/site.ts reveal).
 */
interface Props {
  kind: 'compete' | 'explore' | 'belong';
}
const { kind } = Astro.props;
const W = 132;
const H = 84;
const f = (n: number) => n.toFixed(1);

let lines: string[] = [];
let dot: [number, number] = [0, 0];
let hollow: [number, number][] = [];
let caption = '';

if (kind === 'compete') {
  // y = floor(x) for x in [0, 4): four treads, closed dot at each left end, open at each right.
  const x0 = 14, y0 = 74, sx = 26, sy = 16;
  for (let k = 0; k < 4; k++) {
    lines.push(`M${f(x0 + k * sx)} ${f(y0 - k * sy)} H${f(x0 + (k + 1) * sx - 4)}`);
    if (k < 3) hollow.push([x0 + (k + 1) * sx, y0 - k * sy]);
  }
  dot = [x0 + 3 * sx, y0 - 3 * sy];
  caption = 'y = ⌊x⌋';
} else if (kind === 'explore') {
  // Archimedean spiral r = a·θ, θ from 0 to 3.2π.
  const cx = 64, cy = 44, a = 3.6;
  const pts: string[] = [];
  const end = 3.2 * Math.PI;
  for (let i = 0; i <= 160; i++) {
    const t = (end * i) / 160;
    pts.push(`${f(cx + a * t * Math.cos(t))} ${f(cy - a * t * Math.sin(t))}`);
  }
  lines.push(`M${pts.join(' L')}`);
  dot = [cx + a * end * Math.cos(end), cy - a * end * Math.sin(end)];
  caption = 'r = θ';
} else {
  // K6: six points on a circle, all fifteen edges.
  const cx = 66, cy = 42, r = 34;
  const P = Array.from({ length: 6 }, (_, i) => {
    const t = -Math.PI / 2 + (i * Math.PI) / 3;
    return [cx + r * Math.cos(t), cy + r * Math.sin(t)] as [number, number];
  });
  for (let i = 0; i < 6; i++) for (let j = i + 1; j < 6; j++) lines.push(`M${f(P[i][0])} ${f(P[i][1])} L${f(P[j][0])} ${f(P[j][1])}`);
  hollow = P.slice(1);
  dot = P[0];
  caption = 'K₆';
}
---

<svg class="deffig" data-reveal viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true" focusable="false">
  {lines.map((d) => <path d={d} pathLength="1" class="ln" />)}
  {hollow.map(([x, y]) => <circle cx={x} cy={y} r="2.6" class={kind === 'belong' ? 'pt' : 'open'} />)}
  <circle cx={dot[0]} cy={dot[1]} r="3.6" class="hot" />
  <text x={W - 2} y={H - 2} text-anchor="end" class="cap">{caption}</text>
</svg>

<style>
  .deffig {
    width: 132px;
    height: 84px;
    margin-bottom: 6px;
    overflow: visible;
  }
  .ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .open {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .pt {
    fill: var(--ink);
  }
  .hot {
    fill: var(--accent);
  }
  .cap {
    font: italic 13px var(--math);
    fill: var(--ink-3);
  }
  .deffig:global(.armed) .ln {
    stroke-dashoffset: 1;
  }
  .deffig:global(.armed) .hot {
    opacity: 0;
  }
  .deffig:global(.armed.in) .ln {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .deffig:global(.armed.in) .hot {
    opacity: 1;
    transition: opacity 0.4s 1.2s;
  }
</style>
