---
/**
 * §3 of the Student Resources page: the library of verified third-party resources, grouped by
 * category (3.1–3.4) and numbered like references ([1]–[n]).
 *
 * Without JavaScript it is simply the full grouped list. With JavaScript a filter bar appears
 * (src/scripts/resources-filter.ts): category buttons and a "Free only" toggle, all
 * aria-pressed, then a live count ("Showing 13 of 40 resources: Practice online"). The bar is
 * one row that scrolls sideways when it doesn't fit, and it stays under the site header while
 * you scroll through the library, so the filters are always one tap away (forty cards is a long
 * way on a phone).
 */
import ResourceCard from './ResourceCard.astro';
import { categories, resources, isFree } from '../data/resources';

let n = 0;
const groups = categories.map((c, i) => ({
  ...c,
  num: `3.${i + 1}`,
  items: resources.filter((r) => r.category === c.id).map((r) => ({ r, num: ++n })),
}));
const total = resources.length;
const freeTotal = resources.filter(isFree).length;
// "Two are free; the rest offer need-based aid." stays true to the data (every paid summer
// program in the verified list mentions need-based aid).
const summerFree = resources.filter((r) => r.category === 'summer' && isFree(r)).length;
const words = ['None', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
const summerFreeText = summerFree ? `${words[summerFree] ?? summerFree} ${summerFree === 1 ? 'is' : 'are'} free; the rest offer need-based aid.` : 'Most offer need-based aid.';

// Group headings: keep "&" with the next word and never break inside a hyphenated word, so
// "Summer & year-round programs" can't wrap as "Summer & year-" / "round programs".
const headingParts = (title: string) =>
  title
    .replace(/& /g, '&\u00a0')
    .split(/(\S*-\S*)/)
    .filter(Boolean);
---

<div class="lib" data-lib>
  <p class="lib-bar-h" id="lib-filter-h" data-lib-ui hidden>Filter the library</p>
  <div class="lib-bar" data-lib-bar hidden>
    <div class="lib-scroll" data-lib-scroll>
      <div class="lib-cats" role="group" aria-labelledby="lib-filter-h">
        <button type="button" class="lib-btn" aria-pressed="true" data-filter-cat="all">
          All <span class="lib-n" aria-hidden="true">{total}</span>
        </button>
        {
          groups.map((g) => (
            <button type="button" class="lib-btn" aria-pressed="false" data-filter-cat={g.id} data-label={g.short}>
              {g.short} <span class="lib-n" aria-hidden="true">{g.items.length}</span>
            </button>
          ))
        }
      </div>
      <span class="lib-sep" aria-hidden="true"></span>
      <button type="button" class="lib-btn lib-free" aria-pressed="false" data-filter-free>
        <span class="lib-box" aria-hidden="true"></span>Free only <span class="lib-n" aria-hidden="true">{freeTotal}</span>
      </button>
    </div>
  </div>
  <p class="lib-status" role="status" data-lib-status data-lib-ui hidden>Showing all {total} resources</p>

  {
    groups.map((g) => (
      <div class="lib-group" id={`lib-${g.id}`} data-group={g.id}>
        <div class="lib-group-head">
          <h3 id={`lib-${g.id}-h`}>
            <span class="lib-gnum">{g.num}</span>
            <span class="lib-gt">{headingParts(g.title).map((part) => (part.includes('-') ? <span class="nobr">{part}</span> : part))}</span>
          </h3>
          <p class="lib-intro">
            {g.id === 'practice' && <>Problem sets, lessons, videos, and tools. Everything in this group is free to use.</>}
            {g.id === 'local' && (
              <>
                Math circles, festivals, and other programs based in the Bay Area. Looking for contests? BAMO and the Berkeley and Stanford math
                tournaments are listed on the <a href="/events/#competitions">Events &amp; Competitions</a> page.
              </>
            )}
            {g.id === 'summer' && (
              <>
                Programs for motivated students, mostly of high school age. Each one admits by application, and deadlines fall months before the program
                starts. {summerFreeText}
              </>
            )}
            {g.id === 'reading' && <>Classics on problem solving, contest textbooks, and books about why mathematics is beautiful. Try your public library first.</>}
          </p>
        </div>
        <ul class="lib-grid" role="list">
          {g.items.map(({ r, num }) => (
            <li data-res data-cat={r.category} data-free={isFree(r) ? '1' : '0'}>
              <ResourceCard resource={r} num={num} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="lib-empty" data-lib-empty hidden>
    Nothing matches those filters. <button type="button" class="lib-reset" data-lib-reset>Show all resources</button>
  </p>
</div>

<style>
  /* Filtering hides cards above and below the reader; the script decides where the page lands
     (the top of the results), so the browser's scroll anchoring must not move it first. */
  .lib {
    overflow-anchor: none;
  }

  /* ---------- filter bar ---------- */
  .lib-bar-h {
    padding-top: 16px;
    border-top: 2px solid var(--ink);
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  /* One row of buttons that stays under the site header while the library scrolls past (the
     bar's containing block is the whole library, so it lets go after the last group). */
  .lib-bar {
    position: sticky;
    top: var(--head-h);
    z-index: 5;
    padding: 10px 0;
    background: var(--paper) var(--grain);
    border-bottom: 1px solid var(--rule-2);
  }
  /* Scrolls sideways when the row is wider than the column. The 6px of padding keeps focus rings
     inside the scroll box, where they would otherwise be clipped. */
  .lib-scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: -6px;
    padding: 6px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 6px;
    scrollbar-width: none;
  }
  .lib-scroll::-webkit-scrollbar {
    display: none;
  }
  /* A fade on the side that has more buttons to scroll to (set by the script). */
  .lib-bar[data-more='right'] .lib-scroll {
    mask-image: linear-gradient(to right, black calc(100% - 48px), transparent);
  }
  .lib-bar[data-more='left'] .lib-scroll {
    mask-image: linear-gradient(to left, black calc(100% - 48px), transparent);
  }
  .lib-bar[data-more='both'] .lib-scroll {
    mask-image: linear-gradient(to right, transparent, black 48px, black calc(100% - 48px), transparent);
  }
  .lib-cats {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .lib-sep {
    flex: none;
    height: 28px;
    margin: 0 6px;
    border-left: 1px solid var(--rule-2);
  }
  .lib-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    background: transparent;
    border: 1px solid var(--rule-2);
    border-radius: 0;
    color: var(--ink);
    font: 600 14.5px/1.1 var(--sans);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .lib-btn:hover {
    border-color: var(--ink);
  }
  .lib-n {
    font: 500 12.5px/1 var(--mono);
    color: var(--ink-3);
  }
  .lib-cats .lib-btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .lib-cats .lib-btn[aria-pressed='true'] .lib-n {
    color: var(--paper);
    opacity: 0.8;
  }
  /* "Free only" reads as a checkbox-style toggle, set apart from the category group. */
  .lib-box {
    width: 16px;
    height: 16px;
    flex: none;
    border: 1.5px solid var(--ink);
    display: grid;
    place-items: center;
  }
  .lib-free[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }
  .lib-free[aria-pressed='true'] .lib-box {
    background: var(--accent);
    border-color: var(--accent);
  }
  .lib-free[aria-pressed='true'] .lib-box::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid var(--on-accent);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }
  .lib-status {
    margin-top: 12px;
    font: 500 13px/1.4 var(--mono);
    color: var(--ink-3);
  }
  /* Short landscape screens: the header already takes a fifth of the height, so the bar scrolls
     away with the page instead of sticking. */
  @media (max-height: 540px) {
    .lib-bar {
      position: static;
    }
  }

  /* Windows High Contrast and other forced-color modes drop backgrounds, which is how a pressed
     button shows. Use the system highlight colors instead, so the current filter stays visible. */
  @media (forced-colors: active) {
    .lib-cats .lib-btn[aria-pressed='true'],
    .lib-free[aria-pressed='true'] {
      forced-color-adjust: none;
      background: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }
    .lib-cats .lib-btn[aria-pressed='true'] .lib-n,
    .lib-free[aria-pressed='true'] .lib-n {
      color: HighlightText;
      opacity: 1;
    }
    .lib-free[aria-pressed='true'] .lib-box {
      background: HighlightText;
      border-color: HighlightText;
    }
    .lib-free[aria-pressed='true'] .lib-box::after {
      border-color: Highlight;
    }
  }

  /* ---------- groups ---------- */
  .lib-group {
    padding-top: clamp(36px, 4vw, 56px);
  }
  /* In-page links to a group or a card land below the sticky bar, not under it. */
  :global(html.js) .lib-group,
  :global(html.js) .lib-grid :global(.res) {
    scroll-margin-top: 72px;
  }
  .lib-group-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 10px clamp(24px, 3vw, 48px);
    align-items: baseline;
    margin-bottom: 26px;
  }
  .lib-group h3 {
    font: 400 clamp(27px, 2.4vw, 34px) / 1.1 var(--serif);
    letter-spacing: -0.015em;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }
  .lib-gt {
    text-wrap: balance;
  }
  .nobr {
    white-space: nowrap;
  }
  .lib-gnum {
    font: 500 14px/1 var(--mono);
    color: var(--accent-text);
    letter-spacing: 0.02em;
    flex: none;
  }
  .lib-intro {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 36em;
  }
  .lib-intro a {
    color: var(--ink);
  }
  .lib-intro a:hover {
    color: var(--accent-text);
  }
  .lib-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr));
    gap: 36px clamp(24px, 2.4vw, 36px);
  }
  .lib-grid > li {
    min-width: 0;
  }
  .lib-empty {
    padding: 32px 0;
    font-size: 18px;
    color: var(--ink-2);
  }
  .lib-reset {
    margin-left: 0.4em;
    padding: 6px 0 3px;
    min-height: 32px;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-2);
    font: 600 15px/1.3 var(--sans);
    color: var(--ink);
    cursor: pointer;
  }
  .lib-reset:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  @media (max-width: 760px) {
    .lib-group-head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 20px;
    }
  }
  @media (max-width: 620px) {
    .lib-bar {
      padding: 8px 0;
    }
    .lib-group {
      padding-top: 32px;
    }
    .lib-intro {
      font-size: 16.5px;
    }
    .lib-grid {
      gap: 28px;
    }
  }
</style>

<script>
  import '../scripts/resources-filter';
</script>
