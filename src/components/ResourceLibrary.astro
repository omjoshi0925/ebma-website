---
/**
 * §3 of the Student Resources page: the library of verified third-party resources, grouped by
 * category (3.1–3.4) and numbered like references ([1]–[n]).
 *
 * Without JavaScript it is simply the full grouped list. With JavaScript a filter bar appears
 * (src/scripts/resources-filter.ts): a Type row (one category, or all), a Level row (middle
 * school, high school, or all levels, from each listing's `grades`) and a "Free only" toggle, all
 * aria-pressed, then a live count ("Showing 9 of 40 resources: Summer programs, middle school").
 * The rows wrap, so every filter is always on screen, at any width or zoom.
 *
 * While you scroll through the library the bar stays under the site header when it is short
 * enough (two rows on a wide screen). Otherwise the count line stays there instead, with a
 * "Change filters" button that goes back up to the bar. Links and cards in the library scroll
 * clear of whichever one is stuck (--lib-stick, set by the script).
 */
import ResourceCard from './ResourceCard.astro';
import { categories, resources, isFree, levelsOf, schoolLevels } from '../data/resources';

let n = 0;
const groups = categories.map((c, i) => ({
  ...c,
  num: `3.${i + 1}`,
  items: resources.filter((r) => r.category === c.id).map((r) => ({ r, num: ++n })),
}));
const total = resources.length;
const freeTotal = resources.filter(isFree).length;
const levels = schoolLevels.map((l) => ({ ...l, count: resources.filter((r) => levelsOf(r).includes(l.id)).length }));
// "Two are free; the rest offer need-based aid." stays true to the data (every paid summer
// program in the verified list mentions need-based aid).
const summerFree = resources.filter((r) => r.category === 'summer' && isFree(r)).length;
const words = ['None', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
const summerFreeText = summerFree ? `${words[summerFree] ?? summerFree} ${summerFree === 1 ? 'is' : 'are'} free; the rest offer need-based aid.` : 'Most offer need-based aid.';

// Group headings: keep "&" with the word before it, keep the last two words together, and never
// break inside a hyphenated word, so "Summer & year-round programs" wraps as
// "Summer &" / "year-round programs", never "Summer & year-" / "round programs" or a lone "programs".
const headingParts = (title: string) =>
  title
    .replace(/ & /g, '\u00a0& ')
    .replace(/ (\S+)$/, '\u00a0$1')
    .split(/(\S*-\S*)/)
    .filter(Boolean);
---

<div class="lib" data-lib>
  <p class="lib-bar-h" id="lib-filter-h" data-lib-ui hidden>Filter the library</p>
  <div class="lib-bar" role="group" aria-labelledby="lib-filter-h" data-lib-bar hidden>
    <div class="lib-row">
      <p class="lib-row-h" id="lib-type-h" aria-hidden="true">Type</p>
      <div class="lib-row-body">
        <div class="lib-opts" role="group" aria-labelledby="lib-type-h">
          <button type="button" class="lib-btn" aria-pressed="true" data-filter-cat="all">
            All types <span class="lib-n" aria-hidden="true">{total}</span>
          </button>
          {
            groups.map((g) => (
              <button type="button" class="lib-btn" aria-pressed="false" data-filter-cat={g.id} data-label={g.short}>
                {g.short} <span class="lib-n" aria-hidden="true">{g.items.length}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div class="lib-row">
      <p class="lib-row-h" id="lib-level-h" aria-hidden="true">Level</p>
      <div class="lib-row-body">
        <div class="lib-opts" role="group" aria-labelledby="lib-level-h">
          <button type="button" class="lib-btn" aria-pressed="true" data-filter-level="all">
            All levels <span class="lib-n" aria-hidden="true">{total}</span>
          </button>
          {
            levels.map((l) => (
              <button type="button" class="lib-btn" aria-pressed="false" data-filter-level={l.id} data-label={l.label.toLowerCase()}>
                {l.label} <span class="lib-n" aria-hidden="true">{l.count}</span>
              </button>
            ))
          }
        </div>
        <span class="lib-sep" aria-hidden="true"></span>
        <button type="button" class="lib-btn lib-free" aria-pressed="false" data-filter-free>
          <span class="lib-box" aria-hidden="true"></span>Free only <span class="lib-n" aria-hidden="true">{freeTotal}</span>
        </button>
      </div>
    </div>
  </div>
  <div class="lib-strip" data-lib-strip data-lib-ui hidden>
    <p class="lib-status" role="status" data-lib-status>Showing all {total} resources</p>
    <button type="button" class="lib-link lib-jump" data-lib-jump>Change filters <span class="arr" aria-hidden="true">↑</span></button>
  </div>

  {
    groups.map((g) => (
      <div class="lib-group" id={`lib-${g.id}`} data-group={g.id}>
        <div class="lib-group-head">
          <h3 id={`lib-${g.id}-h`}>
            <span class="lib-gnum">{g.num}</span>
            <span class="lib-gt">{headingParts(g.title).map((part) => (part.includes('-') ? <span class="nobr">{part}</span> : part))}</span>
          </h3>
          <p class="lib-intro">
            {g.id === 'practice' && <>Problem sets, lessons, videos, and tools. Everything in this group is free to use.</>}
            {g.id === 'local' && (
              <>
                Math circles (math clubs built around solving problems together), festivals, and other programs based in the Bay Area. Looking for
                contests? BAMO and the Berkeley and Stanford math tournaments are listed on the <a href="/events/#competitions">Events &amp; Competitions</a> page.
              </>
            )}
            {g.id === 'summer' && (
              <>
                Programs for motivated students, mostly of high school age. Each one admits by application, and deadlines fall months before the program
                starts. {summerFreeText}
              </>
            )}
            {g.id === 'reading' && <>Classics on problem solving, contest textbooks, and books about why mathematics is beautiful. Try your public library first.</>}
          </p>
        </div>
        <ul class="lib-grid" role="list">
          {g.items.map(({ r, num }) => (
            <li data-res data-cat={r.category} data-levels={levelsOf(r).join(' ')} data-free={isFree(r) ? '1' : '0'}>
              <ResourceCard resource={r} num={num} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="lib-empty" data-lib-empty hidden>
    Nothing matches those filters. <button type="button" class="lib-link lib-reset" data-lib-reset>Show all resources</button>
  </p>
</div>

<style>
  /* Filtering hides cards above and below the reader; the script decides where the page lands
     (the top of the results), so the browser's scroll anchoring must not move it first. */
  .lib {
    overflow-anchor: none;
  }

  /* ---------- filter bar ---------- */
  .lib-bar-h {
    padding-top: 16px;
    border-top: 2px solid var(--ink);
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  /* Two labeled rows, Type and Level (with Free only). Buttons wrap onto more lines rather than
     scroll sideways, so every filter is on screen at any width or zoom. */
  .lib-bar {
    container: libbar / inline-size;
    display: grid;
    gap: 8px;
    padding: 12px 0;
    background: var(--paper) var(--grain);
    border-bottom: 1px solid var(--rule-2);
  }
  .lib-row {
    display: grid;
    grid-template-columns: 4.6em minmax(0, 1fr);
    column-gap: 12px;
    align-items: start;
  }
  /* The row label sits level with the middle of the first line of buttons. */
  .lib-row-h {
    padding-top: calc((44px - 1em) / 2);
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .lib-row-body,
  .lib-opts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .lib-sep {
    flex: none;
    align-self: stretch;
    margin: 6px 6px;
    border-left: 1px solid var(--rule-2);
  }
  .lib-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    max-width: 100%;
    padding: 0 14px;
    background: transparent;
    border: 1px solid var(--rule-2);
    border-radius: 0;
    color: var(--ink);
    font: 600 14.5px/1.1 var(--sans);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }
  .lib-btn:hover {
    border-color: var(--ink);
  }
  .lib-n {
    font: 500 12.5px/1 var(--mono);
    color: var(--ink-3);
  }
  .lib-opts .lib-btn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .lib-opts .lib-btn[aria-pressed='true'] .lib-n {
    color: var(--paper);
    opacity: 0.8;
  }
  /* "Free only" reads as a checkbox-style toggle, set apart from the level group. */
  .lib-box {
    width: 16px;
    height: 16px;
    flex: none;
    border: 1.5px solid var(--ink);
    display: grid;
    place-items: center;
  }
  .lib-free[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }
  .lib-free[aria-pressed='true'] .lib-box {
    background: var(--accent);
    border-color: var(--accent);
  }
  .lib-free[aria-pressed='true'] .lib-box::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid var(--on-accent);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
  }

  /* The count line, and "Change filters" once the bar has scrolled away. */
  .lib-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
  }
  .lib-status {
    flex: 0 1 auto;
    min-width: 0;
    font: 500 13px/1.4 var(--mono);
    color: var(--ink-3);
  }
  .lib-jump {
    flex: none;
    display: none;
  }
  /* Text buttons: "Change filters ↑" and "Show all resources". */
  .lib-link {
    min-height: 32px;
    padding: 6px 0 3px;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-2);
    font: 600 15px/1.3 var(--sans);
    color: var(--ink);
    cursor: pointer;
  }
  .lib-link:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  @media (pointer: coarse) {
    .lib-link {
      min-height: 44px;
    }
  }

  /* What stays under the site header (the script sets data-stick): the whole bar when it is
     short, else the count line. On short screens (landscape phones, high zoom), neither. */
  .lib[data-stick='bar'] .lib-bar,
  .lib[data-stick='strip'] .lib-strip {
    position: sticky;
    top: var(--head-h);
    z-index: 5;
  }
  .lib[data-stick='strip'] .lib-strip {
    margin-top: 0;
    padding: 6px 0;
    background: var(--paper) var(--grain);
    border-bottom: 1px solid transparent;
  }
  .lib[data-stick='strip'][data-past] .lib-strip {
    border-bottom-color: var(--rule-2);
  }
  /* The button keeps its room while hidden, so the strip never changes height mid-scroll. */
  .lib[data-stick='strip'] .lib-jump {
    display: block;
    visibility: hidden;
  }
  .lib[data-stick='strip'][data-past] .lib-jump,
  .lib[data-stick='strip'] .lib-jump:focus {
    visibility: visible;
  }

  /* Windows High Contrast and other forced-color modes drop backgrounds, which is how a pressed
     button shows. Use the system highlight colors instead, so the current filter stays visible. */
  @media (forced-colors: active) {
    .lib-opts .lib-btn[aria-pressed='true'],
    .lib-free[aria-pressed='true'] {
      forced-color-adjust: none;
      background: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }
    .lib-opts .lib-btn[aria-pressed='true'] .lib-n,
    .lib-free[aria-pressed='true'] .lib-n {
      color: HighlightText;
      opacity: 1;
    }
    .lib-free[aria-pressed='true'] .lib-box {
      background: HighlightText;
      border-color: HighlightText;
    }
    .lib-free[aria-pressed='true'] .lib-box::after {
      border-color: Highlight;
    }
    .lib-sep {
      border-color: CanvasText;
    }
  }

  /* ---------- groups ---------- */
  .lib-group {
    padding-top: clamp(36px, 4vw, 56px);
  }
  /* In-page links to a group or a card, and keyboard focus moving back up the list, land below
     whatever is stuck under the header (the bar or the count line), never under it. The page's
     scroll-padding already clears the header. */
  :global(html.js) .lib-group,
  :global(html.js) .lib-grid :global(.res),
  :global(html.js) .lib-group :global(a),
  :global(html.js) .lib-empty button {
    scroll-margin-top: calc(var(--lib-stick, 0px) + 4px);
  }
  .lib-group-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 10px clamp(24px, 3vw, 48px);
    align-items: baseline;
    margin-bottom: 26px;
  }
  .lib-group h3 {
    font: 400 clamp(27px, 2.4vw, 34px) / 1.1 var(--serif);
    letter-spacing: -0.015em;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }
  .lib-gt {
    text-wrap: balance;
  }
  .nobr {
    white-space: nowrap;
  }
  .lib-gnum {
    font: 500 14px/1 var(--mono);
    color: var(--accent-text);
    letter-spacing: 0.02em;
    flex: none;
  }
  .lib-intro {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 36em;
  }
  .lib-intro a {
    color: var(--ink);
  }
  .lib-intro a:hover {
    color: var(--accent-text);
  }
  .lib-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 272px), 1fr));
    gap: 36px clamp(24px, 2.4vw, 36px);
  }
  .lib-grid > li {
    min-width: 0;
  }
  .lib-empty {
    padding: 32px 0;
    font-size: 18px;
    color: var(--ink-2);
  }
  .lib-reset {
    margin-left: 0.4em;
  }

  @media (max-width: 760px) {
    .lib-group-head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 20px;
    }
  }
  /* A column too narrow for the Level row on one line (phones, tablets in portrait, a desktop at
     200% zoom and more): each label goes above its buttons, which get the full width, and "Free
     only" drops the separator, since it would start a line. */
  @container libbar (max-width: 660px) {
    .lib-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 8px;
    }
    .lib-row + .lib-row {
      margin-top: 4px;
    }
    .lib-row-h {
      padding-top: 0;
    }
    .lib-sep {
      display: none;
    }
  }
  @media (max-width: 620px) {
    .lib-group {
      padding-top: 32px;
    }
    .lib-intro {
      font-size: 16.5px;
    }
    .lib-grid {
      gap: 28px;
    }
  }
</style>

<script>
  import '../scripts/resources-filter';
</script>
