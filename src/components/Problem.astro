---
/**
 * A practice problem: statement, an answer checker (for problems with a numeric answer),
 * and "Hint" / "Solution" disclosures. Math is typeset at build time.
 *
 * The checker needs JavaScript, so it is hidden without it (the solution still gives the answer).
 * It accepts a whole number, a fraction a/b, or a decimal, and compares by value, so "3/4",
 * "3 / 4", "6/8", and "0.75" all match 3/4: a decimal that is exactly the answer is right. A
 * rounded decimal for a fraction with no exact decimal (0.9995 for 2025/2026) is called close,
 * with a nudge to give the exact fraction. Spaces inside a number are not ignored, so "8 9" is
 * not read as 89.
 *
 * A right answer is marked with more than color: a ∎ fills in beside "Correct.", the answer box
 * takes a heavier ink edge, and a link to the next problem appears (the next one on the page, or
 * the full set on Student Resources when this is the only one).
 */
import 'katex/dist/katex.min.css';
import { renderTeX } from '../lib/tex';
import type { Problem } from '../data/problems';

interface Props {
  problem: Problem;
  num: string;
  headingLevel?: 'h3' | 'h4';
}
const { problem: p, num, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const isProof = p.answer === 'Proof';
const uid = `problem-${p.id}`;

if (!isProof && !/^\d+(\/\d+)?$/.test(p.answer)) {
  throw new Error(`Problem "${p.id}": the answer must be a whole number, a fraction a/b, or 'Proof' (got "${p.answer}").`);
}
// Phone keypads have no "/", so only whole-number answers get the numeric keypad. The format
// hint names the kind of answer with no digits in it, so it can never give the answer away.
const isFraction = p.answer.includes('/');
const placeholder = isFraction ? 'a fraction, like a/b' : 'a whole number';
---

<article class="problem" id={uid} aria-labelledby={`${uid}-h`}>
  <p class="problem-top">
    <span class="label">{isProof ? 'Proposition' : 'Exercise'} {num}</span>
    <span class="meta">{p.topic} · {p.level}</span>
  </p>
  <H class="problem-title" id={`${uid}-h`}>{p.title}</H>
  <div class="statement" set:html={renderTeX(p.statement)} />

  {
    !isProof && (
      <form class="check" data-answer={p.answer} novalidate>
        <label for={`${uid}-answer`}>
          Your answer<span class="sr-only"> to “{p.title}”</span>
        </label>
        <div class="check-row">
          <input
            id={`${uid}-answer`}
            name="answer"
            type="text"
            inputmode={isFraction ? 'text' : 'numeric'}
            enterkeyhint="done"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder={placeholder}
            aria-describedby={`${uid}-out`}
          />
          <button type="submit" class="btn btn-quiet">Check</button>
        </div>
        <p class="check-out" id={`${uid}-out`} role="status" />
        <p class="check-next" hidden>
          <a class="xref" href="/resources/#problems">
            <span class="check-next-t">More problems to try</span> <span class="arr" aria-hidden="true">→</span>
          </a>
        </p>
      </form>
    )
  }

  <details class="disclose">
    <summary>Hint</summary>
    <div class="disclose-body" set:html={renderTeX(p.hint)} />
  </details>
  <details class="disclose">
    <summary>{isProof ? 'Proof' : 'Solution'}</summary>
    <div class="disclose-body">
      <Fragment set:html={renderTeX(p.solution)} />
      <p class="end"><span class="qed" aria-label="End of solution" role="img"></span></p>
    </div>
  </details>
</article>

<style>
  .problem {
    border-top: 3px solid var(--ink);
    padding-top: 16px;
    min-width: 0;
  }
  .problem-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 14px;
  }
  .problem-title {
    font: 400 clamp(26px, 2.4vw, 32px) / 1.12 var(--serif);
    letter-spacing: -0.012em;
    margin-bottom: 14px;
  }
  .statement {
    font-size: 19px;
    line-height: 1.6;
    max-width: 36em;
  }
  .statement :global(p + p) {
    margin-top: 0.8em;
  }
  .statement + .disclose {
    margin-top: 24px;
  }
  /* Display math: a little smaller on narrow phones so it fits, and it scrolls inside its own
     box (never the page) if a reader's font settings still make it too wide; the script makes an
     overflowing box focusable so it can be scrolled from the keyboard. Inline math takes the
     site-wide KaTeX size (global.css). */
  .problem :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 0;
  }
  @media (max-width: 480px) {
    .problem :global(.katex-display > .katex) {
      font-size: 1em;
    }
  }
  @media (max-width: 400px) {
    .problem :global(.katex-display > .katex) {
      font-size: 0.9em;
    }
  }
  @media (max-width: 340px) {
    .problem :global(.katex-display > .katex) {
      font-size: 0.8em;
    }
  }
  .check {
    margin: 22px 0 18px;
    max-width: 30em;
  }
  /* The checker runs on JavaScript; without it, the solution is the check. */
  :global(html:not(.js)) .check {
    display: none;
  }
  :global(html:not(.js)) .check + .disclose {
    margin-top: 24px;
  }
  .check label {
    display: block;
    font: 600 12px/1.2 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .check-row {
    display: flex;
    gap: 10px;
  }
  .check input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    background: var(--paper);
    /* --ink-3 keeps the field's edge at 3:1 or better against the page (WCAG 1.4.11). */
    border: 1.5px solid var(--ink-3);
    border-radius: 0;
    font: 500 17px/1 var(--mono);
    color: var(--ink);
  }
  .check input::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }
  .check input:hover {
    border-color: var(--ink-2);
  }
  .check input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
    border-color: var(--ink);
  }
  .check input[aria-invalid='true'] {
    border-color: var(--accent-text);
  }
  .check .btn {
    flex: none;
  }
  .check-out {
    min-height: 1.5em;
    margin-top: 10px;
    font: 500 15px/1.4 var(--sans);
  }
  .check-out:global(.is-right) {
    color: var(--ink);
    font-weight: 600;
    /* hang the tombstone: a second line starts under the text, not under the mark */
    padding-left: 1.17em;
    text-indent: -1.17em;
  }
  /* The tombstone that ends a proof, filling in: the problem is done. */
  .check-out:global(.is-right)::before {
    content: '';
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.55em;
    vertical-align: -0.02em;
    border: 1.5px solid var(--accent);
    background: var(--accent);
    animation: qed-fill 0.6s 0.1s both;
  }
  @keyframes qed-fill {
    from {
      background-color: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .check-out:global(.is-right)::before {
      animation: none;
    }
  }
  .check-out:global(.is-wrong) {
    color: var(--accent-text);
  }
  .check:global(.is-solved) input {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .check-next {
    margin-top: 2px;
  }
  @media (forced-colors: active) {
    .check-out:global(.is-right)::before {
      forced-color-adjust: none;
      background: CanvasText;
      border-color: CanvasText;
    }
  }
  .disclose-body :global(p + p) {
    margin-top: 0.8em;
  }
  .end {
    text-align: right;
  }
</style>

<script>
  /**
   * Answer checking, by value. Accepted forms: a whole number ("89", " 89 ", "+89", "089"), a
   * decimal ("0.75", ".75", "89.0"), or a fraction ("3/4", "3 / 4", "6/8", "−3/4"). Spaces are
   * allowed only at the ends and around "/", so "8 9" is not read as 89.
   */
  interface Parsed {
    value: number;
    /** Digits typed after the decimal point, or null when the input was not a decimal. */
    places: number | null;
  }
  const parse = (raw: string): Parsed | null => {
    const s = raw
      .trim()
      .replace(/[−–]/g, '-')
      .replace(/[⁄∕]/g, '/')
      .replace(/\s*\/\s*/, '/');
    const frac = /^([+-]?\d+)\/(\d+)$/.exec(s);
    if (frac) {
      const den = Number(frac[2]);
      return den === 0 ? null : { value: Number(frac[1]) / den, places: null };
    }
    const dec = /^[+-]?\d*(?:\.(\d*))?$/.exec(s);
    if (!dec || !/\d/.test(s)) return null;
    return { value: Number(s), places: dec[1] === undefined ? null : dec[1].length };
  };

  document.querySelectorAll<HTMLFormElement>('form.check').forEach((form) => {
    const input = form.querySelector('input')!;
    const out = form.querySelector<HTMLElement>('.check-out')!;
    const next = form.querySelector<HTMLElement>('.check-next');
    const expected = parse(form.dataset.answer ?? '')?.value ?? null;

    // After a right answer, point to the next problem on this page if there is one; otherwise
    // the link keeps its default, the full set on Student Resources.
    const problem = form.closest('.problem');
    const all = [...document.querySelectorAll<HTMLElement>('article.problem')];
    const following = problem ? all[all.indexOf(problem as HTMLElement) + 1] : undefined;
    const link = next?.querySelector('a');
    const title = following?.querySelector('.problem-title')?.textContent?.trim();
    if (following && link && title) {
      link.href = `#${following.id}`;
      link.querySelector('.check-next-t')!.textContent = `Next problem: ${title}`;
    }

    const say = (text: string, right: boolean, invalid = false) => {
      out.textContent = text;
      out.classList.toggle('is-right', right);
      out.classList.toggle('is-wrong', !right);
      form.classList.toggle('is-solved', right);
      if (next) next.hidden = !right;
      if (invalid) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input.value.trim()) return say('Type an answer first.', false, true);
      const got = parse(input.value);
      if (!got) return say('That doesn’t look like a number. Enter a whole number, a fraction like a/b, or a decimal.', false, true);
      if (expected === null) return;
      const off = Math.abs(got.value - expected);
      if (off < 1e-12) return say('Correct. Now open the solution and compare your method.', true);
      // A decimal that is the answer correctly rounded (to 2+ places) is right in spirit, not exact.
      if (got.places !== null && got.places >= 2 && off <= 0.5 * 10 ** -got.places + 1e-12) {
        return say('Close, but that’s a rounded decimal. Give the exact answer as a fraction.', false);
      }
      say('Not quite. Open the hint, then try again.', false);
    });

    // Feedback belongs to the answer it was given for: editing the box clears it.
    input.addEventListener('input', () => {
      if (out.textContent) {
        out.textContent = '';
        out.classList.remove('is-right', 'is-wrong');
        form.classList.remove('is-solved');
        if (next) next.hidden = true;
      }
      input.removeAttribute('aria-invalid');
    });
  });

  // A display equation that is wider than its box scrolls sideways; make that box focusable (and
  // name it) so it can be scrolled from the keyboard. Checked again whenever its size changes,
  // e.g. when a Hint or Solution opens or the window is resized.
  if ('ResizeObserver' in window) {
    const fit = new ResizeObserver((entries) => {
      for (const { target } of entries) {
        const box = target as HTMLElement;
        const scrolls = box.clientWidth > 0 && box.scrollWidth > box.clientWidth + 1;
        if (scrolls && !box.hasAttribute('tabindex')) {
          box.tabIndex = 0;
          box.setAttribute('role', 'group');
          box.setAttribute('aria-label', 'Equation (scrolls sideways)');
        } else if (!scrolls && box.hasAttribute('tabindex')) {
          box.removeAttribute('tabindex');
          box.removeAttribute('role');
          box.removeAttribute('aria-label');
        }
      }
    });
    document.querySelectorAll('.problem .katex-display').forEach((el) => fit.observe(el));
  }
</script>
