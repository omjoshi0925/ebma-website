---
/**
 * Table 2 on /events/: the competition calendar as a table, in three groups: dates posted by the
 * organizers (soonest first), the usual timing where a 2027 date is not posted yet, and contests
 * with no date listed. Carries the same data as Fig. 1 (CompetitionTimeline.astro).
 *
 * Each name links to the contest's entry in §4 (#c-<id>: format, cost, who can enter, and the
 * official site). Rows carry data-end (the last day, or the end of the usual window) so that
 * scripts/events-calendar.ts can mark them "Passed" between deploys, and data-cid so that the
 * grade finder (scripts/events-grades.ts) can hide the contests a grade can't enter; its note for
 * the chosen grade goes in the empty [data-fit] spans.
 *
 * On phones the Where and Who columns are folded into the Competition cell as a visual copy
 * (.ct-narrow, aria-hidden), while the real cells stay in the table, visually hidden, so screen
 * readers keep all four columns with their headers.
 */
import { competitions, upcomingDates, formatRange, SEASON } from '../data/competitions';

const dated = upcomingDates();
const typical = competitions.filter((c) => c.typically && !c.dates.length);
const undated = competitions.filter((c) => !c.dates.length && !c.typically);
---

<div class="table-wrap ct-wrap" data-calendar-root>
  <table class="table ct" data-gf-table>
    <caption>
      <b>Table 2.</b> The {SEASON.label} competition calendar: the dates in Fig. 1, with where each contest happens and who can enter. Each name links
      to that contest’s entry in §4, which links to its official site.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="ct-date">Date</th>
        <th scope="col">Competition</th>
        <th scope="col" class="ct-wide"><span class="ct-in">Where</span></th>
        <th scope="col" class="ct-wide"><span class="ct-in">Who can enter</span></th>
      </tr>
    </thead>
    {
      dated.length > 0 && (
        <tbody>
          <tr class="ct-group">
            <th scope="rowgroup" colspan="4">Dates posted by the organizers</th>
          </tr>
          {dated.map((d) => (
            <tr data-end={d.end ?? d.start} data-cid={d.competition.id}>
              <td class="ct-date">
                <span class="ct-when">{formatRange(d.start, d.end, { weekday: !d.end, year: true })}</span>
                {d.kind === 'window' && <span class="ct-kind">Window</span>}
                {d.kind === 'deadline' && <span class="ct-kind">Deadline</span>}
              </td>
              <th scope="row" class="ct-name">
                <a href={`#c-${d.competition.id}`}>{d.label}</a>
                {d.note && <span class="ct-note">{d.note}</span>}
                <span class="ct-narrow" aria-hidden="true">
                  {d.where && <span>{d.where}</span>}
                  <span>{d.competition.levelShort}</span>
                  <span class="ct-fit" data-fit hidden />
                </span>
              </th>
              <td class="ct-wide">
                <span class="ct-in">{d.where ?? '—'}</span>
              </td>
              <td class="ct-wide">
                <span class="ct-in">
                  {d.competition.levelShort}
                  <span class="ct-fit" data-fit hidden />
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      )
    }
    <tbody>
      <tr class="ct-group">
        <th scope="rowgroup" colspan="4">Usual timing, 2027 date not posted yet</th>
      </tr>
      {
        typical.map((c) => (
          <tr data-end={c.typicalWindow?.end} data-cid={c.id}>
            <td class="ct-date">
              <span class="ct-when ct-typ">{c.typicalWindow ? `Typically ${c.typicalWindow.label}` : 'Not posted'}</span>
            </td>
            <th scope="row" class="ct-name">
              <a href={`#c-${c.id}`}>{c.name}</a>
              <span class="ct-note">{c.typically}</span>
              <span class="ct-narrow" aria-hidden="true">
                {c.venue && <span>{c.venue}</span>}
                <span>{c.levelShort}</span>
                <span class="ct-fit" data-fit hidden />
              </span>
            </th>
            <td class="ct-wide">
              <span class="ct-in">{c.venue ?? '—'}</span>
            </td>
            <td class="ct-wide">
              <span class="ct-in">
                {c.levelShort}
                <span class="ct-fit" data-fit hidden />
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
    <tbody>
      <tr class="ct-group">
        <th scope="rowgroup" colspan="4">No date listed here yet</th>
      </tr>
      {
        undated.map((c) => (
          <tr data-cid={c.id}>
            <td class="ct-date">
              <span class="ct-when ct-typ">Not posted</span>
            </td>
            <th scope="row" class="ct-name">
              <a href={`#c-${c.id}`}>{c.name}</a>
              {c.pending && <span class="ct-note">{c.pending}</span>}
              <span class="ct-narrow" aria-hidden="true">
                {c.venue && <span>{c.venue}</span>}
                <span>{c.levelShort}</span>
                <span class="ct-fit" data-fit hidden />
              </span>
            </th>
            <td class="ct-wide">
              <span class="ct-in">{c.venue ?? '—'}</span>
            </td>
            <td class="ct-wide">
              <span class="ct-in">
                {c.levelShort}
                <span class="ct-fit" data-fit hidden />
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ct-wrap {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .ct {
    font-size: 16.5px;
  }
  .ct caption {
    caption-side: bottom;
    text-align: left;
    padding-top: 16px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ct caption b {
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-right: 0.4em;
  }
  .ct th,
  .ct td {
    padding: 13px 20px 13px 0;
  }
  .ct th:last-child,
  .ct td:last-child {
    padding-right: 0;
  }
  .ct-date {
    width: 13.5em;
  }
  .ct-when {
    font: 500 14px/1.4 var(--mono);
    color: var(--ink);
    white-space: nowrap;
  }
  .ct-typ {
    font-style: italic;
    color: var(--ink-3);
    white-space: normal;
  }
  .ct-kind,
  .ct :global(.ct-passed) {
    display: inline-block;
    margin-left: 8px;
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    vertical-align: 1px;
  }
  /* The kind tag (WINDOW, DEADLINE) always sits on its own line under the date, at every width. */
  .ct-kind {
    display: block;
    margin: 6px 0 0;
  }
  .ct :global(.ct-passed) {
    color: var(--ink);
    border: 1px solid var(--rule-2);
    padding: 3px 5px 2px;
  }
  .ct tbody th.ct-name {
    font: 400 18px/1.35 var(--serif);
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0;
  }
  .ct-name a {
    color: var(--ink);
    text-decoration-color: var(--rule-2);
    text-underline-offset: 0.16em;
  }
  .ct-name a:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .ct-note {
    display: block;
    margin-top: 3px;
    font: italic 15.5px/1.4 var(--serif);
    color: var(--ink-3);
  }
  /* The grade finder's note for this contest ("For grade 11: AMC 12."). */
  .ct-fit {
    display: block;
    margin-top: 4px;
    font: 600 14px/1.4 var(--sans);
    color: var(--accent-text);
  }
  .ct-narrow {
    display: none;
  }
  .ct td.ct-wide {
    color: var(--ink-2);
  }
  .ct-group th {
    padding: 22px 0 8px;
    font: 600 12px/1.3 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    border-bottom: 1px solid var(--rule-2);
  }
  .ct tbody:first-of-type .ct-group th {
    padding-top: 14px;
  }
  .ct tbody tr:last-child > * {
    border-bottom: 1px solid var(--rule);
  }
  .ct tbody:last-of-type tr:last-child > *,
  .ct tr:global(.ct-end) > * {
    border-bottom: 0;
  }
  .ct tr:global(.is-past) > * {
    color: var(--ink-3);
  }
  .ct tr:global(.is-past) .ct-name a {
    color: var(--ink-3);
  }

  @media (max-width: 700px) {
    /* Where and Who: out of sight but still in the table for screen readers (the visible copy is
       .ct-narrow). The cells collapse to nothing; their text is clipped like .sr-only. */
    .ct .ct-wide {
      width: 0;
      padding: 0;
    }
    .ct-in {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ct td.ct-date {
      padding-right: 14px;
    }
    .ct th.ct-name {
      padding-right: 0;
    }
    .ct-date {
      width: 7.5em;
    }
    .ct-when {
      white-space: normal;
      font-size: 13.5px;
    }
    .ct-kind {
      display: block;
      margin: 6px 0 0;
    }
    .ct tbody th.ct-name {
      font-size: 17px;
    }
    .ct-narrow {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-top: 6px;
      font: 500 14px/1.4 var(--sans);
      color: var(--ink-2);
    }
    .ct-narrow .ct-fit {
      margin-top: 2px;
      font-weight: 600;
    }
  }
  /* No reading text under 16px on a phone (the italic notes read smaller than their size). */
  @media (max-width: 620px) {
    .ct caption,
    .ct-note {
      font-size: 16.5px;
    }
  }
  @media print {
    .ct tr {
      break-inside: avoid;
    }
  }
</style>
