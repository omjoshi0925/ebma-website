---
/**
 * The sponsor/partner logo wall: real logos from src/data/sponsors.ts in crop-marked tiles, ending
 * with a "Your organization here" call to action. The call-to-action tile is a small piece of the
 * closing band, so it uses the band tokens and matches the band in both themes. In a page body it
 * leads to /sponsors/ (what sponsoring means); the Sponsors page passes its own form link.
 *
 * While the list is empty the wall shows sample tiles in the site's sample style (.sample in
 * global.css): dashed and quiet. Only the first carries the "Sample" tag and a chip; the rest are
 * empty frames (hidden from screen readers), so the wall never suggests a count of sponsors.
 */
import Ph from './Ph.astro';
import { sponsors, SAMPLE_SLOTS } from '../data/sponsors';

interface Props {
  ctaHref?: string;
  /** On phones, show one sample tile and the call to action instead of the whole empty wall. */
  compact?: boolean;
}
const { ctaHref = '/sponsors/', compact = false } = Astro.props;
---

<ul class:list={['slots', { 'slots-compact': compact }]} aria-label="Sponsors and partners">
  {
    sponsors.length
      ? sponsors.map((s) => (
          <li class="slot cropped">
            {s.href ? (
              <a href={s.href} rel="noopener">
                <img src={s.logo} alt={s.name} loading="lazy" />
              </a>
            ) : (
              <img src={s.logo} alt={s.name} loading="lazy" />
            )}
          </li>
        ))
      : Array.from({ length: SAMPLE_SLOTS }, (_, i) =>
          i === 0 ? (
            <li class="slot sample">
              <p class="sample-tag">Sample</p>
              <Ph id="sponsors.list" label="Logos" />
            </li>
          ) : (
            <li class="slot sample" aria-hidden="true" />
          ),
        )
  }
  <li class="slot-li">
    <a class="slot slot-cta" href={ctaHref}>
      <strong>Your organization here.</strong>
      <span>Become a sponsor <span class="arr" aria-hidden="true">→</span></span>
    </a>
  </li>
</ul>

<style>
  .slots {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .slot {
    position: relative;
    min-width: 0;
    aspect-ratio: 3 / 2;
    /* Every tile in a row as tall as the tallest (the call to action can run to three lines), and
       no wider than its column (a stretched tile with an aspect ratio would otherwise widen). */
    place-self: stretch;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 16px;
    background-color: color-mix(in srgb, var(--ink) 3%, transparent);
    --c: var(--ink-3);
    --l: 12px;
    --w: 1px;
  }
  .slot.sample {
    background-color: transparent;
  }
  .sample-tag {
    position: absolute;
    top: 10px;
    left: 12px;
  }
  .slot img {
    max-height: 64px;
    width: auto;
    object-fit: contain;
  }
  .slot :global(.ph) {
    font-size: 12px;
  }
  .slot-li {
    min-width: 0;
  }
  .slot-cta {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    min-height: 120px;
    background: var(--band-bg);
    color: var(--band-fg);
    border: 1px solid var(--band-rule);
    text-decoration: none;
    align-content: center;
    gap: 10px;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .slot-cta span {
    color: var(--band-accent);
  }
  .slot-cta:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .slot-cta:hover span {
    color: inherit;
  }
  .slot-cta strong {
    font: 400 23px/1.15 var(--serif);
    display: block;
  }
  .slot-cta > span {
    font: 600 13.5px/1 var(--sans);
    letter-spacing: 0.02em;
  }
  @media (max-width: 620px) {
    .slots {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .slots-compact .slot.sample[aria-hidden='true'] {
      display: none;
    }
    .slot-cta {
      padding: 14px;
    }
    .slot-cta strong {
      font-size: 19px;
    }
    .slot-cta > span {
      font-size: 12.5px;
    }
  }
</style>
