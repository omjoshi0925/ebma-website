---
/**
 * One competition in "Competitions to know" on /events/, set like a numbered reference and laid
 * out like a Student Resources entry (ResourceCard.astro): "[n]" and the cost tag, the name
 * (linking to the official site through ResourceLink, the site's one external-link style), the
 * organizer, a description, who / format / when (and a cost note when there is one), and the
 * domain the link goes to. Facts come from src/data/competitions.ts (verified research).
 * data-cid lets the grade finder (scripts/events-grades.ts) hide it or add a note ([data-fit]).
 */
import ResourceLink from './ResourceLink.astro';
import { costLabel, type Competition } from '../data/competitions';

interface Props {
  competition: Competition;
  n: number;
}
const { competition: c, n } = Astro.props;
const u = new URL(c.url);
const domain = u.hostname.replace(/^www\./, '');
// As in ResourceCard: skip the organizer line when it only repeats the name.
const showOrg = c.org.trim().toLowerCase() !== c.name.trim().toLowerCase();
---

<article class="ce" id={`c-${c.id}`} aria-labelledby={`c-${c.id}-h`} data-cid={c.id}>
  <p class="ce-n" aria-hidden="true">[{n}]</p>
  <h4 class="ce-name" id={`c-${c.id}-h`}><ResourceLink href={c.url}>{c.name}</ResourceLink></h4>
  <p class="ce-cost"><span class:list={['tag', `tag-${c.cost}`]}><span class="sr-only">Cost: </span>{costLabel[c.cost]}</span></p>
  {showOrg && <p class="ce-org">{c.org}</p>}
  <p class="ce-desc">{c.description}</p>
  <dl class="ce-facts">
    <div>
      <dt>Who</dt>
      <dd>{c.level}<span class="ce-fit" data-fit hidden></span></dd>
    </div>
    <div>
      <dt>Format</dt>
      <dd>{c.format}</dd>
    </div>
    <div>
      <dt>When</dt>
      <dd>{c.when}</dd>
    </div>
    {
      c.costNote && (
        <div>
          <dt>Cost</dt>
          <dd>{c.costNote}</dd>
        </div>
      )
    }
  </dl>
  <p class="ce-dom">{domain}</p>
</article>

<style>
  /* Row 1: the reference number and the cost tag. Then the name, and the rest, full width. The
     name comes before the tag in the source so a screen reader meets the heading first. The top
     rule is ink, as on a Student Resources entry. */
  .ce {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    column-gap: 16px;
    padding: 18px 0 26px;
    border-top: 1px solid var(--ink);
    min-width: 0;
  }
  .ce > :not(.ce-n, .ce-cost) {
    grid-column: 1 / -1;
  }
  .ce-n {
    grid-area: 1 / 1;
    align-self: center;
    font: 500 13px/1 var(--mono);
    letter-spacing: 0.02em;
    color: var(--accent-text);
  }
  .ce-cost {
    grid-area: 1 / 2;
    align-self: center;
  }
  .ce-name {
    margin-top: 10px;
    font: 400 clamp(22px, 1.9vw, 26px) / 1.2 var(--serif);
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  /* The link is ResourceLink's: the ↗ is its own inline-block, so the underline stops at the last
     letter instead of running on under the arrow. */
  .ce-name :global(a) {
    padding-block: 3px;
    color: var(--ink);
    text-decoration-color: var(--rule-2);
    text-underline-offset: 0.16em;
  }
  .ce-name :global(a:hover) {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .ce-org {
    margin-top: 6px;
    font: 500 14.5px/1.4 var(--sans);
    color: var(--ink-3);
  }
  .ce-desc {
    margin-top: 12px;
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .ce-facts {
    margin-top: 16px;
    display: grid;
    gap: 8px;
    border-top: 1px dotted var(--rule-2);
    padding-top: 14px;
  }
  .ce-facts div {
    display: grid;
    grid-template-columns: 5.2em minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .ce-facts dt {
    font: 600 12px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ce-facts dd {
    font: 500 15px/1.45 var(--sans);
    color: var(--ink);
  }
  /* The grade finder's note for this contest ("For grade 11: AMC 12."). */
  .ce-fit {
    display: block;
    margin-top: 4px;
    font-weight: 600;
    color: var(--accent-text);
  }
  .ce-dom {
    margin-top: 14px;
    font: 500 12.5px/1.3 var(--mono);
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }

  /* The cost tag, shared with Student Resources: Free is solid ink; every other value is outlined. */
  .tag {
    display: inline-block;
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 7px;
    border: 1px solid var(--rule-2);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .tag-free {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 620px) {
    .ce-desc {
      font-size: 17px;
    }
    .ce-facts dd {
      font-size: 16px;
    }
  }
  @media print {
    .ce {
      break-inside: avoid;
    }
  }
</style>
