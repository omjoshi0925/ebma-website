---
/**
 * One competition in "Competitions to know" on /events/, set like a numbered reference:
 * [n], the name (linking to the official site), the organizer and domain, a description, and
 * who / format / when / cost. Facts come from src/data/competitions.ts (verified research).
 */
import { costLabel, type Competition } from '../data/competitions';

interface Props {
  competition: Competition;
  n: number;
}
const { competition: c, n } = Astro.props;
const u = new URL(c.url);
const domain = u.hostname.replace(/^www\./, '');
---

<article class="ce" id={`c-${c.id}`} aria-labelledby={`c-${c.id}-h`}>
  <p class="ce-n" aria-hidden="true">[{n}]</p>
  <div class="ce-body">
    <h4 class="ce-name" id={`c-${c.id}-h`}>
      <a href={c.url} rel="noopener">
        {c.name}<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> (external site)</span>
      </a>
    </h4>
    <p class="ce-org">{c.org}<span class="ce-dom"> · {domain}</span></p>
    <p class="ce-desc">{c.description}</p>
    <dl class="ce-facts">
      <div>
        <dt>Who</dt>
        <dd>{c.level}</dd>
      </div>
      <div>
        <dt>Format</dt>
        <dd>{c.format}</dd>
      </div>
      <div>
        <dt>When</dt>
        <dd>{c.when}</dd>
      </div>
      <div>
        <dt>Cost</dt>
        <dd>
          <span class:list={['tag', `tag-${c.cost}`]}>{costLabel[c.cost]}</span>
          {c.costNote && <span class="ce-costnote">{c.costNote}</span>}
        </dd>
      </div>
    </dl>
  </div>
</article>

<style>
  .ce {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    column-gap: 8px;
    padding: 24px 0 26px;
    border-top: 1px solid var(--rule);
    min-width: 0;
  }
  .ce-n {
    font: 500 14px/1.9 var(--mono);
    color: var(--accent-text);
  }
  .ce-name {
    font: 400 clamp(22px, 1.9vw, 26px) / 1.2 var(--serif);
    letter-spacing: -0.01em;
  }
  .ce-name a {
    padding-block: 3px;
    color: var(--ink);
    text-decoration-color: var(--rule-2);
    text-underline-offset: 0.16em;
  }
  .ce-name a:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .ext {
    font: 500 0.66em/1 var(--sans);
    margin-left: 0.3em;
    color: var(--accent-text);
    vertical-align: 0.25em;
  }
  .ce-org {
    margin-top: 6px;
    font-style: italic;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-3);
  }
  .ce-dom {
    font: normal 500 13px/1 var(--mono);
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .ce-desc {
    margin-top: 12px;
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .ce-facts {
    margin-top: 16px;
    display: grid;
    gap: 8px;
    border-top: 1px dotted var(--rule-2);
    padding-top: 14px;
  }
  .ce-facts div {
    display: grid;
    grid-template-columns: 5.2em minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .ce-facts dt {
    font: 600 12px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ce-facts dd {
    font: 500 15px/1.45 var(--sans);
    color: var(--ink);
  }
  .tag {
    display: inline-block;
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 7px 3px;
    border: 1px solid var(--rule-2);
    color: var(--ink);
    margin-right: 8px;
    vertical-align: 1px;
  }
  .tag-free {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .ce-costnote {
    color: var(--ink-2);
  }
  @media (max-width: 620px) {
    .ce {
      grid-template-columns: minmax(0, 1fr);
    }
    .ce-n {
      line-height: 1;
      margin-bottom: 8px;
    }
  }
</style>
