---
/**
 * An EBMA events list on /events/, set as an agenda along a vertical time rail: date, a point on
 * the rail, then the details. Takes the same events as EventCard (src/data/events.ts), in any
 * order. `mode` picks which of them it lists:
 *
 *   - 'upcoming' (the default): the events that have not passed, soonest first, then those with no
 *     date yet ("TBD" where the day goes). Three states:
 *       - `events` is empty: `sampleCount` sample rows in the site's one sample style (`.sample`
 *         on the list, a `.sample-tag` on each row, global.css): a dashed outline and dashed
 *         hairlines for the list's rules and rail, muted text. The first row carries two
 *         placeholder chips and its date tile shows "??"; the others are blank ruled stand-ins,
 *         hidden from screen readers.
 *       - every event has passed: one plain sentence, "No EBMA events are scheduled right now."
 *       - otherwise the events. A dated row carries `data-end`, so the script drops it once its
 *         day passes after the build, and shows the empty sentence when none are left
 *         (prunePastEvents).
 *   - 'past': the events whose day has passed, most recent first, with the year under the month
 *     and a hollow point on the rail. The page leaves the list out while there are none.
 *
 * Each row lists only the details its event has (When, Where, Speaker, For, Cost), then the full
 * description, then `event.more` (somewhere to read more) as a link.
 */
import Ph from './Ph.astro';
import { dateParts, eventRows, pastEvents, upcomingEvents, type EbmaEvent } from '../data/events';

interface Props {
  events: EbmaEvent[];
  /** Sample rows to show while `events` is empty ('upcoming' only). */
  sampleCount?: number;
  /** Section number, for labels like "Event 1.2". */
  num: string;
  mode?: 'upcoming' | 'past';
}
const { events, sampleCount = 0, num, mode = 'upcoming' } = Astro.props;
const past = mode === 'past';
const listed = past ? pastEvents(events) : upcomingEvents(events);
const external = (href: string) => /^https?:\/\//.test(href);
/** "Read the options study" → ["Read the options ", "study"]: the last word stays with the ↗. */
const lastWord = (text: string) => {
  const i = text.lastIndexOf(' ');
  return [text.slice(0, i + 1), text.slice(i + 1)];
};
const emptyId = `agenda-none-${num}`;
const live = !past && events.length > 0;
---

{
  live && (
    <p class="ag-none" id={emptyId} hidden={listed.length > 0}>
      No EBMA events are scheduled right now.
    </p>
  )
}
<ol
  class:list={['agenda', { sample: events.length === 0 && !past, past }]}
  aria-label={
    past ? 'Past EBMA events, most recent first' : events.length === 0 ? 'Upcoming EBMA events (samples)' : 'Upcoming EBMA events, soonest first'
  }
  data-upcoming={live ? num : undefined}
  data-empty={live ? emptyId : undefined}
  hidden={live && listed.length === 0}
>
  {
    events.length || past
      ? listed.map((e, i) => {
          const d = e.date ? dateParts(e.date) : null;
          const rows = eventRows(e);
          return (
            <li class="ag" data-end={past ? undefined : e.date}>
              <div class="ag-date">
                {d ? (
                  <>
                    <span class="ag-day" aria-hidden="true">
                      {d.day}
                    </span>
                    <span class="ag-mon">
                      <span aria-hidden="true">{d.month}</span>
                      <span class="ag-wk" aria-hidden="true">
                        {past ? d.year : d.weekday}
                      </span>
                      <span class="sr-only">{d.long}</span>
                    </span>
                  </>
                ) : (
                  <>
                    <span class="ag-day tbd" aria-hidden="true">
                      TBD
                    </span>
                    <span class="ag-mon">
                      <span aria-hidden="true">Date</span>
                      <span class="ag-wk" aria-hidden="true">
                        to be announced
                      </span>
                      <span class="sr-only">Date to be announced</span>
                    </span>
                  </>
                )}
              </div>
              <div class="ag-rail" aria-hidden="true">
                <span class="ag-pt" />
              </div>
              <div class="ag-main">
                <p class="ag-top">
                  <span class="label">
                    Event <span data-ev-num>{`${num}.${i + 1}`}</span>
                  </span>
                  {e.kind && <span class="ag-kind">{e.kind}</span>}
                </p>
                <h3 class="ag-title">{e.title}</h3>
                {rows.length > 0 && (
                  <dl class="ag-meta">
                    {rows.map(([term, value]) => (
                      <div>
                        <dt>{term}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {e.description && <p class="ag-desc">{e.description}</p>}
                {e.more && (
                  <p class="ag-more">
                    <a class="xref ext" href={e.more.href} rel="external noopener">
                      <span>
                        {lastWord(e.more.label)[0]}
                        <span class="ext-tail">
                          {lastWord(e.more.label)[1]}
                          <span class="ext-arr" aria-hidden="true">
                            ↗
                          </span>
                        </span>
                      </span>
                      <span class="sr-only"> (external site)</span>
                    </a>
                  </p>
                )}
              </div>
              <div class="ag-go">
                {e.href &&
                  (external(e.href) ? (
                    <a class="xref ext" href={e.href} rel="external noopener">
                      <span>
                        Details &amp;{' '}
                        <span class="ext-tail">
                          registration<span class="ext-arr" aria-hidden="true">↗</span>
                        </span>
                      </span>
                      <span class="sr-only">: {e.title} (external site)</span>
                    </a>
                  ) : (
                    <a class="xref" href={e.href}>
                      Details &amp; registration<span class="sr-only">: {e.title}</span>
                      <span class="arr" aria-hidden="true">→</span>
                    </a>
                  ))}
              </div>
            </li>
          );
        })
      : Array.from({ length: sampleCount }, (_, i) =>
          i === 0 ? (
            <li class="ag ag-sample">
              <div class="ag-date">
                <span class="ag-tile" aria-hidden="true">
                  <span>MON</span>
                  <span class="ag-tile-q">??</span>
                </span>
                <span class="sr-only">Placeholder: Date</span>
              </div>
              <div class="ag-rail" aria-hidden="true">
                <span class="ag-pt" />
              </div>
              <div class="ag-main">
                <p class="ag-top">
                  <span class="label">
                    Event {num}.{i + 1}
                  </span>
                  <span class="sample-tag">Sample</span>
                </p>
                <h3 class="ag-title">
                  <Ph id="events.upcoming" label="Event name" />
                </h3>
                <p class="ag-sample-line">
                  <Ph id="events.upcoming" label="Time, place, who it’s for, cost" />
                </p>
              </div>
              <div class="ag-go" />
            </li>
          ) : (
            <li class="ag ag-sample ag-ghost ag-extra" aria-hidden="true">
              <div class="ag-date">
                <span class="ag-tile">
                  <span>MON</span>
                  <span class="ag-tile-q">??</span>
                </span>
              </div>
              <div class="ag-rail">
                <span class="ag-pt" />
              </div>
              <div class="ag-main">
                <p class="ag-top">
                  <span class="label">
                    Event {num}.{i + 1}
                  </span>
                  <span class="sample-tag">Sample</span>
                </p>
                <div class="ag-blank">
                  <span />
                  <span />
                </div>
              </div>
              <div class="ag-go" />
            </li>
          ),
        )
  }
</ol>

<script>
  // The page is built ahead of time: drop any listed event whose day has passed since.
  import { prunePastEvents } from '../data/events';
  prunePastEvents();
</script>

<style>
  .agenda {
    list-style: none;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    --date-w: 132px;
    --rail-w: 36px;
  }
  .ag {
    display: grid;
    grid-template-columns: var(--date-w) var(--rail-w) minmax(0, 1fr) auto;
    column-gap: 18px;
    align-items: start;
    position: relative;
  }
  .ag + .ag .ag-main,
  .ag + .ag .ag-date,
  .ag + .ag .ag-go {
    border-top: 1px solid var(--rule);
  }
  .ag-date,
  .ag-main,
  .ag-go {
    padding: 22px 0 24px;
    min-width: 0;
    align-self: stretch;
  }

  /* The rail: one continuous time axis through every row, with a point per event. */
  .ag-rail {
    position: relative;
    align-self: stretch;
  }
  .ag-rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1.5px;
    margin-left: -0.75px;
    background: var(--ink);
  }
  .ag-pt {
    position: absolute;
    left: 50%;
    top: 34px;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--paper);
  }
  /* Samples: .sample (global.css) outlines the list and mutes the ink; the rules inside turn to
     dashed hairlines to match. */
  .sample .ag + .ag .ag-main,
  .sample .ag + .ag .ag-date,
  .sample .ag + .ag .ag-go {
    border-top: 1px dashed var(--rule-2);
  }
  .sample .ag-rail::before {
    width: 0;
    margin-left: 0;
    background: none;
    border-left: 1px dashed var(--rule-2);
  }
  .ag-sample .ag-pt {
    background: var(--paper);
    border: 1px dashed var(--ink-3);
  }


  .ag-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .ag-day {
    font: 200 clamp(56px, 5vw, 76px) / 0.8 var(--serif);
    color: var(--accent);
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 72;
  }
  /* No date yet: "TBD" in the day's place, smaller so it doesn't outshout a real date. */
  .ag-day.tbd {
    font-size: clamp(40px, 3.6vw, 52px);
    letter-spacing: -0.01em;
  }
  /* Past events: the date in ink rather than vermilion, and a hollow point on the rail. */
  .past .ag-day {
    color: var(--ink-2);
  }
  .past .ag-pt {
    background: var(--paper);
    border: 2px solid var(--ink);
  }
  .ag-mon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font: 600 13px/1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ag-wk {
    font: 500 12.5px/1 var(--mono);
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-3);
  }
  /* The date tile is the date's placeholder: the shape a real date will take, with "??" for the day. */
  .ag-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 10px;
    border: 1px dashed var(--rule-2);
    font: 500 13px/1 var(--mono);
    letter-spacing: 0.1em;
    color: var(--ink-3);
    text-align: center;
  }
  .ag-tile-q {
    font: 600 24px/1 var(--mono);
    letter-spacing: 0.04em;
  }

  .ag-top {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 10px;
  }
  .ag-top .label {
    color: var(--ink);
  }
  .ag-kind {
    font: 500 12px/1 var(--mono);
    color: var(--ink-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ag-title {
    font: 400 clamp(24px, 2.2vw, 30px) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .ag-sample .ag-title :global(.ph) {
    font-size: 17px;
  }
  .ag-sample-line {
    margin-top: 12px;
    font-size: 17px;
  }
  /* Later samples: blank ruled lines where the name and details will go, like a form to fill in. */
  .ag-blank {
    display: grid;
    gap: 22px;
    padding-top: 16px;
  }
  .ag-blank span {
    display: block;
    border-bottom: 1px solid var(--rule-2);
    width: 60%;
  }
  .ag-blank span + span {
    width: 40%;
  }
  /* Every listed event has passed. */
  .ag-none {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 22px 0 24px;
    font-size: 19px;
    text-wrap: pretty;
  }

  .ag-meta {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
  }
  .ag-meta div {
    display: flex;
    gap: 10px;
    align-items: baseline;
    min-width: 0;
  }
  .ag-meta dt {
    font: 600 12px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ag-meta dd {
    font-size: 17px;
  }
  .ag-desc {
    margin-top: 12px;
    font-size: 17px;
    color: var(--ink-2);
    max-width: 40em;
    text-wrap: pretty;
  }
  .ag-more {
    margin-top: 14px;
  }
  .ag-go {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 26px;
  }
  .ag-go .xref {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .agenda {
      --rail-w: 22px;
    }
    .ag {
      grid-template-columns: var(--rail-w) minmax(0, 1fr);
      column-gap: 14px;
    }
    .ag-rail {
      grid-column: 1;
      grid-row: 1 / span 3;
    }
    .ag-date,
    .ag-main,
    .ag-go {
      grid-column: 2;
    }
    .ag-date {
      flex-direction: row;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 8px 14px;
      padding-bottom: 12px;
    }
    .ag-main {
      padding-top: 0;
      border-top: 0 !important;
      padding-bottom: 20px;
    }
    .ag-go {
      border-top: 0 !important;
      justify-content: flex-start;
      padding: 0 0 22px;
    }
    .ag-go:empty {
      display: none;
    }
    .ag-pt {
      top: 30px;
    }
    .ag-meta {
      flex-direction: column;
      gap: 6px;
    }
    .ag-meta dt {
      min-width: 4.4em;
    }
  }
  @media (max-width: 620px) {
    /* Blank sample rows add length without information on a phone. */
    .ag-extra {
      display: none;
    }
  }
</style>
