---
/**
 * Plate I on /get-involved/: a patch of the "hat", the aperiodic monotile of Smith, Myers,
 * Kaplan & Goodman-Strauss (2023), drawn as static SVG at build time. The mirror-image tiles are
 * hatched, like an engraving, and one tile is filled in vermilion: "your piece". With motion allowed it starts as an empty dashed slot and drops into
 * place once, shortly after the page opens; without motion or JavaScript it is simply filled.
 *
 * The substitution construction below is a port of Craig S. Kaplan's hatviz
 * (https://github.com/isohedral/hatviz), used under the BSD 3-Clause License:
 *
 *   Copyright (c) 2023, Craig S. Kaplan
 *   All rights reserved.
 *
 *   Redistribution and use in source and binary forms, with or without modification, are
 *   permitted provided that the following conditions are met:
 *   1. Redistributions of source code must retain the above copyright notice, this list of
 *      conditions and the following disclaimer.
 *   2. Redistributions in binary form must reproduce the above copyright notice, this list of
 *      conditions and the following disclaimer in the documentation and/or other materials
 *      provided with the distribution.
 *   3. Neither the name of the copyright holder nor the names of its contributors may be used
 *      to endorse or promote products derived from this software without specific prior
 *      written permission.
 *
 *   THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS" AND ANY
 *   EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
 *   MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE
 *   COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,
 *   EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
 *   SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
 *   HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR
 *   TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
 *   SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 */
import Plate from './Plate.astro';

interface Pt {
  x: number;
  y: number;
}
type Mat = [number, number, number, number, number, number];
type Label = 'H1' | 'H' | 'T' | 'P' | 'F';

const hr3 = Math.sqrt(3) / 2;
const ident: Mat = [1, 0, 0, 0, 1, 0];
const pt = (x: number, y: number): Pt => ({ x, y });
const hexPt = (x: number, y: number) => pt(x + 0.5 * y, hr3 * y);
const inv = (T: Mat): Mat => {
  const d = T[0] * T[4] - T[1] * T[3];
  return [T[4] / d, -T[1] / d, (T[1] * T[5] - T[2] * T[4]) / d, -T[3] / d, T[0] / d, (T[2] * T[3] - T[0] * T[5]) / d];
};
const mul = (A: Mat, B: Mat): Mat => [
  A[0] * B[0] + A[1] * B[3],
  A[0] * B[1] + A[1] * B[4],
  A[0] * B[2] + A[1] * B[5] + A[2],
  A[3] * B[0] + A[4] * B[3],
  A[3] * B[1] + A[4] * B[4],
  A[3] * B[2] + A[4] * B[5] + A[5],
];
const padd = (p: Pt, q: Pt) => pt(p.x + q.x, p.y + q.y);
const psub = (p: Pt, q: Pt) => pt(p.x - q.x, p.y - q.y);
const trot = (a: number): Mat => [Math.cos(a), -Math.sin(a), 0, Math.sin(a), Math.cos(a), 0];
const ttrans = (x: number, y: number): Mat => [1, 0, x, 0, 1, y];
const rotAbout = (p: Pt, a: number) => mul(ttrans(p.x, p.y), mul(trot(a), ttrans(-p.x, -p.y)));
const tp = (M: Mat, P: Pt) => pt(M[0] * P.x + M[1] * P.y + M[2], M[3] * P.x + M[4] * P.y + M[5]);
const matchSeg = (p: Pt, q: Pt): Mat => [q.x - p.x, p.y - q.y, p.x, q.y - p.y, q.x - p.x, p.y];
const matchTwo = (p1: Pt, q1: Pt, p2: Pt, q2: Pt) => mul(matchSeg(p2, q2), inv(matchSeg(p1, q1)));
const intersect = (p1: Pt, q1: Pt, p2: Pt, q2: Pt) => {
  const d = (q2.y - p2.y) * (q1.x - p1.x) - (q2.x - p2.x) * (q1.y - p1.y);
  const uA = ((q2.x - p2.x) * (p1.y - p2.y) - (q2.y - p2.y) * (p1.x - p2.x)) / d;
  return pt(p1.x + uA * (q1.x - p1.x), p1.y + uA * (q1.y - p1.y));
};

// The hat: a 13-vertex polygon on the hexagonal (kite) grid.
const HAT = [
  hexPt(0, 0), hexPt(-1, -1), hexPt(0, -2), hexPt(2, -2), hexPt(2, -1), hexPt(4, -2), hexPt(5, -1),
  hexPt(4, 0), hexPt(3, 0), hexPt(2, 2), hexPt(0, 3), hexPt(0, 2), hexPt(-1, 2),
];

class Hat {
  constructor(public label: Label) {}
}
interface Child {
  T: Mat;
  geom: Meta | Hat;
}
class Meta {
  children: Child[] = [];
  constructor(
    public shape: Pt[],
    public width: number,
  ) {}
  add(T: Mat, geom: Meta | Hat) {
    this.children.push({ T, geom });
  }
  ev(n: number, i: number) {
    const c = this.children[n];
    return tp(c.T, (c.geom as Meta).shape[i]);
  }
  recentre() {
    let cx = 0;
    let cy = 0;
    for (const p of this.shape) {
      cx += p.x;
      cy += p.y;
    }
    cx /= this.shape.length;
    cy /= this.shape.length;
    this.shape = this.shape.map((p) => pt(p.x - cx, p.y - cy));
    const M = ttrans(-cx, -cy);
    for (const c of this.children) c.T = mul(M, c.T);
  }
}

// The four first-level metatiles (H, T, P, F), each a cluster of hats. H1 is the mirrored hat.
const hatH1 = new Hat('H1');
const hatH = new Hat('H');
const hatT = new Hat('T');
const hatP = new Hat('P');
const hatF = new Hat('F');
const Ho = [pt(0, 0), pt(4, 0), pt(4.5, hr3), pt(2.5, 5 * hr3), pt(1.5, 5 * hr3), pt(-0.5, hr3)];
const H = new Meta(Ho, 2);
H.add(matchTwo(HAT[5], HAT[7], Ho[5], Ho[0]), hatH);
H.add(matchTwo(HAT[9], HAT[11], Ho[1], Ho[2]), hatH);
H.add(matchTwo(HAT[5], HAT[7], Ho[3], Ho[4]), hatH);
H.add(mul(ttrans(2.5, hr3), mul([-0.5, -hr3, 0, hr3, -0.5, 0], [0.5, 0, 0, 0, -0.5, 0])), hatH1);
const T = new Meta([pt(0, 0), pt(3, 0), pt(1.5, 3 * hr3)], 2);
T.add([0.5, 0, 0.5, 0, 0.5, hr3], hatT);
const P = new Meta([pt(0, 0), pt(4, 0), pt(3, 2 * hr3), pt(-1, 2 * hr3)], 2);
P.add([0.5, 0, 1.5, 0, 0.5, hr3], hatP);
P.add(mul(ttrans(0, 2 * hr3), mul([0.5, hr3, 0, -hr3, 0.5, 0], [0.5, 0, 0, 0, 0.5, 0])), hatP);
const F = new Meta([pt(0, 0), pt(3, 0), pt(3.5, hr3), pt(3, 2 * hr3), pt(-1, 2 * hr3)], 2);
F.add([0.5, 0, 1.5, 0, 0.5, hr3], hatF);
F.add(mul(ttrans(0, 2 * hr3), mul([0.5, hr3, 0, -hr3, 0.5, 0], [0.5, 0, 0, 0, 0.5, 0])), hatF);

// Substitution rules: how 29 metatiles fit together into the next-level patch (from hatviz).
type Rule = ['H'] | [number, number, 'H' | 'T' | 'P' | 'F', number] | [number, number, number, number, 'H' | 'T' | 'P' | 'F', number];
const RULES: Rule[] = [
  ['H'], [0, 0, 'P', 2], [1, 0, 'H', 2], [2, 0, 'P', 2], [3, 0, 'H', 2], [4, 4, 'P', 2], [0, 4, 'F', 3],
  [2, 4, 'F', 3], [4, 1, 3, 2, 'F', 0], [8, 3, 'H', 0], [9, 2, 'P', 0], [10, 2, 'H', 0], [11, 4, 'P', 2],
  [12, 0, 'H', 2], [13, 0, 'F', 3], [14, 2, 'F', 1], [15, 3, 'H', 4], [8, 2, 'F', 1], [17, 3, 'H', 0],
  [18, 2, 'P', 0], [19, 2, 'H', 2], [20, 4, 'F', 3], [20, 0, 'P', 2], [22, 0, 'H', 2], [23, 4, 'F', 3],
  [23, 0, 'F', 3], [16, 0, 'P', 2], [9, 4, 0, 2, 'T', 2], [4, 0, 'F', 3],
];

function patch(tiles: Record<'H' | 'T' | 'P' | 'F', Meta>): Meta {
  const r = new Meta([], tiles.H.width);
  for (const q of RULES) {
    if (q.length === 1) {
      r.add(ident, tiles.H);
    } else if (q.length === 4) {
      const c = r.children[q[0]];
      const poly = (c.geom as Meta).shape;
      const A = tp(c.T, poly[(q[1] + 1) % poly.length]);
      const B = tp(c.T, poly[q[1]]);
      const n = tiles[q[2]];
      r.add(matchTwo(n.shape[q[3]], n.shape[(q[3] + 1) % n.shape.length], A, B), n);
    } else {
      const cP = r.children[q[0]];
      const cQ = r.children[q[2]];
      const A = tp(cQ.T, (cQ.geom as Meta).shape[q[3]]);
      const B = tp(cP.T, (cP.geom as Meta).shape[q[1]]);
      const n = tiles[q[4]];
      r.add(matchTwo(n.shape[q[5]], n.shape[(q[5] + 1) % n.shape.length], A, B), n);
    }
  }
  return r;
}

function metatiles(p: Meta): Record<'H' | 'T' | 'P' | 'F', Meta> {
  const bps1 = p.ev(8, 2);
  const bps2 = p.ev(21, 2);
  const rbps = tp(rotAbout(bps1, (-2 * Math.PI) / 3), bps2);
  const p72 = p.ev(7, 2);
  const p252 = p.ev(25, 2);
  const llc = intersect(bps1, rbps, p.ev(6, 2), p72);
  let w = psub(p.ev(6, 2), llc);
  const nH = [llc, bps1];
  w = tp(trot(-Math.PI / 3), w);
  nH.push(padd(nH[1], w));
  nH.push(p.ev(14, 2));
  w = tp(trot(-Math.PI / 3), w);
  nH.push(psub(nH[3], w));
  nH.push(p.ev(6, 2));
  const pick = (m: Meta, ids: number[]) => {
    for (const c of ids) m.add(p.children[c].T, p.children[c].geom);
    return m;
  };
  const Hn = pick(new Meta(nH, p.width * 2), [0, 9, 16, 27, 26, 6, 1, 8, 10, 15]);
  const Pn = pick(new Meta([p72, padd(p72, psub(bps1, llc)), bps1, llc], p.width * 2), [7, 2, 3, 4, 28]);
  const Fn = pick(new Meta([bps2, p.ev(24, 2), p.ev(25, 0), p252, padd(p252, psub(llc, bps1))], p.width * 2), [21, 20, 22, 23, 24, 25]);
  const A = nH[2];
  const B = padd(nH[1], psub(nH[4], nH[5]));
  const C = tp(rotAbout(B, -Math.PI / 3), A);
  const Tn = pick(new Meta([B, C, A], p.width * 2), [11]);
  for (const m of [Hn, Pn, Fn, Tn]) m.recentre();
  return { H: Hn, T: Tn, P: Pn, F: Fn };
}

let tiles = { H, T, P, F };
for (let i = 0; i < 3; i++) tiles = metatiles(patch(tiles));

const hats: { label: Label; pts: Pt[] }[] = [];
(function walk(g: Meta | Hat, M: Mat) {
  if (g instanceof Hat) {
    hats.push({ label: g.label, pts: HAT.map((p) => tp(M, p)) });
    return;
  }
  for (const c of g.children) walk(c.geom, mul(M, c.T));
})(tiles.H, ident);

// Crop a window of the patch into a 400 × 320 viewBox. Units are hat-grid units.
const VW = 400;
const VH = 320;
const WIN = { cx: 8, cy: -6, w: 22 };
const s = VW / WIN.w;
const toView = (p: Pt): [number, number] => [(p.x - WIN.cx + WIN.w / 2) * s, (p.y - WIN.cy + (VH / s) / 2) * s];
const visible = hats
  .map((h, i) => ({ i, label: h.label, pts: h.pts.map(toView) }))
  .filter((h) => h.pts.some(([x, y]) => x > -4 && x < VW + 4 && y > -4 && y < VH + 4));

// "Your piece": the ordinary (unmirrored) hat nearest a point a little right of centre.
const centre = (pts: [number, number][]) => pts.reduce((m, [x, y]) => [m[0] + x / pts.length, m[1] + y / pts.length], [0, 0]);
const target = [VW * 0.56, VH * 0.54];
const yours = visible
  .filter((h) => h.label !== 'H1' && h.pts.every(([x, y]) => x > 40 && x < VW - 40 && y > 40 && y < VH - 40))
  .sort((a, b) => {
    const [ax, ay] = centre(a.pts);
    const [bx, by] = centre(b.pts);
    return Math.hypot(ax - target[0], ay - target[1]) - Math.hypot(bx - target[0], by - target[1]);
  })[0];

const d = (pts: [number, number][]) => `M${pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L')}Z`;
const ordinary = visible.filter((h) => h.label !== 'H1' && h !== yours).map((h) => d(h.pts)).join('');
const mirrored = visible.filter((h) => h.label === 'H1' && h !== yours).map((h) => d(h.pts)).join('');
const yoursD = d(yours.pts);

const caption =
  'The “hat”: one shape that covers the whole plane, with no gaps and no pattern that ever repeats. The hatched tiles are its mirror image. ' +
  'The red one is yours. <span class="gi-cite">After Smith, Myers, Kaplan &amp; Goodman-Strauss (2023).</span>';
---

<div class="gi-hat">
<Plate id="fig-hat" plate="Plate I" corner='<span class="gi-key"></span>Your piece' fig="Fig. 1." caption={caption}>
  {/* Named by its <title> alone: pointing aria-labelledby at the title as well makes Chrome
       repeat it as the description. */}
  <svg class="gi-hat-svg" data-reveal viewBox={`0 0 ${VW} ${VH}`} role="img">
    <title>A patch of identical hat-shaped tiles fitted together with no gaps; the mirror-image tiles are hatched. One tile near the middle is filled in red: your piece.</title>
    <defs>
      {/* Hatching in --ink-3 (about 5:1 against the paper in both themes), so the mirror-image
           tiles stand apart from the plain ones without a second accent color. */}
      <pattern id="gi-hatch" patternUnits="userSpaceOnUse" width="4.5" height="4.5" patternTransform="rotate(45)">
        <rect class="t-hatch-bg" width="4.5" height="4.5" />
        <line class="t-hatch" x1="0" y1="0" x2="0" y2="4.5" />
      </pattern>
    </defs>
    <path class="t-mir" d={mirrored} />
    <path class="t-ord" d={ordinary} />
    <path class="t-slot" d={yoursD} />
    <path class="t-you" d={yoursD} />
  </svg>
</Plate>
</div>

<style>
  .gi-hat-svg {
    width: 100%;
    height: auto;
    aspect-ratio: 400 / 320;
  }
  .gi-hat-svg path {
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .t-ord {
    fill: var(--paper);
    stroke: var(--ink-3);
    stroke-width: 0.9;
  }
  .t-mir {
    fill: url(#gi-hatch);
    stroke: var(--ink-3);
    stroke-width: 0.9;
  }
  .t-hatch-bg {
    fill: var(--paper);
  }
  .t-hatch {
    stroke: var(--ink-3);
    stroke-width: 1.4;
  }
  .t-slot {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .t-you {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* The corner key: a small vermilion square, like the legend of a printed plate. */
  .gi-hat :global(.gi-key) {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    background: var(--accent);
    vertical-align: -1px;
  }
  .gi-hat :global(.gi-cite) {
    font-style: italic;
  }
  /* Motion: the piece drops into its slot once, after the header has risen in. Below the fold
     (phones), scripts/site.ts arms the figure and the drop waits until it scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .t-you {
      animation: gi-place 0.7s var(--ease-out) 1.3s both;
    }
    .gi-hat-svg:global(.armed) .t-you {
      animation: none;
      opacity: 0;
    }
    .gi-hat-svg:global(.armed.in) .t-you {
      animation: gi-place 0.7s var(--ease-out) 0.4s both;
    }
  }
  @media (max-width: 980px) {
    .gi-hat {
      max-width: 520px;
    }
  }
  @keyframes gi-place {
    from {
      opacity: 0;
      transform: translate(6px, -10px) rotate(-8deg) scale(1.08);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
