---
/**
 * Typeset TeX at build time with KaTeX (no math JavaScript in the browser).
 *
 *   <Math tex="\sum_{k=1}^{n} \frac{1}{k(k+1)}" />          inline
 *   <Math display tex="a^2 + b^2 = c^2" />                   display (centered block)
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  display?: boolean;
}
const { tex, display = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: display, throwOnError: true, output: 'htmlAndMathml', strict: 'error' });
---

{display ? <div class="math-display" set:html={html} /> : <span class="math-inline" set:html={html} />}

<style>
  .math-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0;
  }
  .math-display :global(.katex-display) {
    margin: 0.6em 0;
  }
  .math-inline :global(.katex),
  .math-display :global(.katex) {
    font-size: 1.08em;
  }
</style>
