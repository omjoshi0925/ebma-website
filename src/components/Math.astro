---
/**
 * Typeset TeX at build time with KaTeX (no math JavaScript in the browser).
 *
 *   <Math tex={String.raw`\sum_{k=1}^{n} \frac{1}{k(k+1)}`} />   inline
 *   <Math display tex={String.raw`a^2 + b^2 = c^2`} />           display (centered block)
 *
 * Use String.raw for TeX: in a quoted attribute Astro treats backslashes as escapes (\f → form feed).
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  display?: boolean;
}
const { tex, display = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: display, throwOnError: true, output: 'htmlAndMathml', strict: 'error' });
---

{display ? <div class="math-display" set:html={html} /> : <span class="math-inline" set:html={html} />}

<script>
  // A display equation wider than its column scrolls sideways: make that box focusable (and name it)
  // so it can be scrolled from the keyboard. The equation itself is observed too, since it can widen
  // (e.g. with larger text spacing) while its box keeps the same size.
  if ('ResizeObserver' in window) {
    const fit = new ResizeObserver((entries) => {
      for (const { target } of entries) {
        const box = (target as HTMLElement).closest<HTMLElement>('.math-display');
        if (!box) continue;
        const scrolls = box.clientWidth > 0 && box.scrollWidth > box.clientWidth + 1;
        if (scrolls && !box.hasAttribute('tabindex')) {
          box.tabIndex = 0;
          box.setAttribute('role', 'group');
          box.setAttribute('aria-label', 'Equation (scrolls sideways)');
        } else if (!scrolls && box.hasAttribute('tabindex')) {
          box.removeAttribute('tabindex');
          box.removeAttribute('role');
          box.removeAttribute('aria-label');
        }
      }
    });
    document.querySelectorAll('.math-display').forEach((el) => {
      fit.observe(el);
      if (el.firstElementChild) fit.observe(el.firstElementChild);
    });
  }
</script>

<style>
  .math-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0;
  }
  .math-display :global(.katex-display) {
    margin: 0.6em 0;
  }
  /* The size of typeset math (1.08em) is set once, in global.css. */
</style>
